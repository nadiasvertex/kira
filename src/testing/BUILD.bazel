load("@rules_cc//cc:defs.bzl", "cc_library")

cc_library(
    name = "testing",
    hdrs = [
        "test_assert.h",
        "test_data.h",
    ],
    visibility = ["//visibility:public"],
)

# Separate from `:testing` because it needs the front end: a harness that
# drives `check_program` directly has to inject the stdlib (`list`, `option`
# and friends are ordinary Cinder types, not builtins), and injecting it means
# parsing it. Harnesses that only need `expect`/`fail` keep depending on the
# dependency-free `:testing` above.
cc_library(
    name = "stdlib_fixtures",
    hdrs = ["stdlib_fixtures.h"],
    visibility = ["//visibility:public"],
    deps = [
        ":testing",
        "//src/hir",
        "//src/parser",
        "//src/semantic",
    ],
)

# Shared by the tests of the backends that compile the storage form
# (`bytecode_compiler:storage_compile_test`, `llvm_codegen:storage_codegen_test`):
# a fixture program lowered to storage form, and the value cases each backend
# must pass.
cc_library(
    name = "storage_fixtures",
    hdrs = [
        "storage_cases.h",
        "storage_fixture.h",
        "storage_intrinsic_cases.h",
        "storage_closure_cases.h",
        "storage_generator_cases.h",
        "storage_task_cases.h",
        "storage_pattern_cases.h",
        "storage_rvo_cases.h",
        "storage_memory_cases.h",
        "storage_module_cases.h",
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":stdlib_fixtures",
        ":testing",
        "//src/bytecode",
        "//src/comptime_vm",
        "//src/hir",
        "//src/parser",
        "//src/runtime",
        "//src/semantic",
    ],
)
