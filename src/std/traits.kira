module std.traits

#: Conversion from a value of type T to self.
pub trait from[T]:
    #: Converts a value of type T into the implementing type.
    #: Args:
    #:   value: the value to convert from.
    #: Returns:
    #:   the converted value.
    def from(value: T) -> self

#: Conversion from self into a value of type T.
pub trait into[T]:
    #: Converts self into a value of type T.
    #: Returns:
    #:   the converted value.
    def into(self) -> T

#: Cleanup and resource deallocation for a value.
pub trait drop:
    #: Deallocates resources associated with this value when it goes out of scope.
    #: Args:
    #:   self: the value to clean up (moved).
    #: Returns:
    #:   unit (nothing).
    def drop(mut self) -> unit

#: Equality comparison.
pub trait eq:
    #: Checks if two values are equal.
    #: Args:
    #:   self: the first value.
    #:   other: the second value to compare.
    #: Returns:
    #:   true if the values are equal, false otherwise.
    def eq(self, other: &self) -> bool

#: The result of a three-way comparison: less than, equal to, or greater than.
#:
#: This was a builtin type name with no variants and no runtime
#: representation, which made `ord`'s `cmp` a method that could be declared
#: and never called or matched on. It is an ordinary sum type now, so a
#: comparator can be written, returned, and matched -- which is what the
#: comparator-taking algorithms in `std.algo` are built on.
pub type ordering = @less | @equal | @greater

#: Ordering comparison. Requires eq to be implemented.
pub trait ord requires eq:
    #: Compares two values and returns their ordering.
    #: Args:
    #:   self: the first value.
    #:   other: the second value to compare.
    #: Returns:
    #:   an ordering indicating whether self is less than, equal to, or greater than other.
    def cmp(self, other: &self) -> ordering

# The two combinators `deriving ord` is built from. A derived `cmp` is a
# lexicographic fold over the type's fields, and a fold needs both a
# per-field three-way comparison and a way to join two results -- neither of
# which can be written as a single flat expression, which is all the AST
# builders in `src/std/deriving.kira` can splice into a quoted method body.
# They live here, rather than in `std.algo` next to `cmp_via_lt`, so a
# `deriving ord` type does not drag the whole algorithm catalog into the
# compile: a reachable module is compiled in full, and `std.traits` is
# already reachable from anything that names `ordering`. `find_prelude_
# function` (`src/semantic/check.cpp`) lists this module so the generated
# body can call them unqualified from the user's own module.

#: Three-way-compares two `ord` values using `<`, the primitive every
#: builtin scalar already has real codegen for. This is what makes
#: `deriving ord` work without an `impl ord for int32` (and one per other
#: scalar): such an impl would define the very `cmp` that `<` dispatches to
#: on that type, and `<` inside its body would then call itself forever.
#: Type Params:
#:   T: the value type; must implement `ord`.
#: Args:
#:   a: the first value.
#:   b: the second value.
#: Returns:
#:   how `a` relates to `b`.
pub def ord_cmp[T](a: T, b: T) -> ordering where T: ord:
    if a < b:
        return @less
    if b < a:
        return @greater
    return @equal

#: Joins two comparison results the way a lexicographic ordering does: the
#: first result decides unless it is `@equal`, in which case the next field's
#: result does. Associative, so a left-nested fold over the fields (which is
#: the order `static for` produces) gives the same answer as a right-nested
#: one.
#: Args:
#:   first: the more significant field's comparison result.
#:   next: the comparison result to fall back to when `first` is `@equal`.
#: Returns:
#:   `first` unless it is `@equal`, otherwise `next`.
pub def ord_then(first: ordering, next: ordering) -> ordering:
    match first:
        @equal => return next
        @less => return @less
        @greater => return @greater

#: The identity of `ord_then`, and the derived `cmp` of a field-less struct:
#: two values carrying no information compare equal. A function rather than a
#: bare `@equal` because the AST builders can construct a call but not a
#: variant reference.
#: Returns:
#:   `@equal`.
pub def ord_equal() -> ordering:
    return @equal

#: The result of an earlier-declared variant comparing below a later one —
#: `derive_ord_sum`'s (`src/std/deriving.kira`) primary sort key, before it
#: ever looks at payloads. A function for the same reason `ord_equal` is:
#: the AST builders can construct a call but not a bare variant reference.
#: Returns:
#:   `@less`.
pub def ord_less() -> ordering:
    return @less

#: The result of a later-declared variant comparing above an earlier one —
#: `derive_ord_sum`'s (`src/std/deriving.kira`) primary sort key. See
#: `ord_less`'s doc comment for why this is a function rather than a bare
#: `@greater`.
#: Returns:
#:   `@greater`.
pub def ord_greater() -> ordering:
    return @greater

#: Hashing a value to produce a hash code.
pub trait hash:
    #: Computes a 64-bit hash value for this value.
    #: Returns:
    #:   a hash value of type uint64.
    def hash(self) -> uint64

# The combinators `deriving hash` is built from, and the `impl hash` blocks
# for the builtin scalars they bottom out in. A derived `hash` is a fold over
# the type's fields, and a fold needs a seed, a per-field hash, and a way to
# join two results -- none of which can be written as the single flat
# expression the AST builders in `src/std/deriving.kira` can splice into a
# quoted method body. They live here for the same reason `ord_cmp`/`ord_then`
# do: `find_prelude_function` (`src/semantic/check.cpp`) lists `std.traits`,
# so a body spliced into the user's own module resolves them without an
# import the user never wrote.
#
# Unlike `ord`, `hash` has no operator backing it -- nothing in the language
# dispatches to `hash` the way `<` dispatches to `cmp` -- so an `impl hash for
# int32` cannot recurse into itself the way `impl ord for int32` would (see
# `ord_cmp`'s doc comment). That is why the scalars get real impls here while
# `ord` deliberately gets none.
#
# The mixing function is FNV-1a, written throughout with the *wrapping*
# operators: plain `*`/`+` are overflow-checked and panic, so a hash built
# from them would abort on its second field rather than wrap.

#: The FNV-1a 64-bit offset basis: the starting accumulator of every derived
#: `hash`, and the entire hash of a field-less struct (two values carrying no
#: information hash alike). A function rather than a bare literal for the same
#: reason `ord_equal` is one: the AST builders can splice a call, but not a
#: literal of a particular integer width.
#: Returns:
#:   the FNV-1a offset basis.
pub def hash_seed() -> uint64:
    return 0xcbf29ce484222325

#: Folds one more hash into an accumulator, FNV-1a style: exclusive-or the new
#: value in, then multiply by the FNV prime. Deliberately not associative, so
#: the left-nested fold `static for` produces is an order the result depends
#: on -- which is exactly what makes `{a: 1, b: 2}` and `{a: 2, b: 1}` hash
#: differently.
#: Args:
#:   acc: the accumulator so far.
#:   next: the next value's hash.
#: Returns:
#:   the two combined.
pub def hash_combine(acc: uint64, next: uint64) -> uint64:
    return (acc ^ next) *% 0x100000001b3

#: Hashes one `hash` value. The counterpart of `ord_cmp`, present for the same
#: reason: a derived body folds over its fields with a call, and the AST
#: builders splice a call to a free function more readily than a method.
#: Type Params:
#:   T: the value type; must implement `hash`.
#: Args:
#:   x: the value to hash.
#: Returns:
#:   `x`'s hash.
pub def hash_value[T](x: T) -> uint64 where T: hash:
    return x.hash()

#: The contribution a sum type's variant tag makes to its hash --
#: `derive_hash_sum`'s (`src/std/deriving.kira`) primary input, folded in
#: before any payload so that two distinct payload-less variants do not hash
#: alike. A function for the same reason `ord_less`/`ord_greater` are: the
#: builders splice a call, and the index has to arrive already widened to
#: `uint64`.
#: Args:
#:   n: the variant's declaration index.
#: Returns:
#:   that tag's hash contribution.
pub def hash_tag(n: uint64) -> uint64:
    return hash_combine(hash_seed(), n)

# The builtin scalars' own `hash`. `as uint64` is a total, non-trapping
# sign-extend-or-truncate (`compile_cast` in `src/llvm_codegen/codegen.cpp`
# and `exec_cast` in the VM agree on this), so a negative value hashes by its
# two's-complement bit pattern instead of panicking.
#
# `int128`/`uint128`/`float128` are deliberately absent: a reachable module is
# compiled in full and the bytecode VM has no representation for them, so an
# impl here would make every program fail to compile. `spec/todo.md` item 6
# records the same trap for `zero`/`one`; these arrive with it.
#
# `float32`/`float64` are absent for a different reason: hashing a float
# correctly means hashing its bit pattern, and `as uint64` on a float is a
# value conversion, not a reinterpret. That needs a bitcast primitive the
# language does not have yet -- see `spec/todo.md`.

impl hash for bool:
    def hash(self) -> uint64:
        return hash_combine(hash_seed(), self as uint64)

impl hash for char:
    def hash(self) -> uint64:
        return hash_combine(hash_seed(), self as uint64)

impl hash for byte:
    def hash(self) -> uint64:
        return hash_combine(hash_seed(), self as uint64)

impl hash for int8:
    def hash(self) -> uint64:
        return hash_combine(hash_seed(), self as uint64)

impl hash for int16:
    def hash(self) -> uint64:
        return hash_combine(hash_seed(), self as uint64)

impl hash for int32:
    def hash(self) -> uint64:
        return hash_combine(hash_seed(), self as uint64)

impl hash for int64:
    def hash(self) -> uint64:
        return hash_combine(hash_seed(), self as uint64)

impl hash for isize:
    def hash(self) -> uint64:
        return hash_combine(hash_seed(), self as uint64)

impl hash for uint8:
    def hash(self) -> uint64:
        return hash_combine(hash_seed(), self as uint64)

impl hash for uint16:
    def hash(self) -> uint64:
        return hash_combine(hash_seed(), self as uint64)

impl hash for uint32:
    def hash(self) -> uint64:
        return hash_combine(hash_seed(), self as uint64)

impl hash for uint64:
    def hash(self) -> uint64:
        return hash_combine(hash_seed(), self)

impl hash for usize:
    def hash(self) -> uint64:
        return hash_combine(hash_seed(), self as uint64)

#: FNV-1a over the string's UTF-8 bytes. `len`/`[i]` on `str` are builtin
#: (`builtin_method_result`, `src/semantic/check.cpp`), so this impl pulls in
#: no other module -- which matters, since every program that names `ordering`
#: already compiles `std.traits` in full.
impl hash for str:
    def hash(self) -> uint64:
        var h: uint64 = hash_seed()
        var i: usize = 0
        while i < self.len():
            h = hash_combine(h, self[i] as uint64)
            i = i + 1
        return h

#: Converting a value to its string representation (user-friendly formatting).
pub trait show:
    #: Converts the value to a user-friendly string representation.
    #: Returns:
    #:   a string representation of the value.
    def show(self) -> str

#: Converting a value to its debug representation (detailed formatting).
pub trait debug:
    #: Converts the value to a detailed debug string representation, typically with
    #: additional information useful for debugging.
    #: Returns:
    #:   a debug string representation of the value.
    def debug(self) -> str

#: Converting a value to its hexadecimal string representation.
pub trait hex:
    #: Converts the value to a hexadecimal (base-16) string representation.
    #: Returns:
    #:   a hexadecimal string representation of the value.
    def hex(self) -> str

#: Converting a value to its octal string representation.
pub trait octal:
    #: Converts the value to an octal (base-8) string representation.
    #: Returns:
    #:   an octal string representation of the value.
    def octal(self) -> str

#: Converting a value to its binary string representation.
pub trait binary:
    #: Converts the value to a binary (base-2) string representation.
    #: Returns:
    #:   a binary string representation of the value.
    def binary(self) -> str

#: Addition operator. The associated type output specifies the return type.
pub trait add:
    #: The type returned by the addition operation.
    type output
    #: Adds another value to this value.
    #: Args:
    #:   self: the first operand.
    #:   other: the second operand to add.
    #: Returns:
    #:   the result of the addition.
    def add(self, other: self) -> self.output

#: Subtraction operator. The associated type output specifies the return type.
pub trait sub:
    #: The type returned by the subtraction operation.
    type output
    #: Subtracts another value from this value.
    #: Args:
    #:   self: the first operand.
    #:   other: the second operand to subtract.
    #: Returns:
    #:   the result of the subtraction.
    def sub(self, other: self) -> self.output

#: Multiplication operator. The associated type output specifies the return type.
pub trait mul:
    #: The type returned by the multiplication operation.
    type output
    #: Multiplies this value by another value.
    #: Args:
    #:   self: the first operand.
    #:   other: the second operand to multiply.
    #: Returns:
    #:   the result of the multiplication.
    def mul(self, other: self) -> self.output

#: Division operator. The associated type output specifies the return type.
pub trait div:
    #: The type returned by the division operation.
    type output
    #: Divides this value by another value.
    #: Args:
    #:   self: the first operand (dividend).
    #:   other: the second operand to divide by (divisor).
    #: Returns:
    #:   the result of the division.
    def div(self, other: self) -> self.output

#: Remainder operator. The associated type output specifies the return type.
pub trait rem:
    #: The type returned by the remainder operation.
    type output
    #: Computes the remainder of dividing this value by another value.
    #: Args:
    #:   self: the first operand (dividend).
    #:   other: the second operand to divide by (divisor).
    #: Returns:
    #:   the remainder of the division.
    def rem(self, other: self) -> self.output

#: Unary negation operator. The associated type output specifies the return type.
pub trait neg:
    #: The type returned by the negation operation.
    type output
    #: Negates this value (typically returns its additive inverse).
    #: Returns:
    #:   the negated value.
    def neg(self) -> self.output

#: The additive identity: the value `x + zero() == x` holds for.
#:
#: Needed to fold a sequence into a sum without a starting value the caller
#: has to supply, which is what lets `std.algo`'s `sum` answer `0` for an
#: empty iterator instead of `@none`. Split from `add` rather than folded into
#: it because a type can be addable without having an identity.
pub trait zero:
    #: The value that leaves any value unchanged when added to it.
    #: Returns:
    #:   the additive identity for this type.
    static def zero() -> self

#: The multiplicative identity: the value `x * one() == x` holds for.
#:
#: The counterpart of `zero`, and what `std.algo`'s `product` starts from.
pub trait one:
    #: The value that leaves any value unchanged when multiplied by it.
    #: Returns:
    #:   the multiplicative identity for this type.
    static def one() -> self

# The numeric primitives. Written out one impl per type rather than generated,
# because there is no way to be generic over "the numeric types" -- and the
# literals differ between the integer and floating-point families anyway.
#
# An `impl <trait> for <primitive>` used to be parsed, coherence-checked, and
# then silently dropped from the method table: builtin scalars have no
# `type_decl` to key it by. These are the first impls in the standard library
# that depend on that being fixed.
#
# The 128-bit types are absent. A reachable module is compiled in full, not
# just the functions a program calls, so an `impl zero for int128` here would
# make every program fail with "type `int128` has no scalar bytecode
# representation yet". They arrive with codegen increment 6.
impl zero for int8:
    static def zero() -> int8:
        return 0

impl one for int8:
    static def one() -> int8:
        return 1

impl zero for int16:
    static def zero() -> int16:
        return 0

impl one for int16:
    static def one() -> int16:
        return 1

impl zero for int32:
    static def zero() -> int32:
        return 0

impl one for int32:
    static def one() -> int32:
        return 1

impl zero for int64:
    static def zero() -> int64:
        return 0

impl one for int64:
    static def one() -> int64:
        return 1

impl zero for uint8:
    static def zero() -> uint8:
        return 0

impl one for uint8:
    static def one() -> uint8:
        return 1

impl zero for uint16:
    static def zero() -> uint16:
        return 0

impl one for uint16:
    static def one() -> uint16:
        return 1

impl zero for uint32:
    static def zero() -> uint32:
        return 0

impl one for uint32:
    static def one() -> uint32:
        return 1

impl zero for uint64:
    static def zero() -> uint64:
        return 0

impl one for uint64:
    static def one() -> uint64:
        return 1

impl zero for isize:
    static def zero() -> isize:
        return 0

impl one for isize:
    static def one() -> isize:
        return 1

impl zero for usize:
    static def zero() -> usize:
        return 0

impl one for usize:
    static def one() -> usize:
        return 1

impl zero for float32:
    static def zero() -> float32:
        return 0.0

impl one for float32:
    static def one() -> float32:
        return 1.0

impl zero for float64:
    static def zero() -> float64:
        return 0.0

impl one for float64:
    static def one() -> float64:
        return 1.0

