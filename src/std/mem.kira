module std.mem

# Typed, element-counted allocation over the raw byte-level intrinsics
# (`std.intrinsics`'s `rt_alloc`/`rt_realloc`/`rt_free`,
# `src/runtime/allocator.h`).
#
# Everything here is `machine`: obtaining, casting and releasing raw memory
# are exactly the operations `spec/specification/03-advanced/38-machine-layer.md`
# gates, and this module is where that unsafety is meant to be contained.
# Each function is small enough to read in one sitting, which is the point —
# `machine` suspends the compiler's guarantees for a whole body, so a body
# should not be long.
#
# Sizes are in *elements*, not bytes: a caller that already knows it holds
# `T`s should never be the one multiplying by `size_of[T]()`, because that
# multiplication is precisely where a buffer-overflow bug comes from.
#
# Every block is zero-filled, including the grown tail of a `resize`. That is
# the allocator's guarantee, not this module's, and it holds under both
# `KIRA_ALLOCATOR` modes.

use std.intrinsics.{rt_alloc, rt_realloc, rt_free, box_usize}

## Allocates room for `count` values of `T`, zero-filled.
##
## Returns a null pointer when `count` is 0. An allocation that cannot be
## satisfied terminates the process rather than returning null — there is no
## failure channel here yet.
pub machine def alloc[T](count: usize) -> *mut T:
    let raw = rt_alloc(box_usize { v: count * size_of[T]() })
    return ptr_cast[T](raw)

## Resizes a block from `old_count` to `new_count` values of `T`, preserving
## the first `min(old_count, new_count)` values and zeroing any growth.
##
## `p` must have come from `alloc`/`resize` at `old_count`, or be null (in
## which case this allocates). A `new_count` of 0 frees and returns null.
##
## The returned pointer may differ from `p`; the old one must not be used
## again.
pub machine def resize[T](p: *mut T, old_count: usize, new_count: usize) -> *mut T:
    let raw = rt_realloc(ptr_cast[byte](p),
                         box_usize { v: old_count * size_of[T]() },
                         box_usize { v: new_count * size_of[T]() })
    return ptr_cast[T](raw)

## Releases a block obtained from `alloc`/`resize`. A null `p` is a no-op.
##
## `count` must be the element count the block was last sized at. This does
## *not* run `drop` on the values in the block — destructors do not run
## anywhere in Kira yet (see `spec/todo.md` item 6), so a collection holding
## resource-owning elements leaks them regardless of what it does here.
pub machine def free[T](p: *mut T, count: usize) -> unit:
    rt_free(ptr_cast[byte](p), box_usize { v: count * size_of[T]() })

## Copies `count` values of `T` from `src` to `dst`.
##
## The two ranges must not overlap. Written as an element loop rather than a
## bulk byte move because a bulk primitive would be one more intrinsic, and
## this is not on a path where its cost has been shown to matter.
pub machine def copy[T](dst: *mut T, src: *T, count: usize) -> unit:
    var i: usize = 0
    while i < count:
        dst[i] = src[i]
        i = i + 1
