module std.intrinsics

####################
# Cast intrinsics
####################

#: Reinterprets a float64's bit pattern as a uint64 -- `as uint64` on a float
#: is a value conversion (`compile_cast`), not the reinterpret `hash` needs.
intrinsic def rt_bitcast_f64_to_u64(v: float64) -> uint64

#: Reinterprets a float32's bit pattern as a uint32; the `float32` counterpart
#: of `rt_bitcast_f64_to_u64`.
intrinsic def rt_bitcast_f32_to_u32(v: float32) -> uint32

####################
# String intrinsics
####################


#: Result of a substring search. pos is meaningful only when found is true.
type find_result = { found: bool, pos: usize }

intrinsic def rt_str_concat(a: str, b: str) -> str
intrinsic def rt_str_len_scalars(s: str) -> usize
intrinsic def rt_str_repeat_char(c: uint32, n: usize) -> str
intrinsic def rt_str_truncate_scalars(s: str, n: usize) -> str
intrinsic def rt_str_eq(a: str, b: str) -> bool
intrinsic def rt_str_cmp(a: str, b: str) -> int32
intrinsic def rt_str_find(haystack: str, needle: str, from: usize) -> find_result
intrinsic def rt_str_rfind(haystack: str, needle: str) -> find_result
intrinsic def rt_str_reverse(s: str) -> str
intrinsic def rt_str_trim(s: str, mode: uint8) -> str
intrinsic def rt_str_replace(s: str, from: str, to: str) -> str

intrinsic def rt_fmt_radix_digits(value: uint64, radix: uint8, uppercase: bool) -> str
intrinsic def rt_fmt_f64_fixed(value: float64, precision: usize) -> str
intrinsic def rt_fmt_f64_sci(value: float64, precision: usize, uppercase: bool) -> str
intrinsic def rt_fmt_f64_general(value: float64, precision: usize) -> str
intrinsic def rt_fmt_char_from_codepoint(cp: uint32) -> str

####################
# I/O intrinsics
####################

#: Opaque file descriptor wrapper for internal use.
pub type raw_fd = { value: int64 }

#: System error code from a failed I/O operation.
pub type io_errno = { code: int32 }

  #: Options for opening a file.
pub type open_options = {
    read: bool,
    write: bool,
    append: bool,
    create: bool,
    truncate: bool
}
intrinsic def rt_stdin() -> raw_fd
intrinsic def rt_stdout() -> raw_fd
intrinsic def rt_stderr() -> raw_fd

intrinsic def rt_open(path: str, opts: open_options) -> result[raw_fd, io_errno]
intrinsic def rt_close(fd: raw_fd) -> result[unit, io_errno]
intrinsic def rt_read(fd: raw_fd, buf: &mut slice_mut[byte]) -> result[usize, io_errno]
intrinsic def rt_write(fd: raw_fd, buf: &slice[byte]) -> result[usize, io_errno]
intrinsic def rt_flush(fd: raw_fd) -> result[unit, io_errno]

####################
# Panic intrinsics
####################

intrinsic def rt_panic(msg: str) -> never

####################
# Platform intrinsics
####################

#: Raw Unix uname() structure.
type uname_raw = {
    sysname: str,
    nodename: str,
    release: str,
    version: str,
    machine_arch: str,
}

#: Raw Windows version information structure.
type winver_raw = {
    major: uint32,
    minor: uint32,
    build: uint32,
    platform_id: uint32,
    csd_version: str,
}

#: Raw macOS version information structure.
type macver_raw = {
    release: str,
    version: str,
    dev_stage: str,
    non_release_version: str,
    machine_arch: str,
}

#: Information about the C standard library implementation.
pub type libc_version = {
    name: str,
    version: str,
}

#: Gets the Unix uname information.
#: Returns:
#:   a uname_raw structure on success, or an io_errno on failure.
intrinsic def rt_uname() -> result[uname_raw, io_errno]

#: Gets the C library version (Unix only).
#: Returns:
#:   a libc_version structure on success, or an io_errno on failure.
intrinsic def rt_libc_version() -> result[libc_version, io_errno]

#: Gets the Windows version information (Windows only).
#: Returns:
#:   a winver_raw structure on success, or an io_errno on failure.
intrinsic def rt_windows_version() -> result[winver_raw, io_errno]

#: Gets the macOS version information (macOS only).
#: Returns:
#:   a macver_raw structure on success, or an io_errno on failure.
intrinsic def rt_macos_version() -> result[macver_raw, io_errno]

#: Gets the hostname of the machine.
#: Returns:
#:   the hostname string on success, or an io_errno on failure.
intrinsic def rt_gethostname() -> result[str, io_errno]

#: Gets the processor name.
#: Returns:
#:   the processor name string on success, or an io_errno on failure.
intrinsic def rt_processor_name() -> result[str, io_errno]

####################
# Memory intrinsics
####################

#: Raw heap allocation (`src/runtime/allocator.h`). These are the substrate a
#: collection owns its own storage over -- `std.mem` wraps them in the typed,
#: element-counted forms ordinary code should use, and `std.list` is built on
#: those.
#:
#: Every block is zero-filled and 8-byte aligned, including the grown tail of
#: a `rt_realloc`. Sizes are in *bytes*, not elements.
#:
#: The allocator behind them is selectable at run time
#: (`CINDER_ALLOCATOR=system|arena`); `arena` never reclaims, which makes
#: `rt_free` a no-op there. Code built on these must therefore be correct
#: under both -- it must not, for instance, rely on a freed block being
#: reused.

#: Allocates `bytes` of zeroed memory. Returns a null pointer for a request
#: of 0 bytes; an allocation that cannot be satisfied terminates the process
#: rather than returning null, since there is no failure channel here yet.
intrinsic def rt_alloc(bytes: usize) -> *mut byte

#: Resizes a block obtained from `rt_alloc`/`rt_realloc`, preserving the
#: first `min(old_bytes, new_bytes)` bytes and zeroing any growth. A null
#: `p` allocates; a `new_bytes` of 0 frees and returns null.
intrinsic def rt_realloc(p: *mut byte, old_bytes: usize, new_bytes: usize) -> *mut byte

#: Releases a block obtained from `rt_alloc`/`rt_realloc`. A null `p` is a
#: no-op. `bytes` must be the size the block was last allocated at.
intrinsic def rt_free(p: *mut byte, bytes: usize) -> unit
