module std.traits

#: What broad shape a reflected type is — the classification `T.kind()`
#: (`src/comptime/reflect.cpp`) returns.
#:
#: `T.kind()` never fails: every type falls into one of these, picking the
#: closest kind when a finer distinction isn't available. Two variants are
#: real but currently unreachable through `T.kind()`'s own type-argument
#: path (documented in `reflect.cpp`'s `make_type_kind_value`): a view can
#: never be told apart from its referent this way (both reduce to
#: `@scalar_kind`), and `@trait_kind`/`@module_kind` are never produced —
#: `T` always names a type, never a trait or a module.
pub type type_kind =
    | @struct_kind
    | @sum_kind
    | @scalar_kind
    | @view_kind
    | @array_kind
    | @fn_kind
    | @trait_kind
    | @module_kind

#: A single flat classification of `T`'s broad shape, folding both `T.kind()`
#: and the builtin-name predicates below into one enum for a `match`-based
#: dispatch, rather than testing every predicate in turn.
#:
#: Every predicate in this file is `static`: usable from a `static if`/
#: `static assert`/another `static def`'s own body, and — for a call with no
#: non-constant arguments — from ordinary code too, where the whole call
#: folds to a literal at the call site rather than lowering
#: (`try_fold_comptime_only_call`, `check.cpp`).
pub type type_category =
    | @boolean
    | @character
    | @signed_integer
    | @unsigned_integer
    | @floating_point
    | @string
    | @array_like
    | @view
    | @struct_like
    | @sum_like
    | @function
    | @other

#: True for `bool`.
pub static pure def is_bool[T]() -> bool:
    return T.name() == "bool"

#: True for `char`.
pub static pure def is_char[T]() -> bool:
    return T.name() == "char"

#: True for `int8`..`int128`, `isize`.
pub static pure def is_signed_integer[T]() -> bool:
    let n = T.name()
    return (n == "int8" or n == "int16" or n == "int32" or n == "int64" or
        n == "int128" or n == "isize")

#: True for `uint8`..`uint128`, `usize`, `byte`.
pub static pure def is_unsigned_integer[T]() -> bool:
    let n = T.name()
    return (n == "uint8" or n == "uint16" or n == "uint32" or n == "uint64" or
        n == "uint128" or n == "usize" or n == "byte")

#: True for any builtin integer type, signed or unsigned.
pub static pure def is_integer[T]() -> bool:
    return is_signed_integer[T]() or is_unsigned_integer[T]()

#: True for `float32`, `float64`, `float128`.
pub static pure def is_float[T]() -> bool:
    let n = T.name()
    return n == "float32" or n == "float64" or n == "float128"

#: True for any builtin integer or floating-point type.
pub static pure def is_numeric[T]() -> bool:
    return is_integer[T]() or is_float[T]()

# Category concepts: the builtin scalar families, as bounds.
#
# A generic body may only do with a `T` what its bounds promise
# (`spec/inference-rewrite.md` phase 9). Traits cover methods and the
# operators user types overload; these cover what only the builtin numbers
# have — a literal written as a `T`, an `as` conversion, the builtin
# operators — and every core trait all their members implement (`eq`, `ord`,
# `show`, `add`, ... from `traits.scalar.cn`). Each is satisfied by the types
# the predicate it is named after answers `true` for, except the 128-bit
# ones: those have no representation on the bytecode VM, so they have none
# of those impls to promise. The checker knows the same membership
# (`checker::category_members`).

#: A builtin signed integer: `int8`..`int64`, `isize`.
pub concept signed_integer[T]:
    is_signed_integer[T]() and T.name() != "int128"

#: A builtin unsigned integer: `uint8`..`uint64`, `usize`, `byte`.
pub concept unsigned_integer[T]:
    is_unsigned_integer[T]() and T.name() != "uint128"

#: Any builtin integer, signed or unsigned, but not a 128-bit one.
pub concept integer[T]:
    is_integer_below_128[T]()

#: True for a builtin integer that is not 128 bits wide — the members of the
#: `integer` concept.
pub static pure def is_integer_below_128[T]() -> bool:
    let n = T.name()
    return is_integer[T]() and n != "int128" and n != "uint128"

#: A builtin floating-point type: `float32`, `float64`.
pub concept float[T]:
    is_float[T]() and T.name() != "float128"

#: Any builtin integer or floating-point type, but not a 128-bit one.
pub concept numeric[T]:
    is_integer_below_128[T]() or (is_float[T]() and T.name() != "float128")

#: True for any builtin numeric type, `bool`, or `char`.
pub static pure def is_scalar[T]() -> bool:
    return is_numeric[T]() or is_bool[T]() or is_char[T]()

#: True for `str`.
pub static pure def is_str[T]() -> bool:
    return T.name() == "str"

#: True for `unit`.
pub static pure def is_unit[T]() -> bool:
    return T.name() == "unit"

#: True for `array[_, _]`.
pub static pure def is_array[T]() -> bool:
    return T.name() == "array"

#: True for `slice[_]` or `mut slice[_]`.
pub static pure def is_slice[T]() -> bool:
    let n = T.name()
    return n == "slice" or n == "slice_mut"

#: True for `&T'` or `&mut T'`, for some `T'`.
#:
#: Only meaningful when `T` was itself bound to a view type by a call site's
#: own argument (e.g. a generic parameter inferred from a `&U` argument) —
#: a view named directly in brackets (`is_view[&int32]()`) can't be written
#: at all, since a view isn't a plain type name.
pub static pure def is_view[T]() -> bool:
    return T.name() == "ref"

#: True for `box[_]` or `box[trait]`.
pub static pure def is_box[T]() -> bool:
    return T.name() == "box"

#: True for `option[_]`.
pub static pure def is_option[T]() -> bool:
    return T.name() == "option"

#: True for `result[_, _]`.
pub static pure def is_result[T]() -> bool:
    return T.name() == "result"

#: True for a function type `fn(...) -> _`.
pub static pure def is_fn[T]() -> bool:
    return T.name() == "fn"

#: True for a user `type ... = { ... }` declaration.
#:
#: Unlike every predicate above, this reads `T`'s declaration shape via
#: `T.kind()` rather than matching a builtin name — otherwise the same
#: `static` scope as the rest of this file (see `type_category`'s doc
#: comment above).
pub static pure def is_struct[T]() -> bool:
    match T.kind():
        @struct_kind => return true
        _ => return false

#: True for a user `type ... = @a | @b(...) | ...` declaration.
#: See `is_struct`'s doc comment for this predicate's current scope.
pub static pure def is_sum[T]() -> bool:
    match T.kind():
        @sum_kind => return true
        _ => return false

#: `A` and `B` intern to the same type — reflexive, symmetric, and requires
#: no bound on either. Compares by rendered name only (as every predicate
#: above does): two distinct declarations that happen to share a bare name
#: are not distinguished, mirroring `T.name()`'s own existing collapse of
#: generic arguments (`spec/todo.md` item 5's "list[int32]" and "list[str]"
#: both name themselves "list").
pub static pure def is_same[A, B]() -> bool:
    return A.name() == B.name()

#: `From` converts to `To` — either they're the same type, or `From`
#: implements `into` for *some* target type.
#:
#: `implements[T, Trait]` only accepts a bare trait name (see its own doc
#: comment), so this cannot ask specifically for `into[To]` — only whether
#: `From` implements `into` at all. A `From` with an `into` impl for a type
#: other than `To` therefore answers `true` here when it should answer
#: `false`; there is no over-approximation in the other direction (a
#: `From` with no `into` impl at all correctly answers `false` unless
#: `From == To`).
#:
#: `static`, like every predicate in this file: `implements[..]()` is
#: recognized purely by call shape inside the compile-time evaluator (see
#: `infer_implements_call`, `check.cpp`); a `static def`'s body is executed
#: directly by that evaluator rather than lowered, both when reached from
#: another `static def`/`static assert`/`static if` and, for a comptime-only
#: call with no non-constant arguments, when reached from ordinary code (the
#: call is folded to a literal at the call site — `try_fold_comptime_only_call`,
#: `check.cpp`).
pub static pure def is_convertible[From, To]() -> bool:
    return is_same[From, To]() or implements[From, into]()

#: `T`'s broad shape, as one flat enum value. See `is_struct`'s doc comment
#: for this predicate's current scope (a `static`/comptime context).
pub static pure def type_category[T]() -> type_category:
    let n = T.name()
    if n == "bool":
        return @boolean
    if n == "char":
        return @character
    if (n == "int8" or n == "int16" or n == "int32" or n == "int64" or
        n == "int128" or n == "isize"):
        return @signed_integer
    if (n == "uint8" or n == "uint16" or n == "uint32" or n == "uint64" or
        n == "uint128" or n == "usize" or n == "byte"):
        return @unsigned_integer
    if n == "float32" or n == "float64" or n == "float128":
        return @floating_point
    if n == "str":
        return @string
    if n == "array" or n == "slice" or n == "slice_mut":
        return @array_like
    if n == "ref":
        return @view
    match T.kind():
        @struct_kind => return @struct_like
        @sum_kind => return @sum_like
        @fn_kind => return @function
        _ => return @other
