module std.list

# `list[T]` — a growable, heap-owning sequence, written entirely in Kira over
# `std.mem`'s typed allocation and the `machine` layer's raw-pointer
# indexing, with no compiler support for the type beyond what any user
# struct gets (`spec/list-migration-design.md`). `[1, 2, 3]` reaches this
# type through `std.traits.from_array`, `xs[i]`/`xs[i] = v` through
# `std.traits.index`/`index_set`, and `for x in xs` through
# `std.iter.into_iterator` — the same three traits phases 1-3 of the
# migration gave every user collection, not anything `list` alone has.
#
# Storage is exactly `cap` elements at `data`, or a null `data` when
# `cap == 0`; `len <= cap` always, and slots `len..cap` are zeroed but hold
# no meaningful value. Every method that touches memory is `machine` and
# short; everything a caller needs is safe.
#
# `impl drop` below releases the storage automatically at scope exit
# (`spec/todo.md` item 6). Elements are not individually dropped — a
# container recursing `drop` through its elements isn't implemented, only a
# struct's own fields are — so a `list` of resource-owning elements still
# leaks *those*, just not its own backing allocation.

use std.mem.{alloc, resize, free as mem_free, copy}
use std.panic.panic
use std.iter.list_into_iter

#: A growable, contiguous sequence of `T`, owning its own heap storage.
pub type list[T] = {
    #: Number of elements actually stored.
    len: usize,
    #: Number of elements `data` has room for.
    cap: usize,
    #: The storage, or null when `cap` is 0.
    data: *mut T,
}

extend[T] list[T]:
    #: An empty `list` that has not allocated anything yet.
    pub machine def new() -> list[T]:
        return list[T] { len: 0, cap: 0, data: alloc[T](0) }

    #: How many elements this holds.
    pub def len(self) -> usize:
        return self.len

    #: How many elements this can hold before it must grow.
    pub def capacity(self) -> usize:
        return self.cap

    #: Whether this holds no elements.
    pub def is_empty(self) -> bool:
        return self.len == 0

    #: The first element, or `@none` when the list is empty.
    pub def first(self) -> option[T]:
        if self.len == 0:
            return @none
        return @some(self[0])

    #: The last element, or `@none` when the list is empty.
    pub def last(self) -> option[T]:
        if self.len == 0:
            return @none
        return @some(self[self.len - 1])

    #: Ensures room for at least `n` elements without reallocating again.
    #:
    #: Never shrinks: a smaller `n` than the current capacity is a no-op.
    pub machine def reserve(mut self, n: usize) -> unit:
        if n <= self.cap:
            return
        self.data = resize(self.data, self.cap, n)
        self.cap = n

    #: Appends `value`, growing the storage if it is full.
    #:
    #: Growth doubles the capacity (starting at 4), so a sequence of `n`
    #: pushes performs O(log n) reallocations and copies each element O(1)
    #: times on average.
    pub machine def push(mut self, value: T) -> unit:
        if self.len == self.cap:
            var grown = self.cap * 2
            if grown == 0:
                grown = 4
            self.reserve(grown)
        self.data[self.len] = value
        self.len = self.len + 1

    #: Removes and returns the last element, or `@none` when empty.
    #:
    #: The vacated slot is left as it was rather than cleared: nothing can
    #: read it back (`len` no longer covers it) and a later `push` overwrites
    #: it outright.
    pub machine def pop(mut self) -> option[T]:
        if self.len == 0:
            return @none
        self.len = self.len - 1
        return @some(self.data[self.len])

    #: The element at `i`, or `@none` when `i` is out of range.
    pub machine def get(self, i: usize) -> option[T]:
        if i >= self.len:
            return @none
        return @some(self.data[i])

    #: Replaces the element at `i`. Returns whether `i` was in range.
    pub machine def set(mut self, i: usize, value: T) -> bool:
        if i >= self.len:
            return false
        self.data[i] = value
        return true

    #: Removes every element, keeping the allocated capacity.
    #:
    #: O(1): only `len` changes. The elements are not dropped — a container
    #: recursing `drop` through its elements is not implemented.
    pub def clear(mut self) -> unit:
        self.len = 0

    #: Releases the storage, leaving an empty `list` that owns nothing.
    #:
    #: Calling this explicitly is fine — `free` on an already-freed (`cap ==
    #: 0`, `data` null) list is a no-op — but is no longer required: `drop`
    #: below runs it automatically at scope exit. `data` must be nulled out
    #: here, not just `cap` zeroed: `drop`'s own `mem_free` reads `self.data`
    #: again regardless, and re-freeing the same stale (already-freed)
    #: pointer is a real double-free, not merely a logical one — `mem_free`'s
    #: `count == 0` does not stop it from calling through to the allocator.
    pub machine def free(mut self) -> unit:
        mem_free(self.data, self.cap)
        self.len = 0
        self.cap = 0
        self.data = alloc[T](0)

    #: The address of element 0, for raw-pointer access (`spec/specification/
    #: 03-advanced/38-machine-layer.md`). Bounds are the caller's
    #: responsibility past this point, same as `array`/`slice`.
    pub machine def as_ptr(self) -> *T:
        return self.data

    #: The `&mut` sibling of `as_ptr`.
    pub machine def as_mut_ptr(mut self) -> *mut T:
        return self.data

    #: A read-only view of every element, for the algorithms
    #: (`std.algo`'s sort/search family) that operate over a `slice[T]`
    #: range rather than a whole collection. `array`/`slice`/`str` are the
    #: only receivers the compiler still range-indexes directly
    #: (`spec/list-migration-design.md` phase 4); this is how a library
    #: type built the same view `xs[0..xs.len()]` would have been.
    pub machine def as_slice(self) -> slice[T]:
        return slice_from_raw_parts(self.data, self.len)

    #: The `&mut` sibling of `as_slice`.
    pub machine def as_mut_slice(mut self) -> slice_mut[T]:
        return slice_mut_from_raw_parts(self.data, self.len)

impl[T] drop for list[T]:
    #: Releases the storage this list owns. Elements are not individually
    #: dropped (`spec/todo.md` item 6: sum/struct payload recursion through a
    #: container isn't implemented), only the backing allocation itself —
    #: exactly what `free` above already does, and safe to run twice: a list
    #: already `free`d has `cap == 0`/`data` null, and `mem_free` on that is
    #: a no-op.
    machine def drop(mut self) -> unit:
        mem_free(self.data, self.cap)

#: Reading `v[i]`. Bounds-checked: an out-of-range index panics rather than
#: reading past the end.
impl[T] index[usize] for list[T]:
    type output = T
    machine def at(self, i: usize) -> T:
        if i >= self.len:
            panic("index out of range")
        return self.data[i]

#: Borrowing `&mut v[i]`, with the same bounds check.
impl[T] index_mut[usize] for list[T]:
    type output_mut = cell_mut[T]
    machine def at_mut(mut self, i: usize) -> cell_mut[T]:
        if i >= self.len:
            panic("index out of range")
        return &mut self.data[i]

#: Borrowing `&v[i]`, with the same bounds check. The read-only sibling of
#: `index_mut` above: same address, but a `cell[T]` rather than `cell_mut[T]`
#: so only `.get()` is offered, not `.set()`.
impl[T] index_ref[usize] for list[T]:
    machine def at_ref(self, i: usize) -> cell[T]:
        if i >= self.len:
            panic("index out of range")
        return &self.data[i]

#: Reading `v[a..b]` — a read-only sub-view over the same storage, no copy.
#: A separate `index` impl from the element one above, with its own
#: `output`: indexing by a range means something different from indexing by
#: a position, and the two answer with different types.
#:
#: `b` is exclusive and `b == self.len` is in bounds (an empty view at the
#: end is a legal, useful thing to ask for); `a > b` is not.
impl[T] index[range[usize]] for list[T]:
    type output = slice[T]
    machine def at(self, i: range[usize]) -> slice[T]:
        if i.end > self.len or i.start > i.end:
            panic("range index out of range")
        return slice_from_raw_parts(&self.data[i.start], i.end - i.start)

#: Borrowing `&mut v[a..b]`. The mutable sibling of the impl above, and the
#: reason `index_mut` carries its own `output_mut`: this hands back a
#: `slice_mut[T]`, which is already a mutable view, not a `cell` around one.
impl[T] index_mut[range[usize]] for list[T]:
    type output_mut = slice_mut[T]
    machine def at_mut(mut self, i: range[usize]) -> slice_mut[T]:
        if i.end > self.len or i.start > i.end:
            panic("range index out of range")
        return slice_mut_from_raw_parts(&mut self.data[i.start],
                                        i.end - i.start)

#: Writing `v[i] = x`, with the same bounds check.
impl[T] index_set[usize] for list[T]:
    type output = T
    machine def set_at(mut self, i: usize, value: T) -> unit:
        if i >= self.len:
            panic("index out of range")
        self.data[i] = value

#: `for x in v` — hands back `std.iter`'s consuming iterator
#: (`list_into_iter[T]`), the same one `std.iter.into_iter` already builds
#: for `xs.into_iter()`/`xs.collect()` UFCS calls. `std.iter` also already
#: provides the *borrowing* routes `for x in &v`/`for x in &mut v` dispatch
#: to (`iter`/`iter_mut`, spec/todo.md #20) — real `&T`/`&mut T`-yielding,
#: double-ended, exact-size iteration, all written once there rather than
#: duplicated here at a weaker (value-copy-only) level.
impl[T] into_iterator[T] for list[T]:
    type iter = list_into_iter[T]
    def into_iter(self) -> list_into_iter[T]:
        let n = self.len
        return list_into_iter[T] { src: self, at: 0, end: n }

#: `let v: list[int32] = [1, 2, 3]`.
#:
#: Allocates exactly `n` elements — a literal's length is known at compile
#: time, so there is no reason to over-reserve and no reason to grow.
impl[T] from_array[T] for list[T]:
    static machine def from_array[n: usize](items: array[T, n]) -> list[T]:
        var out = list[T].new()
        out.reserve(n)
        var i: usize = 0
        while i < n:
            out.push(items[i])
            i = i + 1
        return out

#: `vector[T]` is `list[T]` by another name — the spelling
#: `spec/todo.md` item 20's tests import (`std.list.vector`). There is
#: exactly one growable-sequence type; this alias exists so callers can
#: use either name without `list[T]` and `vector[T]` diverging.
pub type vector[T] = list[T]
