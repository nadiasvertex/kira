module std.list

# Inherent methods on `list[T]`.
#
# Like `std.option` and `std.result`, these were `k_builtin_methods` entries
# the compiler typed without any backend compiling them. They are ordinary
# Kira here, over the primitives the builtin `list` still provides directly:
# `len` and indexing.
#
# Only the direct accessors live here, deliberately. The builtin table also
# carried `contains`, `any`, `all`, `find`, and `filter`, and those are *not*
# reimplemented as list methods: they are iterator operations, and
# `spec/collections-algorithms-design.md` puts them on the pipeline
# (`xs.iter().any(...)`) so they compose and stay lazy. `std.algo` already
# owns `filter` as a lazy adapter — an eager `list.filter` would have shadowed
# it with a different meaning for the same name. The rest arrive with the
# terminals in that same module.
#
# `sort` is likewise absent here: it belongs with the slice algorithms
# (`std.algo`'s `sort`/`stable_sort`/etc., spec/specification/04-stdlib/
# algorithms/51-sorting-and-searching.md), over a `slice_mut[T]` range
# rather than a whole list — `xs.sort()` on a `list[T]` reaches it via UFCS
# once a caller forms the full-range view itself (`sort(&mut xs[0..xs.len()])`);
# no forwarding method is added here to avoid re-deriving the same range on
# every call. `pop` and `clear` need to *shrink* a list, which no primitive
# exposes; they return once Phase 7 rebuilds `list` over `alloc`/pointer
# primitives.
#
# All of them were removed from the builtin table regardless, since an entry
# there with no lowering is worse than no entry at all: it type-checks and
# then fails inside the compiler, where absence gives an honest "no method"
# with a suggestion.

extend[T] list[T]:
    ## Whether this list has no elements.
    def is_empty(self) -> bool:
        return self.len() == 0

    ## The first element, or `@none` when the list is empty.
    def first(self) -> option[T]:
        if self.len() == 0:
            return @none
        return @some(self[0])

    ## The last element, or `@none` when the list is empty.
    def last(self) -> option[T]:
        if self.len() == 0:
            return @none
        return @some(self[self.len() - 1])

# ==========================================================================
#  `vector[T]` — a growable list written in Kira, owning its own storage.
#
#  This is the `list` rebuild the header comment above anticipated: `push`,
#  `pop`, `clear` and `reserve` are ordinary Kira here, over `std.mem`'s
#  typed allocation and raw-pointer indexing, with no compiler support for
#  the type itself beyond what any user struct gets.
#
#  It is deliberately a *separate* type from the builtin `list[T]` rather
#  than a replacement for it. The builtin is still what `[1, 2, 3]`
#  constructs, what `for x in xs` iterates, and what every other stdlib
#  module is written against; displacing it means moving literal
#  construction, iteration and index sugar off a compiler-known 3-slot
#  representation, which is a language change rather than a library one.
#  `vector[T]` is the destination that change would move `list[T]` to, and it
#  exists now so the substrate underneath it is exercised by something real.
#
#  Storage is exactly `cap` elements at `data`, or a null `data` when
#  `cap == 0`; `len <= cap` always, and slots `len..cap` are zeroed but hold
#  no meaningful value. Every method that touches memory is `machine` and
#  short; everything a caller needs is safe.
#
#  Not yet handled, and not hidden: `free` must be called explicitly. Kira
#  runs no scope-exit `drop` glue on either backend (`spec/todo.md` item 6),
#  so a `vector` that goes out of scope leaks its buffer under
#  `KIRA_ALLOCATOR=system` exactly as every heap value already leaks under
#  the bump arena. Elements are not dropped either, for the same reason.
# ==========================================================================

use std.mem.{alloc, resize, free as mem_free, copy}
use std.panic.panic

## A growable, contiguous sequence of `T`, owning its own heap storage.
pub type vector[T] = {
    ## Number of elements actually stored.
    len: usize,
    ## Number of elements `data` has room for.
    cap: usize,
    ## The storage, or null when `cap` is 0.
    data: *mut T,
}

extend[T] vector[T]:
    ## An empty `vector` that has not allocated anything yet.
    pub machine def new() -> vector[T]:
        return vector[T] { len: 0, cap: 0, data: alloc[T](0) }

    ## How many elements this holds.
    pub def len(self) -> usize:
        return self.len

    ## How many elements this can hold before it must grow.
    pub def capacity(self) -> usize:
        return self.cap

    ## Whether this holds no elements.
    pub def is_empty(self) -> bool:
        return self.len == 0

    ## Ensures room for at least `n` elements without reallocating again.
    ##
    ## Never shrinks: a smaller `n` than the current capacity is a no-op.
    pub machine def reserve(mut self, n: usize) -> unit:
        if n <= self.cap:
            return
        self.data = resize(self.data, self.cap, n)
        self.cap = n

    ## Appends `value`, growing the storage if it is full.
    ##
    ## Growth doubles the capacity (starting at 4), so a sequence of `n`
    ## pushes performs O(log n) reallocations and copies each element O(1)
    ## times on average.
    pub machine def push(mut self, value: T) -> unit:
        if self.len == self.cap:
            var grown = self.cap * 2
            if grown == 0:
                grown = 4
            self.reserve(grown)
        self.data[self.len] = value
        self.len = self.len + 1

    ## Removes and returns the last element, or `@none` when empty.
    ##
    ## The vacated slot is left as it was rather than cleared: nothing can
    ## read it back (`len` no longer covers it) and a later `push` overwrites
    ## it outright.
    pub machine def pop(mut self) -> option[T]:
        if self.len == 0:
            return @none
        self.len = self.len - 1
        return @some(self.data[self.len])

    ## The element at `i`, or `@none` when `i` is out of range.
    pub machine def get(self, i: usize) -> option[T]:
        if i >= self.len:
            return @none
        return @some(self.data[i])

    ## Replaces the element at `i`. Returns whether `i` was in range.
    pub machine def set(mut self, i: usize, value: T) -> bool:
        if i >= self.len:
            return false
        self.data[i] = value
        return true

    ## Removes every element, keeping the allocated capacity.
    ##
    ## O(1): only `len` changes. The elements are not dropped, because
    ## nothing in Kira runs `drop` yet.
    pub def clear(mut self) -> unit:
        self.len = 0

    ## Releases the storage, leaving an empty `vector` that owns nothing.
    ##
    ## Must be called explicitly — see this section's header comment.
    pub machine def free(mut self) -> unit:
        mem_free(self.data, self.cap)
        self.len = 0
        self.cap = 0

# --------------------------------------------------------------------------
#  `vector[T]` as an ordinary collection.
#
#  These four impls are what `spec/list-migration-design.md` phases 1-3 made
#  possible, and together they are the whole of what `list[T]` gets from the
#  compiler that a user type could not have: indexing, iteration, and
#  construction from a literal. With them, `vector[T]` is usable with the
#  same syntax as the builtin — which is the point of the migration, and the
#  thing to check before phase 4 moves `list[T]` onto this storage.
# --------------------------------------------------------------------------

## Reading `v[i]`. Bounds-checked: an out-of-range index panics rather than
## reading past the end, exactly as the builtin `list[T]` does.
impl[T] index[usize] for vector[T]:
    type output = T
    machine def at(self, i: usize) -> T:
        if i >= self.len:
            panic("index out of range")
        return self.data[i]

## Writing `v[i] = x`, with the same bounds check.
impl[T] index_set[usize] for vector[T]:
    type output = T
    machine def set_at(mut self, i: usize, value: T) -> unit:
        if i >= self.len:
            panic("index out of range")
        self.data[i] = value

## An iterator over a `vector[T]`'s elements, by value.
##
## Holds the storage pointer and a cursor rather than a copy of the vector:
## iterating must not allocate, and must see the elements the vector has.
pub type vector_iter[T] = { data: *mut T, len: usize, i: usize }

impl[T] iterator[T] for vector_iter[T]:
    machine def next(mut self) -> option[T]:
        if self.i >= self.len:
            return @none
        let value = self.data[self.i]
        self.i = self.i + 1
        return @some(value)

## `for x in v` — the collection hands back an iterator rather than being
## one itself, which is why this is `into_iterator` and not `iterator`.
impl[T] into_iterator[T] for vector[T]:
    type iter = vector_iter[T]
    def into_iter(self) -> vector_iter[T]:
        return vector_iter[T] { data: self.data, len: self.len, i: 0 }

## `let v: vector[int32] = [1, 2, 3]`.
##
## Allocates exactly `n` elements — a literal's length is known at compile
## time, so there is no reason to over-reserve and no reason to grow.
impl[T] from_array[T] for vector[T]:
    static machine def from_array[n: usize](items: array[T, n]) -> vector[T]:
        var out = vector[T].new()
        out.reserve(n)
        var i: usize = 0
        while i < n:
            out.push(items[i])
            i = i + 1
        return out
