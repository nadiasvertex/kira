module std.traits

# The operators that let a user type behave like a built-in collection:
# indexing, and construction from a sequence literal.
#
# `a[i]` is the only core operator that used to be a compiler builtin over a
# handful of known container shapes rather than a trait anyone can implement
# (`spec/list-migration-design.md` phase 1). These traits are what make it
# ordinary: a user collection that implements them is indexable with exactly
# the syntax `list`/`slice`/`str`/`array` have always had.
#
# Reading, borrowing and writing are three traits rather than one because
# they are three different capabilities. A read-only view implements `index`
# alone; a type that permits `v[i] = x` also implements `index_set`. Folding
# them together would mean every indexable type has to answer for writing,
# and would make the diagnostic for a missing write capability say "not
# indexable", which is the wrong thing to tell someone whose `v[i]` reads
# work fine.
#
# The index type is a parameter, so one collection can be indexed several
# ways: `index[usize]` for elements and `index[range]` for sub-ranges are
# separate impls with different `output` types, not a special case in the
# compiler.

#: A half-open interval — what `a..b` evaluates to.
#:
#: An ordinary struct, not a compiler builtin. It has to be one: `v[a..b]`
#: on a user collection dispatches to `impl index[range[usize]]`, whose
#: `at` receives the range as a value and reads its bounds, and a type the
#: compiler only ever desugared away could not be received or read. The
#: paths that never need a value — `for i in a..b`, and range-indexing an
#: `array`/`slice`/`str` — still lower the bounds directly and never build
#: one of these.
#:
#: `start` is included, `end` is not, so `len` is `end - start` and an
#: empty range is any `start == end`. `a..=b` normalizes to `a..(b + 1)`.
pub type range[T] = {
    #: First index in the interval.
    start: T,
    #: One past the last index in the interval.
    end: T,
}

#: Reading `self[i]`.
pub trait index[I]:
    #: The type `self[i]` evaluates to.
    type output
    #: Returns the value at `i`.
    #: Args:
    #:   self: the collection.
    #:   i: the index.
    #: Returns:
    #:   the value at that index.
    def at(self, i: I) -> self.output

#: Borrowing `&mut self[i]`.
#:
#: Separate from `index` because handing out a mutable interior reference is
#: a stronger promise than answering a read: the collection must not move its
#: storage while that reference is live.
pub trait index_mut[I] requires index[I]:
    #: The type `&mut self[i]` evaluates to.
    #:
    #: Its own associated type rather than `cell[index.output]`, because a
    #: mutable borrow is not uniformly "a cell around what a read yields".
    #: Borrowing one element gives `cell[T]`, an address to write through;
    #: borrowing a range gives `slice_mut[T]`, which is already a mutable
    #: view and wants no cell around it. Spelling it here lets one type
    #: implement both without either impl lying about its shape.
    #:
    #: Spelled as the mutable view itself (`cell_mut[T]`, `slice_mut[T]`)
    #: rather than with a `mut` prefix: `mut` in type position is sugar for
    #: the `_mut` counterpart of the view it precedes, and there is nothing
    #: for it to precede here.
    type output_mut
    #: Returns a mutable view of the value at `i`.
    #: Args:
    #:   self: the collection.
    #:   i: the index.
    #: Returns:
    #:   a mutable view of the value at that index.
    def at_mut(mut self, i: I) -> self.output_mut

#: Writing `self[i] = value`.
pub trait index_set[I]:
    #: The type `self[i] = value` accepts.
    type output
    #: Stores `value` at `i`.
    #: Args:
    #:   self: the collection.
    #:   i: the index.
    #:   value: the value to store.
    #: Returns:
    #:   unit (nothing).
    def set_at(mut self, i: I, value: self.output) -> unit

#: Construction from a sequence literal.
#:
#: A type implementing this can be built by writing `[a, b, c]` where that
#: type is expected — the literal's elements are collected into an
#: `array[T, n]`, and this is handed that array. `n` is a compile-time
#: constant, so an impl may size its storage exactly.
#:
#: This is the third privilege `list[T]` used to hold alone
#: (`spec/list-migration-design.md` phase 3): literal syntax was wired to one
#: compiler-known type rather than to anything that could say what a literal
#: of it means.
pub trait from_array[T]:
    #: Builds self from the literal's elements.
    #: Args:
    #:   items: the literal's elements, with its length in the type.
    #: Returns:
    #:   the constructed collection.
    static def from_array[n: usize](items: array[T, n]) -> self
