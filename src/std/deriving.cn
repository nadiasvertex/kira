module std.derive

#: Real, working deriving show/eq/debug for a concrete, struct-shaped
#: type — the compile-time evaluation subsystem's own worked example (spec/
#: cinder-reference.md, "Generating definitions") made runnable end to end, and
#: extended to the other traits that have enough runtime support to back a
#: real generated method body (ord/hash do not yet — see
#: semantic::checker::resolve_deriving_traits's doc comment). Each is
#: called implicitly by resolve_deriving_traits for every
#: type ... deriving <trait> on a concrete struct; each is also callable
#: directly, e.g. ~derive_show[SomeType](), at module top level.
#:
#: All three build up a value incrementally over static for f in T.fields():
#: and splice the result into a freshly quoted impl <trait> for <T>: ....
#: The type-position splice — ~(expr.ident(T.name())) — and the returned
#: body both reference these functions' own local bindings from *inside* a
#: nested quote, which only resolves correctly because quote construction
#: eagerly materializes any splice found within it (see
#: comptime::evaluator::materialize_quote) instead of leaving it as literal
#: syntax to be re-evaluated later, after each call's own locals are gone.

#: Generates an impl of show for a struct type, displaying all fields in
#: the format: TypeName { field1: value1, field2: value2, ... }
#: Args:
#:   T: the concrete struct type to generate show for.
#: Returns:
#:   a def_expr representing the full impl block for the show trait.
static def derive_show[T]() -> def_expr:
    var body: expr = expr.lit(T.name())
    body = expr.interp_concat(body, expr.lit(" \{ "))
    var first: bool = true
    static for f in T.fields():
        if first:
            first = false
        else:
            body = expr.interp_concat(body, expr.lit(", "))
        body = expr.interp_concat(body, expr.lit(f.name))
        body = expr.interp_concat(body, expr.lit(": "))
        body = expr.interp_concat(body, expr.field(expr.ident("self"), f.name))
    body = expr.interp_concat(body, expr.lit(" \}"))
    return `(impl show for ~(expr.ident(T.name())):
        def show(self) -> str:
            return ~body)`

#: Generates an impl of debug for a struct type. Similar to derive_show but
#: each field value is formatted using debug formatting (with {:?} semantics),
#: making it suitable for values that only implement debug, not show. String
#: fields render quoted and escaped.
#: Args:
#:   T: the concrete struct type to generate debug for.
#: Returns:
#:   a def_expr representing the full impl block for the debug trait.
static def derive_debug[T]() -> def_expr:
    var body: expr = expr.lit(T.name())
    body = expr.interp_concat(body, expr.lit(" \{ "))
    var first: bool = true
    static for f in T.fields():
        if first:
            first = false
        else:
            body = expr.interp_concat(body, expr.lit(", "))
        body = expr.interp_concat(body, expr.lit(f.name))
        body = expr.interp_concat(body, expr.lit(": "))
        body = expr.interp_concat(
            body, expr.debug(expr.field(expr.ident("self"), f.name)))
    body = expr.interp_concat(body, expr.lit(" \}"))
    return `(impl debug for ~(expr.ident(T.name())):
        def debug(self) -> str:
            return ~body)`

#: Generates an impl of eq for a struct type, building a chain of field
#: equality comparisons connected by and. An empty struct trivially derives
#: to true (two empty-struct instances of the same type are equal).
#: The other parameter type is literal, unspliced quoted syntax (an ordinary
#: trait-required reference), while only the target type and the comparison
#: chain are generated content.
#: Args:
#:   T: the concrete struct type to generate eq for.
#: Returns:
#:   a def_expr representing the full impl block for the eq trait.
static def derive_eq[T]() -> def_expr:
    var body: expr = expr.lit(true)
    var first: bool = true
    static for f in T.fields():
        let field_eq: expr = expr.binary(
            "==", expr.field(expr.ident("self"), f.name),
            expr.field(expr.ident("other"), f.name))
        if first:
            body = field_eq
            first = false
        else:
            body = expr.binary("and", body, field_eq)
    return `(impl eq for ~(expr.ident(T.name())):
        def eq(self, other: &self) -> bool:
            return ~body)`

#: Generates an impl of ord for a struct type: a lexicographic, field-by-field
#: three-way comparison in declaration order, so the first field that differs
#: decides the result and a struct whose fields are all equal compares
#: @equal. An empty struct derives to @equal unconditionally.
#: Each field is compared with std.traits' ord_cmp, and the per-field results
#: are joined with ord_then; both are prelude-visible free functions rather
#: than method calls, because the AST builders can splice a call but neither a
#: statement nor a match arm, and a lexicographic comparison is a fold that
#: needs a combining function. See those two functions' own doc comments for
#: why ord_cmp compares with < instead of recursing through .cmp().
#: The fold is left-nested (ord_then(ord_then(a, b), c)) because that is the
#: order static for produces; ord_then is associative, so this agrees with the
#: right-nested reading field by field.
#: Args:
#:   T: the concrete struct type to generate ord for.
#: Returns:
#:   a def_expr representing the full impl block for the ord trait.
static def derive_ord[T]() -> def_expr:
    var body: expr = expr.call(expr.ident("ord_equal"))
    var first: bool = true
    static for f in T.fields():
        let field_cmp: expr = expr.call(
            expr.ident("ord_cmp"),
            expr.field(expr.ident("self"), f.name),
            expr.field(expr.ident("other"), f.name))
        if first:
            body = field_cmp
            first = false
        else:
            body = expr.call(expr.ident("ord_then"), body, field_cmp)
    return `(impl ord for ~(expr.ident(T.name())):
        def cmp(self, other: &self) -> ordering:
            return ~body)`

#: Real, working deriving show/eq/debug/ord for a concrete, sum-shaped type
#: (`type ... = @a | @b(...) deriving ...`) — the sum-type counterpart of the
#: four struct derivations above, built the same functional-accumulator way
#: over `static for v in T.variants():` instead of `T.fields()`, using the
#: `expr.match_on`/`expr.arm`/`expr.ctor_pattern` AST builders (`match`/`arm`
#: is exactly the statement/match-arm construction the struct derivations'
#: own doc comments note the builders couldn't do yet). Each variant's
#: payload positions are bound to synthesized names (`p0`, `p1`, ... for a
#: `self`-side pattern; `q0`, `q1`, ... for an `other`-side one, so `eq`/
#: `ord` can compare both sides of the same variant without one pattern's
#: bindings shadowing the other's) and referenced generically — `==`,
#: `.show()`, `ord_cmp`, ... dispatch on the payload's own type the same
#: duck-typed way the struct derivations reference `self.<field>`.

#: Generates an impl of show for a sum type, rendering each variant as its
#: name, plus a parenthesized, comma-separated list of its payloads' own
#: `show` output when it has any (`@some(1)` -> "some(1)"; `@none` ->
#: "none").
#: Args:
#:   T: the concrete sum type to generate show for.
#: Returns:
#:   a def_expr representing the full impl block for the show trait.
static def derive_show_sum[T]() -> def_expr:
    var body: expr = expr.match_on(expr.ident("self"))
    static for v in T.variants():
        var arm_body: expr = expr.lit(v.name)
        if v.payload_count > 0:
            arm_body = expr.interp_concat(arm_body, expr.lit("("))
            static for i in 0..v.payload_count:
                if i > 0:
                    arm_body = expr.interp_concat(arm_body, expr.lit(", "))
                arm_body = expr.interp_concat(arm_body, expr.ident("p{i}"))
            arm_body = expr.interp_concat(arm_body, expr.lit(")"))
        body = expr.arm(
            body, expr.ctor_pattern(v.name, v.payload_count, "p"), arm_body)
    return `(impl show for ~(expr.ident(T.name())):
        def show(self) -> str:
            return ~body)`

#: Generates an impl of debug for a sum type. Identical in shape to
#: derive_show_sum, except each payload is rendered with debug formatting
#: (`{:?}` semantics) rather than show, so string payloads render quoted.
#: Args:
#:   T: the concrete sum type to generate debug for.
#: Returns:
#:   a def_expr representing the full impl block for the debug trait.
static def derive_debug_sum[T]() -> def_expr:
    var body: expr = expr.match_on(expr.ident("self"))
    static for v in T.variants():
        var arm_body: expr = expr.lit(v.name)
        if v.payload_count > 0:
            arm_body = expr.interp_concat(arm_body, expr.lit("("))
            static for i in 0..v.payload_count:
                if i > 0:
                    arm_body = expr.interp_concat(arm_body, expr.lit(", "))
                arm_body = expr.interp_concat(
                    arm_body, expr.debug(expr.ident("p{i}")))
            arm_body = expr.interp_concat(arm_body, expr.lit(")"))
        body = expr.arm(
            body, expr.ctor_pattern(v.name, v.payload_count, "p"), arm_body)
    return `(impl debug for ~(expr.ident(T.name())):
        def debug(self) -> str:
            return ~body)`

#: Generates an impl of eq for a sum type: two values are equal exactly when
#: they carry the same variant tag and every payload position compares
#: equal pairwise (a payload-less variant is trivially equal to itself).
#: Built as a match nested inside each outer arm — `self`'s variant selects
#: the outer arm, and a fully exhaustive inner match over every variant
#: (rather than a wildcard fallback) compares payloads when `other` carries
#: the same tag and folds to `false` for every other tag, which is what
#: keeps both matches exhaustive without needing a wildcard-pattern builder.
#: Args:
#:   T: the concrete sum type to generate eq for.
#: Returns:
#:   a def_expr representing the full impl block for the eq trait.
static def derive_eq_sum[T]() -> def_expr:
    var body: expr = expr.match_on(expr.ident("self"))
    static for v in T.variants():
        var inner: expr = expr.match_on(expr.ident("other"))
        static for w in T.variants():
            var arm_body: expr = expr.lit(false)
            if v.name == w.name:
                arm_body = expr.lit(true)
                static for i in 0..v.payload_count:
                    let field_eq: expr = expr.binary(
                        "==", expr.ident("p{i}"), expr.ident("q{i}"))
                    if i == 0:
                        arm_body = field_eq
                    else:
                        arm_body = expr.binary("and", arm_body, field_eq)
            inner = expr.arm(
                inner, expr.ctor_pattern(w.name, w.payload_count, "q"),
                arm_body)
        body = expr.arm(
            body, expr.ctor_pattern(v.name, v.payload_count, "p"), inner)
    return `(impl eq for ~(expr.ident(T.name())):
        def eq(self, other: &self) -> bool:
            return ~body)`

#: Generates an impl of ord for a sum type: variants compare by declaration
#: order first (an earlier variant is `@less` than a later one, matching
#: the same "declaration order is the natural order" rule structs already
#: get for free from `deriving ord`'s field order), and same-variant values
#: fall back to a lexicographic, field-by-field comparison of their
#: payloads via `ord_cmp`/`ord_then` — the same combining functions
#: `derive_ord` (the struct version, above) uses, for the same reason: no
#: builtin scalar recurses through `.cmp()`. Built the same nested-match
#: shape as derive_eq_sum, so the outer/inner matches stay exhaustive
#: without a wildcard-pattern builder.
#: Args:
#:   T: the concrete sum type to generate ord for.
#: Returns:
#:   a def_expr representing the full impl block for the ord trait.
static def derive_ord_sum[T]() -> def_expr:
    var body: expr = expr.match_on(expr.ident("self"))
    var self_index: int32 = 0
    static for v in T.variants():
        var inner: expr = expr.match_on(expr.ident("other"))
        var other_index: int32 = 0
        static for w in T.variants():
            var arm_body: expr = expr.lit(false)
            if v.name == w.name:
                arm_body = expr.call(expr.ident("ord_equal"))
                static for i in 0..v.payload_count:
                    let field_cmp: expr = expr.call(
                        expr.ident("ord_cmp"), expr.ident("p{i}"),
                        expr.ident("q{i}"))
                    if i == 0:
                        arm_body = field_cmp
                    else:
                        arm_body = expr.call(
                            expr.ident("ord_then"), arm_body, field_cmp)
            else:
                if self_index < other_index:
                    arm_body = expr.call(expr.ident("ord_less"))
                else:
                    arm_body = expr.call(expr.ident("ord_greater"))
            inner = expr.arm(
                inner, expr.ctor_pattern(w.name, w.payload_count, "q"),
                arm_body)
            other_index = other_index + 1
        body = expr.arm(
            body, expr.ctor_pattern(v.name, v.payload_count, "p"), inner)
        self_index = self_index + 1
    return `(impl ord for ~(expr.ident(T.name())):
        def cmp(self, other: &self) -> ordering:
            return ~body)`

#: Generates an impl of hash for a struct type: an FNV-1a fold over the
#: fields in declaration order, seeded with `hash_seed()` and combined with
#: `hash_combine`, hashing each field through `hash_value`. All three live in
#: `std.traits` next to `ord_cmp`/`ord_then`, and for the same reasons -- see
#: `derive_ord`'s doc comment.
#: An empty struct hashes to the bare seed, matching the way an empty struct
#: derives `@equal` for `ord` and `true` for `eq`: values carrying no
#: information are indistinguishable to every derived trait alike.
#: `hash_combine` is deliberately non-associative, so the left-nested fold
#: `static for` produces makes field *order* part of the hash -- two structs
#: with the same field values in a different declaration order hash apart.
#: Args:
#:   T: the concrete struct type to generate hash for.
#: Returns:
#:   a def_expr representing the full impl block for the hash trait.
static def derive_hash[T]() -> def_expr:
    var body: expr = expr.call(expr.ident("hash_seed"))
    static for f in T.fields():
        body = expr.call(
            expr.ident("hash_combine"), body,
            expr.call(
                expr.ident("hash_value"),
                expr.field(expr.ident("self"), f.name)))
    return `(impl hash for ~(expr.ident(T.name())):
        def hash(self) -> uint64:
            return ~body)`

#: Generates an impl of hash for a sum type: the variant's declaration index
#: goes in first via `hash_tag`, so two payload-less variants never hash
#: alike, and each payload is then folded in with `hash_combine`/`hash_value`
#: exactly as a struct's fields are.
#: A single `match` on `self` suffices here, unlike `derive_eq_sum`/
#: `derive_ord_sum`'s nested pair of them: hashing reads one value, so there
#: is no `other` whose tag has to be matched against this one's.
#: Args:
#:   T: the concrete sum type to generate hash for.
#: Returns:
#:   a def_expr representing the full impl block for the hash trait.
static def derive_hash_sum[T]() -> def_expr:
    var body: expr = expr.match_on(expr.ident("self"))
    var index: int32 = 0
    static for v in T.variants():
        var arm_body: expr = expr.call(
            expr.ident("hash_tag"), expr.lit(index))
        static for i in 0..v.payload_count:
            arm_body = expr.call(
                expr.ident("hash_combine"), arm_body,
                expr.call(expr.ident("hash_value"), expr.ident("p{i}")))
        body = expr.arm(
            body, expr.ctor_pattern(v.name, v.payload_count, "p"), arm_body)
        index = index + 1
    return `(impl hash for ~(expr.ident(T.name())):
        def hash(self) -> uint64:
            return ~body)`
