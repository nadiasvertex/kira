load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

cc_library(
    name = "hir",
    srcs = [
        "captures.cpp",
        "drop_schedule.cpp",
        "frame_budget.cpp",
        "inline.cpp",
        "link.cpp",
        "live_across_yield.cpp",
        "lower.cpp",
        "tail_calls.cpp",
    ],
    hdrs = [
        "captures.h",
        "drop_schedule.h",
        "frame_budget.h",
        "ids.h",
        "inline.h",
        "link.h",
        "live_across_yield.h",
        "lower.h",
        "nodes.h",
        "tail_calls.h",
        "traversal.h",
    ],
    deps = [
        "//src:intrinsics",
        "//src/parser:parser",
        # `size_of[T]()`/`align_of[T]()` fold here, against the same
        # `runtime::layout_of` both backends read every field offset and
        # element stride from — see `lower_call`'s `layout_queries` branch.
        "//src/runtime:runtime",
        "//src/semantic:semantic",
    ],
    visibility = ["//visibility:public"],
)

cc_test(
    name = "nodes_test",
    srcs = ["nodes_test.cpp"],
    deps = [
        ":hir",
        "//src/parser:parser",
        "//src/semantic:semantic",
        "//src/testing",
    ],
)

cc_test(
    name = "lower_test",
    srcs = ["lower_test.cpp"],
    data = ["//src:std_sources"],
    deps = [
        ":hir",
        "//src/parser:parser",
        "//src/semantic:semantic",
        "//src/testing",
        "//src/testing:stdlib_fixtures",
    ],
)

cc_test(
