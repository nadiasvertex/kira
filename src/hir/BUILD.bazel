load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

cc_library(
    name = "hir",
    srcs = [
        "abi.cpp",
        "captures.cpp",
        "drop_schedule.cpp",
        "frame_budget.cpp",
        "inline.cpp",
        "intrinsic_abi.cpp",
        "link.cpp",
        "live_across_yield.cpp",
        "lower.cpp",
        "reference_check.cpp",
        "storage.cpp",
        "storage_lower.cpp",
        "storage_verify.cpp",
        "tail_calls.cpp",
    ],
    hdrs = [
        "abi.h",
        "captures.h",
        "drop_schedule.h",
        "frame_budget.h",
        "ids.h",
        "inline.h",
        "intrinsic_abi.h",
        "link.h",
        "live_across_yield.h",
        "lower.h",
        "nodes.h",
        "reference_check.h",
        "storage.h",
        "storage_lower.h",
        "storage_verify.h",
        "tail_calls.h",
        "traversal.h",
    ],
    deps = [
        "//src:intrinsics",
        "//src/comptime",
        "//src/parser:parser",
        # `size_of[T]()`/`align_of[T]()` fold here, against the same
        # `runtime::layout_of` both backends read every field offset and
        # element stride from — see `lower_call`'s `layout_queries` branch.
        "//src/runtime:runtime",
        "//src/semantic:semantic",
        "//src/util",
    ],
    visibility = ["//visibility:public"],
)

