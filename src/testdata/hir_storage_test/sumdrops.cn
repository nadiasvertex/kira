module sample

type noisy = { pub id: int32 }

impl drop for noisy:
    def drop(mut self) -> unit:
        return

type slot = @full(noisy) | @vacant

def make_noisy(n: int32) -> noisy:
    return noisy { id: n }

def make_slot(n: int32) -> slot:
    if n > 0:
        return @full(make_noisy(n))
    return @vacant

def make_option(n: int32) -> option[noisy]:
    if n > 0:
        return @some(make_noisy(n))
    return @none

# The scope-end drop of a sum.
def drop_slot(n: int32) -> int32:
    let s = make_slot(n)
    return n

# An arm binds the payload, which leaves the sum.
def take_payload(n: int32) -> int32:
    let s = make_slot(n)
    return match s:
        @full(x) => x.id
        @vacant => 0

# An arm that names no payload keeps the sum.
def peek(n: int32) -> int32:
    let s = make_slot(n)
    return match s:
        @full(_) => 1
        @vacant => 0

def drain(n: int32) -> int32:
    var total: int32 = 0
    var left = n
    while let @some(x) = make_option(left):
        total = total + x.id
        left = left - 1
    return total

def first_or(n: int32) -> int32:
    let @some(x) = make_option(n) else:
        return -5
    return x.id

type duo = @both(noisy, noisy) | @left(noisy) | @nothing

def make_duo(n: int32) -> duo:
    if n > 1:
        return @both(make_noisy(n), make_noisy(n + 1))
    if n > 0:
        return @left(make_noisy(n))
    return @nothing

# Binding one payload leaves the other with the sum.
def first_of(n: int32) -> int32:
    let d = make_duo(n)
    return match d:
        @both(a, _) => a.id
        @left(a) => a.id
        @nothing => 0

def both_of(n: int32) -> int32:
    let d = make_duo(n)
    return match d:
        @both(a, b) => a.id + b.id
        _ => 0

# A parameter that is a sum is dropped by its owner.
def consume(c: slot) -> int32:
    return 1

def pass_on(n: int32) -> int32:
    let s = make_slot(n)
    return consume(s)

def replace(n: int32) -> int32:
    var s = make_slot(n)
    s = make_slot(n + 1)
    return n

# A statement `match` with a wildcard arm.
def statement(n: int32) -> int32:
    var total: int32 = 0
    let s = make_slot(n)
    match s:
        @full(x) =>:
            total = x.id
        _ =>:
            total = -1
    return total

def early(n: int32) -> int32:
    let s = make_slot(n)
    if n > 5:
        return 1
    return match s:
        @full(_) => 2
        @vacant => 3

# Still refused: a test of more than the variant.
def tuple_subject(n: int32) -> int32:
    let t = (make_noisy(n), n)
    return match t:
        (_, 0) => 1
        (_, k) => k

def either(n: int32) -> int32:
    let d = make_duo(n)
    return match d:
        @left(_) | @nothing => 1
        _ => 2

# A pattern that binds nothing.
def count_some(n: int32) -> int32:
    var left = n
    var total: int32 = 0
    while let @some(_) = make_option(left):
        total = total + 1
        left = left - 1
    return total

def has_some(n: int32) -> int32:
    let @some(_) = make_option(n) else:
        return 0
    return 1
