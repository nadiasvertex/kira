module app
use postgres
signature backend:
    type conn
    def connect(url: str) -> conn
trait greet:
    def hello(self) -> int32
module wrap[DB: backend]:
    pub type widget = { pub value: int32 }
    impl greet for widget:
        def hello(self) -> int32:
            return self.value
    extend widget:
        def doubled(self) -> int32:
            return self.value + self.value
    pub def run() -> int32:
        let b = widget { value: 21 }
        return b.hello() + b.doubled()
use wrap[postgres] as w
pub def main() -> int32:
    return w.run()
