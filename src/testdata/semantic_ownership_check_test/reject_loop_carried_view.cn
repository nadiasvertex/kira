module ownership.loop_carried_view

# `s` is re-pointed at `xs` late in the body and read at the top of the next
# iteration, so it is still live when `bump(&mut xs)` runs.
def bump(v: &mut list[int32]) -> int32:
    return v[0]

def demo(n: int32) -> int32:
    var xs = [1, 2, 3, 4]
    var ys = [5, 6]
    var s = ys[0..1]
    var total = 0
    var i = 0
    while i < n:
        total = total + s[0]
        s = xs[0..2]
        total = total + bump(&mut xs)
        i = i + 1
    return total
