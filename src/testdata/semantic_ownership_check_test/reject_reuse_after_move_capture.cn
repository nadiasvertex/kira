module main

# `move [...]` forces every bare entry in the capture list to move rather
# than copy: `name` transfers into the closure at the point `greet` is
# created, so using it again afterward is a use-after-move, the same as any
# other move. The lambda body deliberately never reads `name` itself, so the
# only consuming use in play is the capture list, not a use inside the
# closure body. The captured value is a `list`: a `str` is `copy`, and a
# `copy` value moved into a closure is copied, leaving the original usable.

def main() -> int32:
    let name = [1, 2, 3]
    let greet = move [name] (x: int32) -> int32 => x
    greet(1)
    println("{name.len()}")
    return 0
