module ownership.result_borrows_summarized_argument

def pick(a: &list[int32], b: &list[int32]) -> &int32:
    if b.len() > 5:
        return &a[1]
    return &a[0]

def main() -> int32:
    var a: list[int32] = [1, 2]
    let b: list[int32] = [3]
    let r = pick(&a, &b)
    a.push(4)
    return *r
