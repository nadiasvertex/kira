module ownership.repeated_autoref_function_value_calls

# A bare argument to a `&` parameter of a function value is lent, not
# moved, as it is for a named function, so it can be lent again.
def sum(v: &list[int32]) -> int32:
    return v[0]

def demo() -> int32:
    let f = sum
    var xs = [1, 2, 3]
    let a = f(xs)
    let b = f(xs)
    return a + b
