module ownership.spliced_impl_moves_out_of_self

# An impl made by an item-level splice is ownership-checked like a written
# one: its `take` cannot move the field `inner` out of `self` (todo 23).

trait taker:
    def take(self) -> list[int32]

type pack = { inner: list[int32] }

static def make_impl() -> def_expr:
    return `(impl taker for pack:
        def take(self) -> list[int32]:
            return self.inner)`

~make_impl()

def main() -> int32:
    let p = pack { inner: [1, 2, 3] }
    return p.take().len() as int32
