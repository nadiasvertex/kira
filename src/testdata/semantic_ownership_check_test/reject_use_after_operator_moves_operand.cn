module ownership.use_after_operator_moves_operand

# An overloaded operator calls its trait method, whose `other` parameter takes
# the right operand by value. A non-`copy` struct on the right is moved, so
# using it again is a use after move. The left operand is the `self` receiver,
# which is only borrowed.
type vec2 = { x: int32, y: int32 }

impl add for vec2:
    type output = vec2
    def add(self, other: self) -> self.output:
        return vec2 { x: self.x + other.x, y: self.y + other.y }

def demo() -> int32:
    let a = vec2 { x: 1, y: 2 }
    let b = vec2 { x: 3, y: 4 }
    let sum = a + b
    let again = a + b
    return sum.x + again.y
