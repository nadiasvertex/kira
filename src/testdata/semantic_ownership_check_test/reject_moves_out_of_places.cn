module main

# Moving out of places (ch. 14): moving a non-`copy` value out of an
# element, out of a dereference, out of a field of a borrowed `self`, or out
# of a field of a type with its own `drop` is rejected; so is using a local
# as a whole after one of its fields was moved out, and filling an array with
# a value that is not `copy`.

type res = { id: int32 }

impl drop for res:
    def drop(mut self) -> unit:
        println("drop {self.id}")

type guarded = { inner: list[int32] }

impl drop for guarded:
    def drop(mut self) -> unit:
        println("guarded")

type job = { name: str, output: list[int32] }

type holder = { items: list[int32] }

extend holder:
    def steal(self) -> list[int32]:
        return self.items

def first(xs: &list[list[int32]]) -> list[int32]:
    return xs[0]

def deref(r: &list[int32]) -> list[int32]:
    return *r

def from_drop(g: guarded) -> list[int32]:
    return g.inner

def whole_after_part(j: job) -> job:
    let out = j.output
    return j

def fill() -> array[list[int32], 3]:
    return [[1]; 3]

def main() -> int32:
    return 0
