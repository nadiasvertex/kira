module ownership.generic_method_moves_out_of_self

# The rule holds in a generic body too: `T` may not be `copy`, so `grab`
# cannot move the payload out of `self` (ch. 14, todo 16).

type tok = { n: int32 }

impl drop for tok:
    def drop(mut self):
        let _ = 0

type holder[T] = @full(T) | @empty

extend[T] holder[T]:
    def grab(self, d: T) -> T:
        return match self:
            @full(v) => v
            @empty => d

def main() -> int32:
    let h: holder[tok] = @full(tok { n: 5 })
    let t = h.grab(tok { n: 1 })
    return t.n
