module ownership.method_moves_out_of_self

# `self` is a reference to the receiver, so a method cannot move a part that
# is not `copy` out of it: the caller still owns the value and drops it
# (ch. 14, todo 16).

type tok = { n: int32 }

impl drop for tok:
    def drop(mut self):
        let _ = 0

type holder = @full(tok) | @empty

extend holder:
    def grab(self) -> tok:
        return match self:
            @full(v) => v
            @empty => tok { n: 0 }

def main() -> int32:
    let h = @full(tok { n: 5 })
    let t = h.grab()
    return t.n
