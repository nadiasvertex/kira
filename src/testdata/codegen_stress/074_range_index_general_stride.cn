module codegen_stress.range_index_general_stride

# `compile_range_index` (both backends) used to compute a sliced view's data
# pointer as `data + start` — correct only for a 1-byte-stride source
# (`str`/`array[byte, N]`). Slicing an `array[int32, N]`/`list[int32]` into a
# `slice_mut[int32]` silently addressed `start` *bytes* in, not `start`
# *elements* in — 3 bytes short of element 3 in a 4-byte-stride array, which
# would still often read/write neighboring bytes without crashing. This is
# exactly the kind of shared-stride bug `# expect:` exists for: both tiers
# computing the same wrong address would still agree with each other.
#
# `bump_all` writes through a `&mut slice_mut[int32]` formed by
# range-indexing both an `array[int32, 4]` and a `list[int32]` — each
# element bumped by 1, twice (once per call). Then a `slice[int32]` (an
# immutable range-index) is read back to confirm the *read* side scales the
# same way the *write* side does.
#
# array: [1,2,3,4] -> bump -> bump -> [3,4,5,6], sum = 18
# list:  [10,20,30,40] -> bump -> bump -> [12,22,32,42], sum = 108
# slice[int32] read-back of xs[1..3]: 22 + 32 = 54
# total = 18 + 108 + 54 = 180

# expect: 180

def bump_all(buf: &mut slice_mut[int32]) -> unit:
    var i: usize = 0
    while i < buf.len():
        buf[i] = buf[i] + 1
        i = i + 1

def sum_view(buf: &slice[int32]) -> int32:
    var total = 0
    var i: usize = 0
    while i < buf.len():
        total = total + buf[i]
        i = i + 1
    return total

def main() -> int32:
    var arr: array[int32, 4] = [1, 2, 3, 4]
    bump_all(&mut arr[0..4])
    bump_all(&mut arr[0..4])

    var xs: list[int32] = [10, 20, 30, 40]
    bump_all(&mut xs[0..4])
    bump_all(&mut xs[0..4])

    let readback = sum_view(&xs[1..3])

    return (arr[0] + arr[1] + arr[2] + arr[3]) + (xs[0] + xs[1] + xs[2] + xs[3]) + readback
