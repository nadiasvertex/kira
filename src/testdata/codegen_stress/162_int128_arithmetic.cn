module codegen_stress.int128_arithmetic

# `int128`/`uint128` arithmetic, bitwise operations, comparisons, and casts,
# with operands past what 64 bits can hold. Each result is reduced modulo a
# prime that depends on every bit of it, then weighted by its position, so a
# tier that computes in 64 bits, loses the high half, or swaps two results
# produces a different checksum. The two tiers share no 128-bit code, but a
# wrong literal or cast convention could still be shared, so the value is
# declared and was computed independently.

def term(v: uint128) -> int64:
    return (v % 1000003) as int64

def signed_term(v: int128) -> int64:
    return term(v as uint128)

def main() -> int64:
    let a: int128 = 170141183460469231731687303715884105727
    let b: int128 = 55340232221128654853
    let g: uint128 = 340282366920938463463374607431768211455
    let h = g >> 3
    let one: uint128 = 1
    var total: int64 = 0
    total = total + 1 * signed_term(a / b)
    total = total + 2 * signed_term(a % b)
    total = total + 3 * signed_term(b * 1000000007)
    total = total + 4 * signed_term(-b)
    total = total + 5 * signed_term(-a - 1)
    total = total + 6 * term(h)
    total = total + 7 * term(one << 100)
    total = total + 8 * term(h & 0xffff0000ffff0000ffff0000ffff0000)
    total = total + 9 * term(h ^ (one << 127))
    total = total + 10 * term(g - h + 12345)
    total = total + 11 * signed_term(-b / 7)
    total = total + 12 * signed_term(-b % 7)
    total = total + 13 * signed_term((-a) >> 70)
    total = total + 14 * term((-5 as int128) as uint128)
    total = total + 15 * (b as int64)
    total = total + 16 * signed_term((b as float64) as int128)
    total = total + 17 * signed_term(1.0e30 as int128)
    total = total + 18 * term((-1 as int64) as uint128)
    total = total + 19 * term((-1 as int64) as uint64 as uint128)
    if b < a and -b < b and g > h and not (a == b):
        total = total + 1000000000
    return total

# expect: 1049969096
