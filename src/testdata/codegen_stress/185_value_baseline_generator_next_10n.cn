module codegen_stress.value_baseline_generator_next_10n

# expect: 49995000

# Ten times the length of `184_value_baseline_generator_next_n.cn`; see that
# file. The generator yields 0..9999, which sum to 9999 * 10000 / 2 = 49995000.

generator def count(n: int32) -> some iterator[int32]:
    var i: int32 = 0
    while i < n:
        yield i
        i = i + 1

def main() -> int32:
    var g = count(10000)
    var total: int32 = 0
    var running = true
    while running:
        match g.next():
            @some(v) =>:
                total = total + v
            @none =>:
                running = false
    return total
