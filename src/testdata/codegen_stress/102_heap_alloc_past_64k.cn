module codegen_stress.heap_alloc_past_64k

# Heap blocks past the old 64 KiB bytecode cap (`op_alloc`'s byte size was a
# 16-bit immediate). `# expect:` rather than agreement alone: a truncated size
# or a misplaced element would read the same wrong bytes on both tiers.
#
#  - `filled`: `[x; N]` past 64 elements is a runtime loop, not unrolled
#    stores; read at both ends, at two element widths.
#  - `SPREAD`: a reified static is always an explicit element list (the
#    comptime evaluator expands the fill), so this is 160000 bytes of
#    unrolled stores. `op_store_slot`'s offset is still 16 bits, so the
#    stores rebase every 64 KiB.
#  - `listed`: an explicit local literal whose elements straddle the first
#    rebase (element 8191 is the first past a 16-bit offset for int64).

static SPREAD: array[int64, 20000] = [5; 20000]

def filled() -> int64:
    let wide: array[int64, 100000] = [7; 100000]
    let narrow: array[int32, 70000] = [9; 70000]
    return wide[0] + wide[99999] + int64(narrow[0] + narrow[69999])

def spread() -> int64:
    return SPREAD[0] + SPREAD[8191] + SPREAD[19999]

