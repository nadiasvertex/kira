module codegen_stress.value_param_solving

# expect: 0

# How a call solves the callee's value parameters from its arguments' types.
# Each case returns what the callee saw its `n` to be, so a wrong solution is
# a wrong number, not a compile failure. `main` returns 0 when every case
# holds, and otherwise `case * 100 + actual` for the first one that doesn't.

type index[n: usize] = usize where self < n

def cap[n: usize](v: array[int32, n]) -> int32:
    return n as int32

def cap_ref[n: usize](v: &array[int32, n]) -> int32:
    return n as int32

# An offset in the pattern: `n + 1` against `4` solves `n := 3`.
def pred_len[n: usize](v: array[int32, n + 1]) -> int32:
    return n as int32

# The callee's `n` answered by the caller's own `m`, symbolically, and fixed
# only when `outer_same` is instantiated.
def outer_same[m: usize](v: array[int32, m]) -> int32:
    return cap(v) * 10 + (m as int32)

# `n := m + 1`.
def outer_plus[m: usize](v: array[int32, m + 1]) -> int32:
    return cap(v) * 10 + (m as int32)

# `n := m - 1`: not provably non-negative in the template, a plain number in
# each instance.
def outer_minus[m: usize](v: array[int32, m]) -> int32:
    return pred_len(v) * 10 + (m as int32)

# Callee and caller both spell it `n`, and the two agree: `n + 1 ~ n + 1`.
def outer_spelled[n: usize](v: array[int32, n + 1]) -> int32:
    return pred_len(v) * 10 + (n as int32)

# Two unknowns, each pinned by its own argument.
def both[m: usize, n: usize](a: array[int32, m], b: array[int32, n]) -> int32:
    return (m as int32) * 10 + (n as int32)

# A refinement written in the callee's `n`, discharged under `n := m + 1`:
# `0 < m + 1` holds for every `m`.
def safe_get[n: usize](v: array[int32, n], i: index[n]) -> int32:
    return v[i]

def first[m: usize](v: array[int32, m + 1]) -> int32:
    return safe_get(v, 0)

# Callee and caller both spell it `n`, and they are two parameters: the
# callee's `n` solves to the caller's `n + 1`, not to a contradiction.
def shifted[n: usize](v: array[int32, n + 1]) -> int32:
    return cap(v) * 10 + (n as int32)

# The same, with the callee's `n` reaching a refinement: `0 < n + 1`.
def first_shifted[n: usize](v: array[int32, n + 1]) -> int32:
    return safe_get(v, 0)

# Brackets fix `m`, which turns the underdetermined `m + n = 5` into
# `3 + n = 5`.
def split[m: usize, n: usize](v: array[int32, m + n]) -> int32:
    return (m as int32) * 10 + (n as int32)

# The same, with the rest answered by the caller's own `k`: `2 + n = k + 2`
# solves `n := k`.
def split_outer[k: usize](v: array[int32, k + 2]) -> int32:
    return split[2](v)

def check(case: int32, actual: int32, expected: int32) -> int32:
    if actual == expected:
        return 0
    return case * 100 + actual

def main() -> int32:
    # An array is not implicitly copied, so every by-value call gets its own.
    let a1: array[int32, 3] = [7, 8, 9]
    let a2: array[int32, 4] = [1, 2, 3, 4]
    let a3: array[int32, 3] = [7, 8, 9]
    let a4: array[int32, 3] = [7, 8, 9]
    let a5: array[int32, 3] = [7, 8, 9]
    let a6: array[int32, 3] = [7, 8, 9]
    let a7: array[int32, 3] = [7, 8, 9]
    let two: array[int32, 2] = [1, 2]
    let five: array[int32, 5] = [1, 2, 3, 4, 5]
    let a9: array[int32, 3] = [7, 8, 9]
    let a10: array[int32, 3] = [7, 8, 9]
    let a11: array[int32, 3] = [7, 8, 9]
    let a12: array[int32, 5] = [1, 2, 3, 4, 5]
    let a13: array[int32, 5] = [1, 2, 3, 4, 5]

    var failed = check(1, cap(a1), 3)
    if failed == 0:
        failed = check(2, pred_len(a2), 3)
    if failed == 0:
        failed = check(3, outer_same(a3), 33)
    if failed == 0:
        failed = check(4, outer_plus(a4), 32)
    if failed == 0:
        failed = check(5, outer_minus(a5), 23)
    if failed == 0:
        failed = check(6, outer_spelled(a6), 22)
    if failed == 0:
        failed = check(7, cap_ref(&a7) * 10 + cap_ref(a7), 33)
    if failed == 0:
        failed = check(8, both(two, five), 25)
    if failed == 0:
        failed = check(9, first(a9), 7)
    if failed == 0:
        failed = check(10, shifted(a10), 32)
    if failed == 0:
        failed = check(11, first_shifted(a11), 7)
    if failed == 0:
        failed = check(12, split[3](a12), 32)
    if failed == 0:
        failed = check(13, split_outer(a13), 23)
    return failed
