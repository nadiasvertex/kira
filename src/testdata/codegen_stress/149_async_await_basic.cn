module codegen_stress.async_await_basic

# expect: 56

# An `async def` call is an inert task until awaited; `await` runs it to
# completion and unwraps its result. The entry `async def main` awaits tasks
# that themselves await other tasks, with a loop and a local living in the
# task's state.

async def double(x: int32) -> int32:
    return x * 2

async def sum_doubles(n: int32) -> int32:
    var total: int32 = 0
    var i: int32 = 0
    while i < n:
        total = total + await double(i)
        i = i + 1
    return total

async def main() -> int32:
    let a = sum_doubles(5)
    let b = await sum_doubles(6)
    let c = await a
    return c + b + 6
