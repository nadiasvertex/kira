module codegen_stress.invariant_write_through_mut_ref

# expect-panic: invariant violated

# A type invariant is checked after a field write made through a `&mut`
# parameter, as after any field write (chapter 34). Todo 40.

type pos = { pub value: int32 }
    invariant self.value > 0

def opaque(x: int32) -> int32:
    return x

def poke(p: &mut pos, v: int32) -> unit:
    p.value = v

def main() -> int32:
    var p = pos{value: opaque(1)}
    poke(&mut p, opaque(0))
    return p.value
