module codegen_stress.invariant_write_in_mut_self_method

# expect-panic: invariant violated

# A type invariant is checked after a field write made through `mut self`, as
# after any field write (chapter 34). Todo 40.

type pos = { pub value: int32 }
    invariant self.value > 0

def opaque(x: int32) -> int32:
    return x

extend pos:
    def set(mut self, v: int32) -> unit:
        self.value = v

def main() -> int32:
    var p = pos{value: opaque(1)}
    p.set(opaque(0))
    return p.value
