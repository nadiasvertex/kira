module codegen_stress.range_patterns

# Each bound form of a range pattern, at both edges of each range.
def classify(n: int32) -> int32:
    match n:
        ..0 => return 1
        0..5 => return 2
        5..=9 => return 3
        100.. => return 4
        _ => return 5

def main() -> int32:
    var total = 0
    total = total * 10 + classify(-3)
    total = total * 10 + classify(0)
    total = total * 10 + classify(4)
    total = total * 10 + classify(5)
    total = total * 10 + classify(9)
    total = total * 10 + classify(10)
    total = total * 10 + classify(100)
    return total

# expect: 1223354
