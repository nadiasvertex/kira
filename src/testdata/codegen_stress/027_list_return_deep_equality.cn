module codegen_stress.list_return_deep_equality

def squares(n: int32) -> list[int32]:
    return for x in 0..n => x * x

def main() -> list[int32]:
    return squares(6)

# The returned list owns its backing block, which is still live when
# `main` returns.
# max-live-blocks: 1

# expect-text: [0, 1, 4, 9, 16, 25]
