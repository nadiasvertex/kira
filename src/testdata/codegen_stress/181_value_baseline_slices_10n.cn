module codegen_stress.value_baseline_slices_10n

# expect: 134988

# Ten times the length of `180_value_baseline_slices_n.cn`; see that file.
# 10000 passes are 1666 whole cycles of 81 and four more starts:
# 1666 * 81 + 42 = 134988.

def window_sum(xs: &slice[int32]) -> int32:
    return xs[0] + xs[1] + xs[2]

def main() -> int32:
    var data: array[int32, 8] = [1, 2, 3, 4, 5, 6, 7, 8]
    var total: int32 = 0
    var i: int32 = 0
    while i < 10000:
        let start = (i % 6) as usize
        total = total + window_sum(&data[start..start + 3])
        i = i + 1
    return total
