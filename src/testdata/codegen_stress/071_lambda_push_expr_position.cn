module codegen_stress.lambda_push_expr_position

# `list.push` used in *value* position rather than as a bare statement — an
# expression-bodied lambda whose entire body is a push. An expression-bodied
# lambda's tail always lowers through `lower_expr` (`hir::lowerer::
# lower_lambda` wraps it in a `hir_return`), so the `unit`-returning
# `list.push` method (`src/std/list.cn`) must work as a value there too.

def main() -> int64:
    var seen: list[int32] = []
    let push_doubled = (x: int32) => seen.push(x * 2)
    push_doubled(1)
    push_doubled(2)
    push_doubled(3)
    return seen.len() as int64

# expect: 3
