module codegen_stress.bare_generic_static_call

# A static (no-`self`) method of a generic `extend[T] example_type[T]:` block, called
# through the bare type name (spec/todo.md item 12). `example_type.make(40)` has to
# solve `T` from the argument; before the fix the call type-checked against the
# uninstantiated template and lowering reported "call to `example_type::make` could
# not be resolved to a function in this compiled module".
#
# Exercised from plain code, from a generic free function (where `T` is only
# known per instance), from a method body inside the block itself, and at two
# different instantiations so one shared instance cannot satisfy both.
# expect: 4213

type example_type[T] = { v: T }

extend[T] example_type[T]:
    def make(v: T) -> example_type[T]:
        return example_type { v: v }

    def get(self) -> T:
        return self.v

    def again(self) -> example_type[T]:
        return example_type.make(self.v)

def wrap[U](u: U) -> example_type[U]:
    return example_type.make(u)

def main() -> int32:
    let a = example_type.make(4)
    let b = wrap(2)
    let c = example_type.make(1).again()
    let flag = example_type.make(true)
    var total = a.get() * 1000 + b.get() * 100 + c.get() * 10
    if flag.get():
        total = total + 3
    return total
