module codegen_stress.drop_through_deref

# A method call through a `deref` field in a `drop` body (todo item 63).
# Compile-time code in a generic std function used to check this impl
# early with that template still current, so the `deref` step was never
# recorded and the drop updated the `shared` itself.

# expect: 1

use std.shared.shared
use std.sync.atomic

type guard = { c: shared[atomic[int32]] }

impl drop for guard:
    def drop(mut self):
        let _ = self.c.fetch_add(1)

def main() -> int32:
    let c = shared[atomic[int32]].new(atomic.new(0))
    let g = guard { c: c.clone() }
    drop(g)
    return c.load()
