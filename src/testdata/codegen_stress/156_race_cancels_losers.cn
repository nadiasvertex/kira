module codegen_stress.race_cancels_losers

# expect: 7

# `await race:` cancels the branches that did not win. The loser waits on a
# long `on(cpu)` body and would add to the shared counter once it resumed;
# the cancel arrives while it waits, so it must return without adding.
# `main` then spins for several times as long as the loser does, so a loser
# that was not cancelled has added to the counter before it is read.

use std.mem.{alloc, atomic_fetch_add}
use std.shared.shared

type counter = {
    cell: *mut usize,
}

extend counter:
    machine def make() -> counter:
        return counter { cell: alloc[usize](1) }

    machine def add_one(self) -> unit:
        let _ = atomic_fetch_add(self.cell, 1)

    machine def total(self) -> usize:
        return self.cell[0]

async def quick() -> int32:
    return 7

async def slow(c: shared[counter]) -> int32:
    let spun = await on(cpu):
        var i: int64 = 0
        while i < 200000:
            i = i + 1
        1
    c.add_one()
    return spun

async def main() -> int32:
    let c = shared[counter].new(counter.make())
    let winner = await race:
        quick()
        slow(c.clone())
    let _ = await on(cpu):
        var i: int64 = 0
        while i < 2000000:
            i = i + 1
        1
    return winner + (c.total() as int32) * 100
