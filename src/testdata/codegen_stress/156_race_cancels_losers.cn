module codegen_stress.race_cancels_losers

# expect: 7

# `await race:` cancels the branches that did not win. The loser waits on a
# channel that nothing sends to while the race runs, so the cancel always
# finds it waiting; once it resumed it would add to the shared counter. After
# the race `main` drops the last sender, which would wake a loser that was not
# cancelled, then spins for long enough that such a loser has added to the
# counter before it is read.

use std.mem.{alloc, atomic_fetch_add}
use std.shared.shared
use std.sync.{channel, receiver}
use std.traits.drop

type counter = {
    cell: *mut usize,
}

# The cell is only touched through atomics, so tasks may share the counter.
impl send for counter:

impl share for counter:

extend counter:
    machine def make() -> counter:
        return counter { cell: alloc[usize](1) }

    machine def add_one(self) -> unit:
        let _ = atomic_fetch_add(self.cell, 1)

    machine def total(self) -> usize:
        return self.cell[0]

async def quick() -> int32:
    return 7

async def slow(c: shared[counter], rx: receiver[int32]) -> int32:
    let _ = await rx.recv()
    c.add_one()
    return 1

async def main() -> int32:
    let c = shared[counter].new(counter.make())
    let (tx, rx) = channel[int32](1)
    let winner = await race:
        quick()
        slow(c.clone(), rx)
    drop(tx)
    let _ = await on(cpu):
        var i: int64 = 0
        while i < 2000000:
            i = i + 1
        1
    return winner + (c.total() as int32) * 100
