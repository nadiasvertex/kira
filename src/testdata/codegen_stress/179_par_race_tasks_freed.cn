module codegen_stress.par_race_tasks_freed

# expect: 0
# max-live-blocks: 2100
# storage-max-live-blocks: 0
# storage-max-allocations: 7000

# `await par:` and `await race:` drop their branch tasks once the result is
# read, inside a task and in the entry function. Each pass of the loop makes
# seven tasks of two heap blocks each (the coroutine object and its state
# block), 7000 over 500 passes. In the storage form those are the only
# blocks: the tuples that hold each group's tasks and the one `par` returns
# are inline values, so nothing else is allocated and nothing is left behind.
# The pointer form's `max-live-blocks` still allows the four tuple shells per
# pass it never frees.

async def plus_one(x: int32) -> int32:
    return x + 1

async def in_task(i: int32) -> int32:
    let (a, b) = await par:
        plus_one(i)
        plus_one(i)
    let c = await race:
        plus_one(i)
        plus_one(i)
    return a + b + c - 3 * i - 3

async def main() -> int32:
    var bad: int32 = 0
    var i: int32 = 0
    while i < 500:
        let off = await in_task(i)
        let c = await race:
            plus_one(i)
            plus_one(i)
        if off != 0 or c != i + 1:
            bad = bad + 1
        i = i + 1
    return bad
