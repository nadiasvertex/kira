module codegen_stress.wide_literal_conversion

# A conversion's argument built only from literals is typed at the conversion's
# target, as under an annotated `let` (spec/todo.md item 14). Before, the
# literals took the `int32` default and `int64(4294967296)` was rejected as too
# large. Every wide value is outside `int32` range, and `float64(7 / 2)` is 3.5
# rather than integer division's 3, so a result computed at the default types
# cannot produce the expected total.
# expect: 61

def main() -> int32:
    let v = int64(4294967338)
    let n = int64(-4294967296)
    let u = uint64(18446744073709551615)
    let d = int64(4294967296 * 2)
    let h = int64(1 << 40)
    let f = float64(7 / 2)
    let m = int64(-(4294967296 + 1))
    let a = int32(v - int64(4294967296))
    let b = int32(n + int64(4294967298))
    let c = int32(u - uint64(18446744073709551614))
    let e = int32(d - int64(8589934590))
    let k = int32(h >> int64(38))
    let g = int32(f * 2.0)
    let p = int32(m + int64(4294967300))
    return a + b + c + e + k + g + p
