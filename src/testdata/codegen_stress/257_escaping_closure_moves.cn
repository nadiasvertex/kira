module codegen_stress.escaping_closure_moves

# expect: 39
# max-live-blocks: 0

# A closure without a capture list borrows what it uses, unless it escapes
# (chapter 16). Each closure here escapes: `make` returns one, and `keep`
# stores one in a variable that outlives the block of the list it uses. So
# each moves its list in with no `move` keyword, and drops it when the
# closure is dropped. A closure that borrows would read a dropped list.

def make(n: int32) -> fn() -> int32:
    let xs: list[int32] = [n, n + 1, n + 2]
    return () => xs[0] + xs[1] + xs[2]

def keep() -> int32:
    var f: fn() -> int32 = () => 0
    if true:
        let ys: list[int32] = [4, 5, 6]
        f = () => ys[0] + ys[1] + ys[2]
    return f()

def main() -> int32:
    var total: int32 = 0
    var i: int32 = 0
    while i < 2:
        let f = make(i)
        total = total + f()
        i = i + 1
    return total + keep() + 15
