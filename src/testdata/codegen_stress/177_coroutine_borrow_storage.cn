module codegen_stress.coroutine_borrow_storage

# expect: 1000007
# max-allocations: 100
# storage-max-live-blocks: 0
# storage-max-allocations: 2

# A coroutine keeps what a borrow points at where a suspension does not reach.
# That storage belongs to the coroutine, so a borrow taken on every pass of a
# loop reuses it instead of allocating more: a borrowed temporary (`i * 2`)
# and a borrowed local declared inside the loop (`step`). Both used to get a
# fresh heap block on every pass that nothing freed, so this loop allocated at
# least twice per iteration. `max-allocations` bounds the heap blocks `main`
# allocates, which a per-iteration allocation exceeds. The borrowed slices
# `xs[0..2]` and `xs[1..3]` are outside the loop, because the pointer form
# allocates a slice header on the heap. In the storage form a slice is an
# inline descriptor, so the generator's object and state block are the only
# two blocks `main` allocates.

def sum_view(xs: &slice[int32]) -> int32:
    return xs[0] + xs[1]

def read_through(r: &int32) -> int32:
    return *r

generator def sums(n: int32) -> some iterator[int32]:
    var xs: array[int32, 3] = [1, 2, 3]
    var i: int32 = 0
    var acc: int32 = sum_view(&xs[0..2])
    while i < n:
        let step = i % 3
        acc = acc + read_through(&(i * 2)) + read_through(&step)
        i = i + 1
    yield acc
    yield sum_view(&xs[1..3])

def take(g: &mut generator[int32]) -> int32:
    match g.next():
        @some(v) => return v
        @none => return -1

def main() -> int32:
    var g = sums(1000)
    let a = take(&mut g)
    let b = take(&mut g)
    return a + b
