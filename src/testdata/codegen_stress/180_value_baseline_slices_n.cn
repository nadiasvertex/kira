module codegen_stress.value_baseline_slices_n

# expect: 13488

# Baseline for the value-semantics migration (`spec/value-semantics.md`, T-01).
# Slicing a local array on every pass of a loop and passing the view to a
# function. Only the result is checked, not allocations: slice headers are
# still heap blocks, and the bound is tightened in T-13. `181_..._10n.cn` is the
# same program at ten times the length, so per-iteration growth shows up as a
# tenfold difference in `CINDER_STRESS_REPORT=1` output.
#
# Window `start` holds data[start..start + 3], which sums to 3 * start + 6.
# Starts cycle 0..5, giving 6 + 9 + 12 + 15 + 18 + 21 = 81 per cycle of six.
# 1000 passes are 166 whole cycles and four more starts: 166 * 81 + 42 = 13488.

def window_sum(xs: &slice[int32]) -> int32:
    return xs[0] + xs[1] + xs[2]

def main() -> int32:
    var data: array[int32, 8] = [1, 2, 3, 4, 5, 6, 7, 8]
    var total: int32 = 0
    var i: int32 = 0
    while i < 1000:
        let start = (i % 6) as usize
        total = total + window_sum(&data[start..start + 3])
        i = i + 1
    return total
