module codegen_stress.list_of_tuples_return_deep_equality

def pairs(n: int32) -> list[(int32, int32)]:
    return for x in 0..n => (x, x * x)

def main() -> list[(int32, int32)]:
    return pairs(5)

# The returned list owns its backing block, which is still live when
# `main` returns.
# max-live-blocks: 1

# expect-text: [(0, 0), (1, 1), (2, 4), (3, 9), (4, 16)]
