module codegen_stress.tuple_member_drops

# expect: 4450
# max-live-blocks: 0

# An owned tuple drops each member it still holds, in position order, when it
# goes out of scope: a local, a call's result, a by-value parameter, a struct
# field, and a tuple nested in a tuple. A member moved out (`u.0`) is skipped
# and the rest still drop; a `_` in a destructuring `let` drops what it skips.
# Every pass of the loop builds fresh lists, so a member that is never dropped
# leaves blocks behind each time.

type holder = {
    tag: int64,
    parts: (list[int64], list[int64]),
}

def one(n: int64) -> list[int64]:
    var out = list[int64].new()
    out.push(n)
    return out

def pair(a: int64, b: int64) -> (list[int64], list[int64]):
    return (one(a), one(b))

def total(xs: (list[int64], list[int64])) -> int64:
    return xs.0[0] + xs.1[0]

def pass() -> int64:
    let t = (one(1), one(2))
    let first = t.0[0] + t.1[0]
    let u = pair(3, 4)
    let a = u.0
    let second = a[0] + u.1[0]
    let (b, _) = pair(5, 6)
    let third = b[0]
    let sum = total((one(7), one(8)))
    let h = holder{tag: 9, parts: (one(10), one(11))}
    let n = ((one(12), 13), one(14))
    return first + second + third + sum + h.tag + h.parts.1[0] + n.0.0[0] + n.0.1 + n.1[0]

def main() -> int64:
    var out: int64 = 0
    var i: int64 = 0
    while i < 50:
        out = out + pass()
        i = i + 1
    return out
