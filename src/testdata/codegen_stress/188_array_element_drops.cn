module codegen_stress.array_element_drops

# expect: 2150
# max-live-blocks: 0
# An element that is never dropped leaves 12 blocks a pass.

# An owned array drops each element it still holds, in index order, when it
# goes out of scope: a local, a by-value parameter, a struct field, and an
# array of arrays. An array moved to a callee is dropped there, not twice.
# `list.from_array` takes each element out of its argument and then gives up
# the argument without dropping it. Every pass of the loop builds fresh
# lists, so an array that is never dropped leaves blocks behind each time.

type holder = {
    tag: int64,
    parts: array[list[int64], 2],
}

def one(n: int64) -> list[int64]:
    var out = list[int64].new()
    out.push(n)
    return out

def total(xs: array[list[int64], 2]) -> int64:
    return xs[0][0] + xs[1][0]

def ignore(xs: array[list[int64], 2]) -> unit:
    return

def pass() -> int64:
    let local: array[list[int64], 2] = [one(1), one(2)]
    let first = local[0][0]
    let moved: array[list[int64], 2] = [one(3), one(4)]
    let sum = total(moved)
    ignore([one(5), one(6)])
    let h = holder{tag: 7, parts: [one(8), one(9)]}
    let grid: array[array[list[int64], 2], 2] = [[one(10), one(11)], [one(12), one(13)]]
    let nested: list[list[int64]] = [one(14), one(15)]
    return first + sum + h.tag + grid[1][1][0] + nested[1][0]

def main() -> int64:
    var out: int64 = 0
    var i: int64 = 0
    while i < 50:
        out = out + pass()
        i = i + 1
    return out
