module accept_on_io_sendable

# Sendable values cross into an `on(io)` task: an owned value moved in, an
# immutable value read through a shared borrow, and state behind a mutex.

use std.sync.{mutex}

type point = { x: int32, y: int32 }

def take(p: point) -> int32:
    return p.x

def look(p: &point) -> int32:
    return p.y

async def bump(m: &mutex[int32]) -> int32:
    return 1

async def owned() -> int32:
    let p = point { x: 1, y: 2 }
    return await on(io):
        take(p)

async def borrowed() -> int32:
    let p = point { x: 1, y: 2 }
    return await on(io):
        look(&p)

async def synchronized() -> int32:
    let m = mutex.new(0)
    return await on(io, bump(&m))

async def main() -> int32:
    return (await owned()) + (await borrowed()) + (await synchronized())
