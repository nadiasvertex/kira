module main

signature backend:
    type conn
    def connect(url: str) -> conn

module postgres:
    pub type conn = int32
    pub def connect(url: str) -> conn:
        0

trait greet:
    def hello(self) -> int32

module wrap[DB: backend]:
    pub type widget = { value: int32 }
    impl greet for widget:
        def hello(self) -> int32:
            self.value
    extend widget:
        def doubled(self) -> int32:
            self.value + self.value
    pub def run() -> int32:
        let b = widget { value: 21 }
        b.hello() + b.doubled()

use main.wrap[main.postgres] as w

def go() -> int32:
    w.run()
