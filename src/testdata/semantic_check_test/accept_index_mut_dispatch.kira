module sample

# `&mut v[i]` on a user type implementing `index_mut` dispatches to `at_mut`
# rather than `index`'s `at` -- the two share syntax (`v[i]`) up to the
# enclosing `&mut`, which is what selects between them.
#
# `at_mut`'s body cannot yet construct the `cell_mut[T]` it returns (`cell`/
# `cell_mut` have no runtime representation on either backend -- see
# spec/todo.md item 19), so it is left as `panic(...)`, whose `never` return
# type unifies with anything. That is enough to exercise the *checker's*
# dispatch and type resolution, which is what this fixture is for.

type writable = { a: int32 }

impl index[usize] for writable:
    type output = int32
    def at(self, i: usize) -> int32:
        return self.a

impl index_mut[usize] for writable:
    def at_mut(mut self, i: usize) -> mut cell[self.output]:
        panic("cell construction is not implemented yet")

def borrow_it(mut w: writable) -> unit:
    let c = &mut w[0]
