module sample
type point = { x: float64 }
trait same:
    def same(self, other: &self) -> bool
trait grow:
    def grow(mut self) -> unit
trait take[U]:
    def take(self, value: &U) -> U
impl same for point:
    def same(self, other: &point) -> bool:
        return self.x == other.x
impl grow for point:
    def grow(mut self) -> unit:
        self.x = self.x + 1.0
impl take[int64] for point:
    def take(self, value: &int64) -> int64:
        return *value
