module main

signature backend:
    type conn
    def connect(url: str) -> conn

module postgres:
    pub type conn = int32
    pub def connect(url: str) -> conn:
        0

module audited[DB: backend]:
    type row = DB.conn
    static bump: int32 = 5
    pub def open(url: str) -> int32:
        let c: row = DB.connect(url)
        c + bump

use main.audited[main.postgres] as db

def go() -> int32:
    db.open("x")
