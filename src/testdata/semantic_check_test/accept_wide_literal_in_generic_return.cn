module sample

# `T` is never instantiated at a concrete type anywhere in this file, so the
# only check that ever runs against this body is its template's, with `T`
# still a parameter. That check must not bounds-check a literal against a
# hardcoded `int32` fallback just because `T` isn't concrete.
def min_of[T]() -> T where T: numeric:
    static if T.name() == "int64":
        return -9223372036854775807 - 1
    return 0
