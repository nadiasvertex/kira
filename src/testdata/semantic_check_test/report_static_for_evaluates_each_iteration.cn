module sample

static for n in 0..3:
    static assert n < 10, "every element of 0..3 should be below 10"

static for n in [1, 2, 3, 4]:
    static assert n != 3, "should fail on the third element of the list"

static for n in [3, 6, 7]:
    static if n > 5:
        static for m in 0..n if m == 6:
            static assert n % 3 == 0, "should fail only for n == 7"

def run() -> unit:
  return unit
