module sample

# Bounded generics (`spec/inference-rewrite.md` phase 9, rule 3): `C`'s
# bound is checked at the call that solves it, so an unsuitable `C` is
# reported on the user's own line. The diagnostic names the bound, the type
# that fails it, and — since the user never wrote `int32` as a type argument
# — where that type came from.

trait maker:
    static def make(v: int32) -> self

type counter = { n: int32 }

impl maker for counter:
    static def make(v: int32) -> counter:
        return counter { n: v }

def build[C](v: int32) -> C where C: maker:
    return C.make(v)

def run() -> int32:
    let a: int32 = build(4)
    return a
