module sample

# `example_type.empty()` names the type without its argument, and `empty` takes no
# argument that mentions `T` — nothing at the call can say which `T` is meant
# (spec/todo.md item 12). The fix is the applied spelling, `example_type[int32].empty()`.

type example_type[T] = { v: int32 }

extend[T] example_type[T]:
    def empty() -> example_type[T]:
        return example_type { v: 0 }

def main() -> int32:
    let c = example_type.empty()
    return c.v
