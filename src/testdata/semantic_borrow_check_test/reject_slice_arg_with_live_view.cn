module borrow_check.slice_arg_with_live_view

# A slice written directly as a call argument, `&mut xs[0..xs.len()]`, borrows
# `xs` mutably for the call just as `&mut xs` would. `middle` is a live view
# of `xs` (used on the last line), so the call must be rejected: `middle`
# would observe the mutation.

def poke(v: mut slice[int32]):
    v[0] = 99

def demo() -> int32:
    var xs = [5, 4, 3, 2, 1]
    let middle = xs[1..3]
    poke(&mut xs[0..xs.len()])
    return middle[0]
