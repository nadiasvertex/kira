module borrow_check.slice_args_in_interpolation

# A call inside a string interpolation is borrow-checked like any other: two
# slice arguments of `xs`, one of them `mut`, conflict (at whole-variable
# granularity) even though the call sits inside `"{...}"`.

def both(a: mut slice[int32], b: slice[int32]) -> int32:
    return a[0] + b[0]

def demo() -> str:
    var xs = [5, 4, 3, 2, 1]
    return "{both(&mut xs[0..2], xs[3..5])}"
