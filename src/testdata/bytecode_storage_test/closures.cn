module sample

# Closures in the storage form (chapter 16): a `fn` value is `{entry, env,
# glue}` held inline, and the environment is one block with each captured value
# inline at its own alignment. A closure owns what is moved into it and drops
# that when the closure itself is dropped; a value captured by copy stays
# owned by the enclosing scope.

type pair = { pub a: int32, pub b: int64 }

# Counts its drops in memory the test owns, recording the order they ran in.
type noisy = { pub id: int64, pub counter: *mut int64 }

impl drop for noisy:
    machine def drop(mut self) -> unit:
        *self.counter = *self.counter * 10 + self.id
        return

def call_it(f: fn(int64) -> int64, x: int64) -> int64:
    return f(x)

def call_twice(f: fn(int64) -> int64, a: int64, b: int64) -> int64:
    let x = f(a)
    let y = f(b)
    return x + y

# A scalar copied into the environment.
def add_captured(n: int64) -> int64:
    let add = x => x + n
    return call_it(add, 5)

# An aggregate copied into the environment bytes.
def captured_pair() -> int64:
    let p = pair { a: 3, b: 40 }
    let f = x => x + int64(p.a) + p.b
    return call_it(f, 1)

# Captures of different alignment sit at their own offsets: 0, 8 and 16.
def mixed_alignment(a: int64, b: int32, c: int64) -> int64:
    let f = x => x * a + int64(b) * 100 + c
    return call_it(f, 2)

# A write through a by-reference capture reaches the original variable.
def by_reference() -> int64:
    var total: int64 = 0
    let acc = [&mut total] (x: int64) -> int64 =>:
        total = total + x
        return total
    let first = acc(5)
    let rest = call_twice(acc, 15, 22)
    return first * 1000 + rest * 10 + total

# A value moved into the closure is dropped once, when the closure ends.
machine def make_and_call(counter: *mut int64) -> int64:
    let n = noisy { id: 1, counter: counter }
    let f = move [n] (x: int64) -> int64 => x + n.id
    return f(10)

machine def owning_scope_end() -> int64:
    var drops: int64 = 0
    let r = make_and_call(ptr_cast[int64](&mut drops))
    return r * 100 + drops

# Passed by value: the callee owns the closure and drops it.
machine def pass_owned(counter: *mut int64) -> int64:
    let n = noisy { id: 2, counter: counter }
    let f = move [n] (x: int64) -> int64 => x + n.id
    return call_it(f, 20)

machine def owning_passed() -> int64:
    var drops: int64 = 0
    let r = pass_owned(ptr_cast[int64](&mut drops))
    return r * 100 + drops

# Several captures drop in reverse capture order: 5 first, then 4.
machine def several_owned(counter: *mut int64) -> int64:
    let a = noisy { id: 4, counter: counter }
    let b = noisy { id: 5, counter: counter }
    let f = move [a, b] (x: int64) -> int64 => x + a.id + b.id
    return f(1)

machine def several() -> int64:
    var drops: int64 = 0
    let r = several_owned(ptr_cast[int64](&mut drops))
    return r * 1000 + drops

# A returned closure keeps its environment alive; the caller drops it.
machine def make_owned(counter: *mut int64) -> fn(int64) -> int64:
    let n = noisy { id: 7, counter: counter }
    return move [n] (x: int64) -> int64 => x + n.id

machine def returned_inner(counter: *mut int64) -> int64:
    let f = make_owned(counter)
    let before = *counter
    return f(1) + before * 1000

machine def returned() -> int64:
    var drops: int64 = 0
    let r = returned_inner(ptr_cast[int64](&mut drops))
    return r * 100 + drops

# A value captured without `move` is read from a copy; the closure drops
# nothing, and the enclosing scope still owns the value.
machine def read_only() -> int64:
    var drops: int64 = 0
    let n = noisy { id: 6, counter: ptr_cast[int64](&mut drops) }
    let f = (x: int64) -> int64 => x + n.id
    let r = call_it(f, 1)
    return r * 100 + drops

# One environment block per closure, and none left behind.
def count_closures(n: int64) -> int64:
    var total: int64 = 0
    var i: int64 = 0
    while i < n:
        let p = pair { a: 1, b: i }
        let f = x => x + int64(p.a) + p.b
        total = total + call_it(f, 1)
        i = i + 1
    return total
