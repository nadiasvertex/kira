module sample

# Tasks in the storage form (chapter 18): an `async def` is a constructor plus a
# step function whose frame is the state block, like a generator's. The body
# hands its result over once, by address; an `await` polls the awaited task and
# the step returns `pending` until the scheduler has run it. A plain function
# reads a task's result with `get`, which blocks the calling thread.

# Wider than a register, so the result is moved out of the state block.
type triple = { pub a: int64, pub b: int64, pub c: int64 }

type pair = { pub a: int64, pub b: int64 }

async def double(x: int64) -> int64:
    return x * 2

# Awaits inside a loop: the loop counter and total live in the state block
# across each suspension.
async def sum_doubles(n: int64) -> int64:
    var total: int64 = 0
    var i: int64 = 0
    while i < n:
        total = total + await double(i)
        i = i + 1
    return total

# Awaits one task after another, using the first result for the second.
async def chain(x: int64) -> int64:
    let a = await double(x)
    let b = await double(a)
    return a + b * 10

# A borrow of a local in the state block is held across a suspension.
async def borrows(x: int64) -> int64:
    let p = pair { a: x, b: x * 3 }
    let r = &p
    let d = await double(x)
    return r.a + r.b * 100 + d * 10000

async def make_triple(n: int64) -> triple:
    return triple { a: n, b: n * 2, c: n * 3 }

# A result wider than a register, passed through another task.
async def triple_total(n: int64) -> int64:
    let t = await make_triple(n)
    return t.a + t.b * 100 + t.c * 10000

async def nothing() -> unit:
    return

# A task whose result is `unit` still finishes.
async def waits_for_nothing(x: int64) -> int64:
    await nothing()
    return x + 1

# `await par` runs the branches together and gives the tuple of their results.
async def together(x: int64) -> int64:
    let (a, b) = await par:
        double(x)
        chain(x)
    return a + b * 1000

# Three branches, one of them with a result wider than a register.
async def wide_group(n: int64) -> int64:
    let (t, a, c) = await par:
        make_triple(n)
        double(n)
        chain(n)
    return t.a + t.b * 10 + t.c * 100 + a * 1000 + c * 10000

# `await race` gives the first result and cancels the others. The first branch
# would take far too long to finish, so the second always wins.
async def first_wins(x: int64) -> int64:
    return await race:
        sum_doubles(1000000)
        double(x)

# The group is waited on again in a loop, so each pass builds a new one.
async def groups_in_a_loop(n: int64) -> int64:
    var total: int64 = 0
    var i: int64 = 0
    while i < n:
        let (a, b) = await par:
            double(i)
            double(i + 1)
        total = total + a + b
        i = i + 1
    return total

# A block that runs on a pool is a task of its own, with `x` passed in.
async def on_a_pool(x: int64) -> int64:
    let inner = await on(cpu):
        x * 5
    return inner + 1

def run_on_a_pool(x: int64) -> int64:
    let t = on_a_pool(x)
    return t.get()

def run_double(x: int64) -> int64:
    let t = double(x)
    return t.get()

def run_sum(n: int64) -> int64:
    let t = sum_doubles(n)
    return t.get()

def run_chain(x: int64) -> int64:
    let t = chain(x)
    return t.get()

def run_together(x: int64) -> int64:
    let t = together(x)
    return t.get()

def run_wide_group(n: int64) -> int64:
    let t = wide_group(n)
    return t.get()

def run_first_wins(x: int64) -> int64:
    let t = first_wins(x)
    return t.get()

def run_groups_in_a_loop(n: int64) -> int64:
    let t = groups_in_a_loop(n)
    return t.get()

def run_borrows(x: int64) -> int64:
    let t = borrows(x)
    return t.get()

def run_triple(n: int64) -> int64:
    let t = triple_total(n)
    return t.get()

def run_unit(x: int64) -> int64:
    let t = waits_for_nothing(x)
    return t.get()

# A task the scheduler already owns can be read once it has finished.
def run_spawned(x: int64) -> int64:
    let a = double(x)
    let b = double(x + 1)
    a.spawn()
    b.spawn()
    return a.get() * 100 + b.get()

# A task that never ran is dropped without running its body.
def run_unstarted() -> int64:
    let t = sum_doubles(1000)
    return 7

# The entry point is an ordinary function that blocks on each task it awaits,
# and on each group: 12 from `sum_doubles`, 42 from `chain(1)`, 10 and 12 from
# the `par`, and 14 from the `race`.
async def main() -> int64:
    let a = await sum_doubles(4)
    let (p, q) = await par:
        double(5)
        double(6)
    let w = await race:
        sum_doubles(1000000)
        double(7)
    let c = await chain(1)
    return a + c + p + q * 100 + w * 10000
