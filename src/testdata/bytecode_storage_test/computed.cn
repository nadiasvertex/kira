module sample

# `[value; count]` builds the value once, into element 0, and copies it over
# the rest. Counts that are not powers of two end on a shorter copy.
def fill_sum(n: int64) -> int64:
    var xs: array[int64, 5] = [7; 5]
    xs[1] = n
    return xs[0] + xs[1] + xs[2] + xs[3] + xs[4]

def fill_count(b: byte) -> int64:
    let buf: array[byte, 4096] = [b; 4096]
    var n: int64 = 0
    var i: usize = 0
    while i < 4096:
        if buf[i] == b:
            n = n + 1
        i = i + 1
    return n

# The fill value must be `copy`; a tuple moves, so it cannot be one.
def fill_words(i: usize) -> int32:
    let ws: array[int32, 7] = [9; 7]
    return ws[i]

# A field or element of a value that is not a place is read from a temporary.
type pair = { pub a: int64, pub b: int64 }

def make_pair(n: int64) -> pair:
    return pair { a: n, b: n * 2 }

def second_of(n: int64) -> int64:
    return make_pair(n).b

def make_trio(n: int64) -> (int64, int64, int64):
    return (n, n + 1, n + 2)

def third_of(n: int64) -> int64:
    return make_trio(n).2

def make_row(n: int64) -> array[int64, 3]:
    return [n, n * 10, n * 100]

def row_last(n: int64) -> int64:
    return make_row(n)[2]

# A loop over values that need a drop. Each drop appends its id to a counter,
# so the counter records which drops ran and in what order.
type tracked = { pub id: int64, pub counter: *mut int64 }

impl drop for tracked:
    machine def drop(mut self) -> unit:
        *self.counter = *self.counter * 10 + self.id
        return

type countdown = { pub left: int64, pub counter: *mut int64 }

impl iterator[tracked] for countdown:
    def next(mut self) -> option[tracked]:
        if self.left <= 0:
            return @none
        let id = self.left
        self.left = self.left - 1
        return @some(tracked { id: id, counter: self.counter })

# Each item is dropped at the end of its iteration.
def while_sum_inner(n: int64, counter: *mut int64) -> int64:
    var c = countdown { left: n, counter: counter }
    var total: int64 = 0
    while let @some(t) = c.next():
        total = total + t.id
    return total

machine def while_sum(n: int64) -> int64:
    var drops: int64 = 0
    let total = while_sum_inner(n, ptr_cast[int64](&mut drops))
    return drops * 100 + total

def for_sum_inner(n: int64, counter: *mut int64) -> int64:
    var total: int64 = 0
    for t in countdown { left: n, counter: counter }:
        total = total + t.id
    return total

machine def for_sum(n: int64) -> int64:
    var drops: int64 = 0
    let total = for_sum_inner(n, ptr_cast[int64](&mut drops))
    return drops * 100 + total

# An item moved out of the loop is not dropped by it.
def consume(t: tracked) -> int64:
    return t.id

def for_moved_inner(n: int64, counter: *mut int64) -> int64:
    var total: int64 = 0
    for t in countdown { left: n, counter: counter }:
        total = total + consume(t)
    return total

machine def for_moved(n: int64) -> int64:
    var drops: int64 = 0
    let total = for_moved_inner(n, ptr_cast[int64](&mut drops))
    return drops * 100 + total

# Leaving early with `break` still drops the item the iteration holds.
def for_break_inner(n: int64, counter: *mut int64) -> int64:
    var total: int64 = 0
    for t in countdown { left: n, counter: counter }:
        if t.id == 2:
            break
        total = total + t.id
    return total

machine def for_break(n: int64) -> int64:
    var drops: int64 = 0
    let total = for_break_inner(n, ptr_cast[int64](&mut drops))
    return drops * 100 + total
