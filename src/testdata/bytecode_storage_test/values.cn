module sample
type pair = { pub a: int32, pub b: int32 }
type line = { pub from: pair, pub to: pair }
type shape = @circle(int32) | @rect(int32, int32) | @empty
type framed = { pub kind: shape, pub id: int32 }
type wide = { pub a: int64, pub b: int64, pub c: int64, pub d: int64 }
type flags = { pub lit: bool, pub small: int8, pub mid: int16, pub id: int32 }

def make_pair(n: int32) -> pair:
    return pair { a: n, b: n + 1 }

def make_line(n: int32) -> line:
    return line { from: make_pair(n), to: pair { a: 0, b: n } }

def forward(n: int32) -> pair:
    return make_pair(n)

def bind(n: int32) -> int32:
    let p = make_pair(n)
    return p.b

def make_tuple(n: int32) -> (int32, int32):
    return (n, n + 1)

def make_array(n: int32) -> array[int32, 3]:
    return [n, n, 0]

def make_rect(n: int32) -> shape:
    return @rect(n, n + 1)

def make_empty() -> shape:
    return @empty

def make_framed(n: int32) -> framed:
    return framed { kind: @circle(n), id: n }

def make_wide(n: int64) -> wide:
    return wide { a: n, b: n + 1, c: n + 2, d: n + 3 }

def forward_wide(n: int64) -> wide:
    return make_wide(n)

def make_flags(n: int32) -> flags:
    return flags { lit: n > 0, small: -5, mid: -300, id: n }

def take_pair(p: pair, k: int32) -> int32:
    return p.a + k

def pass_fresh(n: int32) -> int32:
    return take_pair(make_pair(n), n)

def pass_local(p: pair) -> int32:
    return take_pair(p, 1)

def take_wide(w: wide) -> int64:
    return w.a + w.d

def pass_wide(n: int64) -> int64:
    return take_wide(make_wide(n))

def reassign(n: int32) -> pair:
    var p = make_pair(n)
    p = make_pair(p.b)
    return p

def return_local(n: int32) -> pair:
    let p = make_pair(n)
    return p

def first(p: &pair) -> int32:
    return p.a

def borrow(n: int32) -> int32:
    let p = make_pair(n)
    return first(&p)

def bump(p: &pair) -> pair:
    return pair { a: p.a + 1, b: p.b }

def self_bump(n: int32) -> pair:
    var p = make_pair(n)
    p = bump(&p)
    return p

def set_a(p: &mut pair, v: int32) -> unit:
    p.a = v
    return

def mutate(n: int32) -> int32:
    var p = make_pair(n)
    set_a(&mut p, 40)
    return p.a + p.b

def deep(n: int32) -> pair:
    if n == 0:
        return make_pair(0)
    let p = deep(n - 1)
    return pair { a: p.a + 1, b: p.b + 2 }

def build_line_sum(n: int32) -> int32:
    let l = make_line(n)
    return l.from.a + l.from.b + l.to.a + l.to.b

def neg_literal() -> int8:
    return -128

def small_flags(n: int32) -> int32:
    let f = make_flags(n)
    return (f.mid as int32) + (f.small as int32)

def narrow_compare(n: int32) -> int32:
    let f = make_flags(n)
    if f.mid < 0 and f.small < 0:
        return 1
    return 0

def mid_of(n: int32) -> int16:
    let f = make_flags(n)
    return f.mid
