module main

# `clone` is a prelude trait: a user type implements it and `.clone()` is
# an ordinary method call, including through a generic bound.

type point = { x: int32, y: int32 }

impl clone for point:
    def clone(self) -> point:
        return point { x: self.x + 100, y: self.y }

def twice[T](v: &T) -> T where T: clone:
    return v.clone()

def main() -> unit:
    let p = point { x: 1, y: 2 }
    let q = p.clone()
    println("{q.x} {q.y}")
    let r = twice(&p)
    println("{r.x} {r.y} {p.x}")
