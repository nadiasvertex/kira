module main

# Scope-exit `drop` (spec/todo.md item 6): reverse-declaration-order drop,
# moved-from bindings never dropping, implicit field-wise drop for a struct
# with no own `impl drop`, and drop firing on early `return`/`break`/
# `continue` as well as normal fall-through. Every case below prints exactly
# once per value, in an order that could only come from real drop glue
# running at the right point — never from an explicit `.free()`-style call,
# since none is written here.

type noisy = { id: int32 }

impl drop for noisy:
    def drop(mut self) -> unit:
        println("drop {self.id}")

# No own `impl drop`, but one field is droppable — the implicit field-wise
# rule (spec/specification/02-intermediate/17-shared-ownership-and-drop.md)
# must still fire for it.
type holder = { inner: noisy, tag: int32 }

def takes(mut n: noisy) -> unit:
    println("consumed {n.id}")

def reverse_order() -> unit:
    let a = noisy { id: 1 }
    let b = noisy { id: 2 }
    let c = noisy { id: 3 }
    println("reverse_order body done")

def moved_from_never_drops() -> unit:
    let a = noisy { id: 10 }
    let b = noisy { id: 11 }
    takes(a)
    println("moved_from body done")

def field_wise_drop() -> unit:
    let h = holder { inner: noisy { id: 20 }, tag: 99 }
    println("field_wise body done")

extend noisy:
    def touch(mut self) -> unit:
        println("touch {self.id}")

# A method's `self`/`mut self` receiver is always passed *by reference*
# (`src/semantic/ownership_cfg.cpp`'s `receiver_mode`: methods always take
# `self` by reference, regardless of `mut`) — calling a method on a
# droppable value must not drop it out from under the caller who still owns
# it. `a` is used (and would double-drop or use-after-drop if `touch`'s own
# `self` parameter were wrongly scheduled for a drop at `touch`'s own return)
# twice here, then drops exactly once, at this function's own scope exit.
def method_receiver_not_dropped_early() -> unit:
    let a = noisy { id: 50 }
    a.touch()
    a.touch()
    println("method_receiver body done")

def peek(n: &noisy) -> unit:
    println("peek {n.id}")

# Passing a bare value to a `&` parameter only lends it (implicit autoref);
# the caller still owns it and must drop it at scope exit.
def lent_value_still_drops() -> unit:
    let a = noisy { id: 60 }
    peek(a)
    peek(&a)
    println("lent body done")

def lent_then_early_return(flag: bool) -> unit:
    let a = noisy { id: 61 }
    peek(a)
    if flag:
        println("lent early return")
        return
    println("lent fallthrough")

def early_return(flag: bool) -> unit:
    let a = noisy { id: 30 }
    if flag:
        println("early_return taking the early path")
        return
    println("early_return fallthrough")

def early_break() -> unit:
    var i = 0
    while i < 5:
        let a = noisy { id: 40 + i }
        if i == 1:
            println("early_break breaking")
            break
        i = i + 1
    println("early_break loop done")

# A name rebound in the same scope hides the earlier binding, which is still
# owned and still drops: both run, the later binding first.
def shadowed_in_same_scope() -> unit:
    let a = noisy { id: 70 }
    let a = noisy { id: 71 }
    println("shadowed body {a.id}")

# A shadowing binding that is not droppable must not hide the droppable one
# beneath it from the drop schedule.
def shadowed_by_plain_value() -> unit:
    let a = noisy { id: 72 }
    let a = 5
    println("shadowed by int {a}")

def id_of(n: &noisy) -> int32:
    return n.id

# The returned expression only borrows the local, so the local still drops —
# after the value is read, not before.
def return_borrowing_local() -> int32:
    let a = noisy { id: 80 }
    return id_of(a)

# Sum types drop the active variant's payload; other variants drop nothing.
type slot = @held(noisy) | @pair(int32, noisy) | @empty

def sum_active_variant() -> unit:
    let a: slot = @held(noisy { id: 90 })
    let b: slot = @pair(7, noisy { id: 91 })
    let c: slot = @empty
    println("sum body done")

def sum_in_option() -> unit:
    let o: option[noisy] = @some(noisy { id: 92 })
    let n: option[noisy] = @none
    println("option body done")

def sum_moved_out() -> unit:
    let o: option[noisy] = @some(noisy { id: 93 })
    let p = o
    println("sum moved body done")

# A scope whose tail is a value still drops its locals, after the tail has
# been evaluated (so a tail that only borrows a local reads it first).
def tail_fn() -> int32:
    let a = noisy { id: 100 }
    id_of(a)

def tail_if(flag: bool) -> int32:
    let a = noisy { id: 101 }
    if flag:
        let b = noisy { id: 102 }
        id_of(b) + 1000
    else:
        id_of(a)

def tail_match(o: option[int32]) -> int32:
    let a = noisy { id: 103 }
    match o:
        @some(x) => x + id_of(a)
        @none => id_of(a)

def tail_param(n: noisy) -> int32:
    n.id

# Pattern bindings own their part of a subject that is a whole local or a
# fresh value, and drop with their scope. A `_` drops what it leaves unbound.
# A subject that is only part of something else (`b.s`) still belongs to its
# owner, so its bindings never drop.
type pair2 = { a: noisy, b: noisy }
type wrap = { s: slot }

def match_binding_drops() -> unit:
    let a: slot = @held(noisy { id: 200 })
    match a:
        @held(n) => println("arm {n.id}")
        @pair(_, n) => println("pair")
        @empty => println("empty")
    println("match_binding done")

def match_wildcard_drops() -> unit:
    let a: slot = @pair(1, noisy { id: 201 })
    match a:
        @held(n) => println("held")
        @pair(_, _) => println("wild")
        @empty => println("empty")
    println("match_wildcard done")

def match_moved_binding() -> unit:
    let a: slot = @held(noisy { id: 202 })
    match a:
        @held(n) => takes(n)
        _ => println("other")
    println("match_moved done")

def match_return_in_arm() -> int32:
    let a: slot = @held(noisy { id: 203 })
    let z = noisy { id: 204 }
    match a:
        @held(n) => return 5
        _ => println("other")
    7

def match_value_arm(o: option[noisy]) -> int32:
    match o:
        @some(n) => n.id
        @none => 0

def make_noisy() -> option[noisy]:
    @some(noisy { id: 205 })

def match_fresh_subject() -> unit:
    match make_noisy():
        @some(n) => println("fresh {n.id}")
        @none => println("none")

def match_part_of_place(w: &wrap) -> unit:
    match w.s:
        @held(n) => println("part {n.id}")
        _ => println("part other")

def if_let_hit_and_miss() -> unit:
    let o: option[noisy] = @some(noisy { id: 206 })
    if let @some(n) = o:
        println("iflet {n.id}")
    let s: slot = @pair(2, noisy { id: 207 })
    if let @held(n) = s:
        println("hit")
    else:
        println("miss")
    println("if_let done")

def while_let_binding() -> unit:
    var o: option[noisy] = @some(noisy { id: 208 })
    while let @some(n) = o:
        println("loop {n.id}")
        o = @none
    println("while_let done")

def let_destructure() -> unit:
    let t = pair2 { a: noisy { id: 209 }, b: noisy { id: 210 } }
    let {a: x, b: y} = t
    let (p, q) = (noisy { id: 211 }, noisy { id: 212 })
    println("destructure done")

def while_let_exit_drops() -> unit:
    var s: slot = @held(noisy { id: 220 })
    while let @held(n) = s:
        println("wl {n.id}")
        s = @pair(1, noisy { id: 221 })
    println("while_let_exit done")

def let_else_miss_drops() -> unit:
    let s: slot = @pair(2, noisy { id: 222 })
    let @held(n) = s else:
        println("else branch")
        return
    println("unreachable {n.id}")

def let_else_hit() -> unit:
    let s: slot = @held(noisy { id: 223 })
    let @held(n) = s else:
        return
    println("hit {n.id}")

def struct_rest_drops() -> unit:
    let t = pair2 { a: noisy { id: 224 }, b: noisy { id: 225 } }
    let {a: x, ..} = t
    println("rest done {x.id}")

def takes_pair({a: x, b: y}: pair2) -> unit:
    println("params {x.id} {y.id}")

def takes_pair_rest({a: x, ..}: pair2) -> unit:
    println("params rest {x.id}")

def takes_tuple((p, _): (noisy, noisy)) -> unit:
    println("params tuple {p.id}")

# A `for` loop moves a whole local iterable into the loop. The loop variable
# only borrows, so the iterable drops once the loop ends, `break` included.
type counter = { guard: noisy, i: int32 }

impl iterator[int32] for counter:
    def next(mut self) -> option[int32]:
        if self.i < 3:
            self.i = self.i + 1
            return @some(self.i)
        return @none

def for_iterable_drops() -> unit:
    let c = counter { guard: noisy { id: 240 }, i: 0 }
    for v in c:
        println("for {v}")
    println("for done")

def for_break_drops() -> unit:
    let c = counter { guard: noisy { id: 241 }, i: 0 }
    for v in c:
        println("for break {v}")
        break
    println("for break done")

def for_return_drops() -> unit:
    let c = counter { guard: noisy { id: 242 }, i: 0 }
    for v in c:
        println("for return {v}")
        return

def for_return_value(flag: bool) -> int32:
    let c = counter { guard: noisy { id: 243 }, i: 0 }
    for v in c:
        if flag:
            return v + 10
    return 0

def for_lambda_return() -> int32:
    let c = counter { guard: noisy { id: 244 }, i: 0 }
    var total = 0
    for v in c:
        let f = (x: int32) -> int32 => x + 1
        total = total + f(v)
    return total

def main() -> unit:
    println("rv {for_return_value(true)}")
    println("rv {for_return_value(false)}")
    println("lam {for_lambda_return()}")
    for_return_drops()
    reverse_order()
    moved_from_never_drops()
    field_wise_drop()
    method_receiver_not_dropped_early()
    lent_value_still_drops()
    lent_then_early_return(true)
    early_return(true)
    early_break()
    shadowed_in_same_scope()
    shadowed_by_plain_value()
    sum_active_variant()
    sum_in_option()
    sum_moved_out()
    println("tail_fn {tail_fn()}")
    println("tail_if {tail_if(true)}")
    println("tail_if {tail_if(false)}")
    println("tail_match {tail_match(@some(1))}")
    println("tail_match {tail_match(@none)}")
    println("tail_param {tail_param(noisy { id: 104 })}")
    println("returned {return_borrowing_local()}")
    match_binding_drops()
    match_wildcard_drops()
    match_moved_binding()
    println("ret {match_return_in_arm()}")
    println("val {match_value_arm(@some(noisy { id: 213 }))}")
    match_fresh_subject()
    let w = wrap { s: @held(noisy { id: 214 }) }
    match_part_of_place(w)
    println("part done")
    if_let_hit_and_miss()
    while_let_binding()
    let_destructure()
    while_let_exit_drops()
    let_else_miss_drops()
    let_else_hit()
    struct_rest_drops()
    takes_pair(pair2 { a: noisy { id: 226 }, b: noisy { id: 227 } })
    takes_pair_rest(pair2 { a: noisy { id: 228 }, b: noisy { id: 229 } })
    takes_tuple((noisy { id: 230 }, noisy { id: 231 }))
    for_iterable_drops()
    for_break_drops()
    println("main done")
