module main

# `std.list`'s `list[T]` — a growable list written in Cinder, owning its own
# heap storage through `std.mem` over the `rt_alloc`/`rt_realloc`/`rt_free`
# intrinsics, with no compiler support for the type beyond what any user
# struct gets.
#
# Exercises the operations the builtin `list[T]` could never offer, because
# no primitive could shrink or re-home its storage: `pop`,
# `clear`, `reserve`, `capacity`, and an explicit `free`.
#
# Also pins the growth schedule (4, then doubling), since capacity is
# observable and a change to it is a change to the type's cost model, not an
# implementation detail.

use std.list.list

def show(label: str, o: option[int32]) -> unit:
    match o:
        @some(x) => println("{label}={x}")
        @none => println("{label}=none")

def main() -> unit:
    var v = list[int32].new()
    println("fresh empty={v.is_empty()} len={v.len()} cap={v.capacity()}")

    # Growth: 0 -> 4 -> 8 -> 16 over ten pushes.
    var i = 0
    while i < 10:
        v.push(i * 3)
        i = i + 1
    println("filled len={v.len()} cap={v.capacity()} empty={v.is_empty()}")

    show("get(0)", v.get(0))
    show("get(4)", v.get(4))
    show("get(9)", v.get(9))
    show("get(10)", v.get(10))

    println("set(0,42)={v.set(0, 42)} set(99,1)={v.set(99, 1)}")
    show("get(0)", v.get(0))

    show("pop", v.pop())
    println("after pop len={v.len()} cap={v.capacity()}")

    # `reserve` grows without changing the contents or the length.
    v.reserve(100)
    println("reserved len={v.len()} cap={v.capacity()}")
    show("get(3)", v.get(3))
    # Never shrinks.
    v.reserve(2)
    println("reserve smaller cap={v.capacity()}")

    # `clear` keeps the capacity; popping an empty list yields `@none`.
    v.clear()
    println("cleared len={v.len()} cap={v.capacity()} empty={v.is_empty()}")
    show("pop empty", v.pop())
    show("get(0) empty", v.get(0))

    # Storage is reusable after clearing.
    v.push(7)
    show("re-push get(0)", v.get(0))

    v.free()
    println("freed len={v.len()} cap={v.capacity()}")

    # `list[T]` as an ordinary collection: built from a literal, indexed,
    # and iterated, all through the `from_array`/`index`/`index_set`/
    # `into_iterator` impls rather than through anything the compiler knows
    # about this type specifically (`spec/list-migration-design.md`).
    var lit: list[int32] = [10, 20, 30]
    println("literal len={lit.len()} cap={lit.capacity()}")
    println("indexed={lit[0]},{lit[1]},{lit[2]}")
    lit[1] = 99
    println("written={lit[0]},{lit[1]},{lit[2]}")
    lit.free()

    # `for x in v` goes through `into_iterator`, whose `into_iter(self)`
    # takes the collection *by value* — so iterating consumes it, and the
    # move checker refuses any later use. That is correct for this trait and
    # wrong for a collection: `for x in xs` over a `list` must not consume
    # `xs`. A borrowing route is the remaining phase-2 work (`spec/todo.md`
    # item 20), so the list iterated here is deliberately one that is not
    # used again — and, having been moved, it cannot be freed either.
    let consumed: list[int32] = [10, 99, 30]
    var sum = 0
    var order = ""
    for x in consumed:
        sum = sum + x
        order = "{order}{x}."
    println("iterated sum={sum} order={order}")

    # A second element width, through the same generic impls.
    var wide: list[int64] = [1000, 2000]
    println("wide={wide[0]},{wide[1]}")
    var wsum: int64 = 0
    for y in wide:
        wsum = wsum + y
    println("wide sum={wsum}")
