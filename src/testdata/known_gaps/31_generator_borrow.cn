# todo: 31
# tier: both
# currently-error: an iterator over a borrowed collection that is not a local
# want: rejected, because the generator result borrows `xs`, so `xs.push(4)` conflicts while `g` is still used.
module known_gaps.generator_borrow

generator def each(xs: &list[int32]) -> some iterator[int32]:
    for x in xs:
        yield x

def main() -> int32:
    var xs: list[int32] = [1, 2, 3]
    var g = each(&xs)
    let a = g.next() or else panic("a")
    xs.push(4)
    let b = g.next() or else panic("b")
    return a + b
