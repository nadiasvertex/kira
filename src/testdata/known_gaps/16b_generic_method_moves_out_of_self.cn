# todo: 16
# tier: both
# currently-error: breaks verifier rule A2: a `use` moves out of a place rooted at an alias
# want: the checker rejects `@full(v) => v` in the generic `grab` over `T`, because it moves a non-`copy` part out of `self`.
module known_gaps.generic_method_moves_out_of_self

type tok = { n: int32 }

impl drop for tok:
    def drop(mut self):
        let _ = 0

type holder[T] = @full(T) | @empty

extend[T] holder[T]:
    def grab(self, d: T) -> T:
        return match self:
            @full(v) => v
            @empty => d

def main() -> int32:
    let h: holder[tok] = @full(tok { n: 5 })
    let t = h.grab(tok { n: 1 })
    return t.n
