# todo: 21
# tier: both
# currently-accepted
# currently-result: 3
# want: stays accepted without `mut` (the other half of 21): a plain `@some(xs)` binding through a `&mut` subject is writable, so `xs.push(9)` changes the referent and `main` returns 3.
module known_gaps.pattern_binding_push_via_mut_ref

def grow(o: &mut option[list[int32]]) -> unit:
    match o:
        @some(xs) => xs.push(9)
        @none => return

def main() -> int32:
    var o: option[list[int32]] = @some([1, 2])
    grow(&mut o)
    return match o:
        @some(xs) => xs.len() as int32
        @none => 0
