# tier: both
# currently-error: that needs a drop flag
# want: `main` returns 4, and every element is dropped, whether the guard keeps it or skips it.
module known_gaps.guarded_for_drops

type boxed = { id: int32, data: list[int32] }

def mk(id: int32) -> boxed:
    return boxed { id: id, data: [id] }

def main() -> int32:
    var xs: list[boxed] = [mk(1), mk(2), mk(3)]
    var total: int32 = 0
    for b in xs if b.id != 2:
        total = total + b.id
    return total
