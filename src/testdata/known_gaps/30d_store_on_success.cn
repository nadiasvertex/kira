# currently-accepted
# currently-result: 1
# want: rejected, because on `@ok` the registry holds a view of `src`, so `src.push` in the match arm conflicts while `r` is still read.
module known_gaps.store_on_success

type registry = { names: list[slice[int32]] }

def register(reg: &mut registry, s: slice[int32]) -> result[unit, int32]:
    if s.len() == 0:
        return @err(0)
    reg.names.push(s)
    return @ok(())

def main() -> int32:
    var r = registry { names: [] }
    var src: list[int32] = [1]
    match register(&mut r, src.as_slice()):
        @ok(_) => src.push(2)
        @err(_) => src.push(3)
    return r.names[0][0]
