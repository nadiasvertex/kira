# tier: both
# currently-error: `copy` does not name a known trait here
# want: `implements[T, copy]()` compiles and answers true for `int32`, so `main` returns 14.
module known_gaps.implements_copy

static pure def is_copy[T]() -> bool:
    return implements[T, copy]()

def main() -> int32:
    if is_copy[int32]():
        return 14
    return 1
