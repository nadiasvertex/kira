# todo: 42
# tier: both
# currently-error: an `await` that is evaluated conditionally or repeatedly
# want: an `await` in an `elif` condition inside a task compiles, and main returns 7.
module known_gaps.conditional_suspension_in_task

async def one() -> int32:
    return 1

async def helper(x: int32) -> int32:
    if x > 5:
        return 0
    elif (await one()) == 1:
        return 7
    return 1

async def main() -> int32:
    return await helper(3)
