# tier: both
# currently-error: cannot borrow `other` while the closure `r` is still in use
# want: rejected with "cannot borrow `other` while the closure `f` is still in use", because `r`, the result of `apply`, keeps the borrow that `f` holds on `other`.
module known_gaps.callback_capture_origin

def apply(part: slice[int32], f: fn(slice[int32]) -> slice[int32]) -> slice[int32]:
    return f(part)

def main() -> int32:
    let xs: list[int32] = [1, 2, 3]
    var other: list[int32] = [9]
    let f = (p: slice[int32]) => other.as_slice()
    let r = apply(xs.as_slice(), f)
    other.push(5)
    return r[0]
