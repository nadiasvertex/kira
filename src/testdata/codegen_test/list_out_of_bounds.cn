module sample

# A `list` index out of range refuses rather than reading past the end.
#
# The refusal itself is `src/std/list.cn`'s `panic("index out of range")`,
# which aborts the process — `list` is an ordinary stdlib type now, so its
# bounds check is Cinder code calling `panic`, not a bounds-checked VM opcode
# raising a catchable `panic_reason`. That makes the panicking path
# observable only by running a built binary as a child process; it is
# covered there, by `src/cli_test.cpp`'s
# `test_built_program_panics_on_list_index_out_of_bounds`.
#
# What a harness running either tier in-process can still check is the
# bounds *decision*, which `mutable_cell` reports instead of panicking on:
# it answers `@none` for exactly the indices `xs[i]` would refuse. Written
# as a computed value rather than as "no diagnostic", so an off-by-one in
# the comparison changes the answer.
def at_or_sentinel(i: usize) -> int32:
    var xs = [10, 20, 30]
    if let @some(c) = xs.mutable_cell(i):
        return c.get()
    return -1

def main() -> int32:
    # 30 in bounds, -1 just past the end, -1 far past it: 30 - 1 - 1 = 28.
    return at_or_sentinel(2) + at_or_sentinel(3) + at_or_sentinel(99)
