# bar: AT BAR. Phase 9. Inside the body that declares it, `T` is one fixed
# type, not a wildcard: returning a `T` where an `int32` is declared is a
# mismatch, reported against `T` rather than waiting for an instance where
# `T` happens to be `int32` (and passes) or `str` (and fails elsewhere).
module infer_diag.type_param_is_not_a_concrete_type

def leak[T](x: T) -> int32:
    return x
