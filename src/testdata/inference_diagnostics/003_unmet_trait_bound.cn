# bar: AT BAR since phase 9 (bounded generics). A failed trait obligation
# names the goal (`T: ordering`, with `T` = `point`), points at the bound
# that required it, and gives the way out (implement `ordering` for
# `point`) — at the user's call, not inside the generic body. Before phase 9
# the failure surfaced as a missing *method* inside `biggest`'s instance,
# which named neither the goal nor the bound.
module infer_diag.unmet_trait_bound

type point = { x: int32 }

trait ordering:
    def less(self, other: self) -> bool

def biggest[T](a: T, b: T) -> T where T: ordering:
    if a.less(b):
        b
    else:
        a

def wrong(p: point, q: point) -> point:
    biggest(p, q)
