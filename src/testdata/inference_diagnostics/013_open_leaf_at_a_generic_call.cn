# bar: AT BAR for placement. The message names the line the reader has to
# change. Nothing in this call can say what `T` is: `count_of` mentions `T`
# only in `xs`, and `xs` is the open list. (The shape this case used to hold,
# `first_or(out, 0)` with `fallback: T`, now answers: the literal's `int32`
# solves `T`, and every argument is re-checked against that solution, which
# pins `out` — see codegen_stress/105_open_leaf_answered_by_sibling.cn.)
#
# What this case exists to hold is the *refusal*. Before it, `list[?]` was
# allowed to answer `T` with the metavariable itself, and the checker then
# had a leaf bound to a type parameter belonging to a function it was only
# calling. That captured `T`: it type-checked, and lowering asked for
# `list::from_array$0$list_T_`, an instance of a type no value has. Declining
# to answer, and saying so here, is the better of the two failures by a wide
# margin.
module infer_diag.open_leaf_at_a_generic_call

def count_of[T](xs: list[T], fallback: int32) -> int32:
    return fallback

def wrong() -> int32:
    var out = []
    return count_of(out, 0)
