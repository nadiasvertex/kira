# bar: AT BAR for placement. The message names the line the reader has to
# change. Nothing in the program can say what `T` is: `count_of` mentions `T`
# only in `xs`, and `xs` is the open list. (The shape this case used to hold,
# `first_or(out, 0)` with `fallback: T`, now answers: the literal's `int32`
# solves `T`, and every argument is re-checked against that solution, which
# pins `out` — see codegen_stress/105_open_leaf_answered_by_sibling.cn.)
#
# What this case holds is that the mistake is reported once, at the `[]`.
# The call answers `T` with the list's element leaf and waits to name its
# instance until that leaf settles (`when_solution_settles`). The leaf never
# settles, so no instance is named: in particular not
# `list::from_array$0$list_T_`, the instance of a type no value has that an
# earlier version asked lowering for. A second "cannot tell what `T` is" at
# the call would be the same mistake reported twice.
module infer_diag.open_leaf_at_a_generic_call

def count_of[T](xs: list[T], fallback: int32) -> int32:
    return fallback

def wrong() -> int32:
    var out = []
    return count_of(out, 0)
