module main
def fib(n: int64) -> int64:
    var a: int64 = 0
    var b: int64 = 1
    var i: int64 = 0
    while i < n:
        let t = a + b
        a = b
        b = t
        i += 1
    return a
def skip_and_stop(n: int64) -> int64:
    var total: int64 = 0
    for i in 0..n:
        if i == 7:
            continue
        if i == 15:
            break
        total += i
    return total
def triangle() -> int64:
    var count: int64 = 0
    for i in 0..5:
        for j in 0..5:
            if j == i:
                break
            count += 1
    return count
def first_square_over(limit: int64) -> int64:
    for i in 0..100:
        if i * i > limit:
            return i
    return 0
static total: int64 = fib(10) + skip_and_stop(20) + triangle() + first_square_over(50)
def main() -> int32:
    return total as int32
