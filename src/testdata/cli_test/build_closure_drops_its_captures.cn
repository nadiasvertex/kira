module sample
type noisy = { id: int32 }
impl drop for noisy:
  def drop(mut self) -> unit:
    println("drop {self.id}")
def apply(f: fn() -> int32) -> int32:
  return f()
def one_path(take: bool) -> unit:
  let n = noisy { id: 1 }
  if take:
    let f = move () => n.id
    println("saw {f()}")
  println("done")
def passed() -> unit:
  let n = noisy { id: 2 }
  let f = move () => n.id
  println("applied {apply(f)}")
def main() -> int32:
  one_path(true)
  one_path(false)
  passed()
  return 0
