module probes.deep_write
# Must reject under every design: bump reaches a push to self.items through
# a helper, so the caller's view of a.items conflicts. The diagnostic should
# show the call chain.
type acc = { items: list[int32], total: int32 }
extend acc:
    def note(mut self, n: int32) -> unit:
        self.items.push(n)
    def bump(mut self, n: int32) -> unit:
        self.total = self.total + n
        self.note(n)
def main() -> int32:
    var a = acc { items: [1, 2, 3], total: 0 }
    let v = a.items.as_slice()
    a.bump(10)
    return v[0] + a.total
