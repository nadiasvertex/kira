module probes.typestate
# Typestate as a value-indexed affine type: close consumes conn[true]
# and returns conn[false]; send accepts only conn[true]. Expect accept, 7.
type conn[open: bool] = { fd: int32 }
def connect(fd: int32) -> conn[true]:
    return conn[true] { fd: fd }
def send(c: conn[true], m: int32) -> conn[true]:
    return conn[true] { fd: c.fd + m }
def close(c: conn[true]) -> conn[false]:
    return conn[false] { fd: c.fd }
def main() -> int32:
    let c = connect(1)
    let c2 = send(c, 6)
    let done = close(c2)
    return done.fd
