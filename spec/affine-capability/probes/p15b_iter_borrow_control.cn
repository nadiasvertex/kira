module probes.iter_borrow_control
use std.iter.iter
# Control for p15: the same shape with a hand-written iterator. Expect reject.
def main() -> int32:
    var xs: list[int32] = [1, 2, 3]
    var it = iter(&xs)
    let a = it.next() or else panic("a")
    let ax = *a
    xs.push(4)
    let b = it.next() or else panic("b")
    return ax + *b
