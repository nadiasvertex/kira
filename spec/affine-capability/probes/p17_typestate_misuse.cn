module probes.typestate_misuse
# Expect reject: send on a closed connection, and reuse of a moved token.
type conn[open: bool] = { fd: int32 }
def send(c: conn[true], m: int32) -> conn[true]:
    return conn[true] { fd: c.fd + m }
def close(c: conn[true]) -> conn[false]:
    return conn[false] { fd: c.fd }
def main() -> int32:
    let c = conn[true] { fd: 1 }
    let d = close(c)
    let e = send(d, 1)
    return e.fd
