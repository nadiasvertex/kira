module probes.method_partial_borrow
# Want accept under C, result 6: bump writes only self.total, disjoint from the
# loop's borrow of self.items. B rejects: the call takes &mut self.
type acc = { items: list[int32], total: int32 }
extend acc:
    def bump(mut self, n: int32) -> unit:
        self.total = self.total + n
    def sum_in(mut self) -> unit:
        for x in &self.items:
            self.bump(*x)
def main() -> int32:
    var a = acc { items: [1, 2, 3], total: 0 }
    a.sum_in()
    return a.total
