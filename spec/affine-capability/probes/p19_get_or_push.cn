module probes.get_or_push
# Per-path loans without per-outcome summaries (Rust NLL "problem case 3").
# Want accept: on @none the returned cell is dead, so push is fine.
def get_or_push(xs: &mut list[int32], i: usize) -> cell_mut[int32]:
    match xs.mutable_cell(i):
        @some(c) => return c
        @none =>:
            xs.push(0)
            return xs.mutable_cell(xs.len() - 1) or else panic("x")
def main() -> int32:
    var xs: list[int32] = [5]
    let c = get_or_push(&mut xs, 3)
    return 0
