module probes.store_on_error_only
# Per-outcome states: only @ok stores the view. Mutating src on @err is safe,
# but needs a per-outcome summary; a union summary rejects it.
type registry = { names: list[slice[int32]] }
def register(reg: &mut registry, s: slice[int32]) -> result[unit, int32]:
    if s.len() == 0:
        return @err(0)
    reg.names.push(s)
    return @ok(())
def main() -> int32:
    var r = registry { names: [] }
    var src: list[int32] = []
    match register(&mut r, src.as_slice()):
        @ok(_) => return r.names.len() as int32
        @err(_) =>:
            src.push(3)
            return r.names.len() as int32
