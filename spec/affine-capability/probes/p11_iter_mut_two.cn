module probes.iter_mut_two
use std.iter.iter_mut
# Must reject unless results are proved disjoint (both designs).
def main() -> int32:
    var xs: list[int32] = [1, 2, 3]
    var it = iter_mut(&mut xs)
    let a = it.next() or else panic("a")
    let b = it.next() or else panic("b")
    *a = 10
    *b = 20
    return xs[0] + xs[1]
