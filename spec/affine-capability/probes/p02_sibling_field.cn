module probes.sibling_field
# Want accept: the loop borrows only items; total is a disjoint field.
type acc = { items: list[int32], total: int32 }
extend acc:
    def sum_in(mut self) -> unit:
        for x in &self.items:
            self.total = self.total + *x
def main() -> int32:
    var a = acc { items: [1, 2, 3], total: 0 }
    a.sum_in()
    return a.total
