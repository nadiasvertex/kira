module probes.typestate_reuse
# Expect reject: c is used after close moved it. Needs conn to be affine;
# a struct of scalars currently copies? (Ch. 14: structs always move.)
type conn[open: bool] = { fd: int32 }
def close(c: conn[true]) -> conn[false]:
    return conn[false] { fd: c.fd }
def main() -> int32:
    let c = conn[true] { fd: 1 }
    let d = close(c)
    let e = close(c)
    return d.fd + e.fd
