module probes.view_across_method_control
# Control for p24, result 11: the read happens before the call, so no view is live.
type acc = { items: list[int32], total: int32 }
extend acc:
    def bump(mut self, n: int32) -> unit:
        self.total = self.total + n
def main() -> int32:
    var a = acc { items: [1, 2, 3], total: 0 }
    let first = a.items.as_slice()[0]
    a.bump(10)
    return first + a.total
