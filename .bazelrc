# Enable bzlmod (Bazel module system)
common --enable_bzlmod

# Use C++26 standard
build --cxxopt=-std=c++26
build --host_cxxopt=-std=c++26

# Use clang as the compiler
build --repo_env=CC=/opt/homebrew/opt/llvm/bin/clang
build --repo_env=CXX=/opt/homebrew/opt/llvm/bin/clang++
build --action_env=CC=/opt/homebrew/opt/llvm/bin/clang
build --action_env=CXX=/opt/homebrew/opt/llvm/bin/clang++
# Homebrew clang 23 reads SDKSettings.json from its default (CommandLineTools) SDK;
# listing the SDK root here makes Bazel treat that dependency as builtin.
build --repo_env=CPLUS_INCLUDE_PATH=/Library/Developer/CommandLineTools/SDKs/MacOSX26.sdk

# Set macOS deployment target (26.0 for current system compatibility)
build --apple_platform_type=macos
build --macos_minimum_os=26.0

# Disable header-parsing validation actions; they omit -c and break
# wolfd_bazel_compile_commands' compile_commands.json generation.
build --features=-parse_headers
build --host_features=-parse_headers

# Enable useful warnings
build --cxxopt=-Wall
build --cxxopt=-Wextra
build --cxxopt=-Wpedantic
build --cxxopt=-Wshadow
build --cxxopt=-Wconversion
build --host_cxxopt=-Wall
# Suppress nullability-extension warnings in external dependencies (abseil-cpp, etc.)
build --per_file_copt=external@-Wno-nullability-extension,-Wno-gcc-compat

# Optimize for local development (faster builds)
build:debug --compilation_mode=dbg
build:debug --cxxopt=-O0
build:debug --cxxopt=-g

# ThreadSanitizer, for the task scheduler and the code that runs on its
# workers: `bazelisk test --config=tsan //src/runtime:scheduler_test
# //src:codegen_stress_test`.
build:tsan --copt=-fsanitize=thread
build:tsan --linkopt=-fsanitize=thread
build:tsan --copt=-g
build:tsan --copt=-O1
build:tsan --strip=never

# AddressSanitizer over the compiler, the runtime, and the code both
# backends run in process (the VM, and the LLVM JIT through the instrumented
# runtime): `bazelisk test --config=asan //src:storage_corpus_test
# //src:std_test //src/runtime/...`. Leak detection is off: the compiler
# interns types and keeps them for the process. UndefinedBehaviorSanitizer
# is a separate config because, with Clang 23 on macOS arm64, a binary built
# with both cannot unwind a C++ exception (every `throw` terminates), and the
# VM reports panics by throwing.
build:asan --copt=-fsanitize=address
build:asan --linkopt=-fsanitize=address
build:asan --copt=-fno-omit-frame-pointer
build:asan --copt=-g
build:asan --copt=-O1
build:asan --strip=never
build:asan --test_env=ASAN_OPTIONS=detect_leaks=0
build:asan --test_timeout=3000

# UndefinedBehaviorSanitizer; any report fails the test.
build:ubsan --copt=-fsanitize=undefined
build:ubsan --linkopt=-fsanitize=undefined
build:ubsan --copt=-fno-sanitize-recover=all
build:ubsan --copt=-fno-omit-frame-pointer
build:ubsan --copt=-g
build:ubsan --copt=-O1
build:ubsan --strip=never
build:ubsan --test_env=UBSAN_OPTIONS=print_stacktrace=1
build:ubsan --test_timeout=3000

# The same, for tests that link executables with `--build`/`--compile`
# (`//src:cli_test`): those executables link the runtime archives without the
# sanitizer runtime, so the archives are left uninstrumented.
build:asan_aot --config=asan
build:asan_aot --per_file_copt=src/runtime/.*,src/.*aot_runtime.*,src/.*utf8.*,src/.*string_ops.*@-fno-sanitize=address

# Release configuration
build:release --compilation_mode=opt
build:release --cxxopt=-O3
build:release --cxxopt=-DNDEBUG

# The LLVM JIT resolves runtime functions in the test and compiler
# processes by name, and nothing in C++ calls some of them. An optimized
# macOS link dead-strips such functions unless the executable keeps its
# global symbols.
build:release --linkopt=-Wl,-export_dynamic


# Show test output on failure
test --test_output=errors
