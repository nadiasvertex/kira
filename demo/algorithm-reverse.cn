module main

# ==========================================================================
#  `algorithm.reverse` — reverse a mutable slice in place.
#
#  Run it:      kira demo/algorithm-reverse.cn
#  Compile it:  kira --compile -o algorithm-reverse demo/algorithm-reverse.cn
# ==========================================================================

def main() -> int32:
    var nums: array[int32, 5] = [1, 2, 3, 4, 5]
    reverse(&mut nums[0..5])

    var i: usize = 0
    while i < 5:
        println("reversed[{i}]={nums[i]}")
        i = i + 1

    # A single-element slice is unchanged.
    var one: array[int32, 1] = [7]
    reverse(&mut one[0..1])
    println("single={one[0]}")
    return 0
