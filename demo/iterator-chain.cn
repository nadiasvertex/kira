module main

# ==========================================================================
#  `iterator.chain` — concatenate two iterators.
#
#  Yields every element of the first iterator, then every element of the
#  second, as one continuous sequence.
#
#  Run it:      cinder demo/iterator-chain.cn
#  Compile it:  cinder --compile -o iterator-chain demo/iterator-chain.cn
# ==========================================================================

def main() -> int32:
    let a = [1, 2]
    let b = [3, 4]

    # Chain a then b: 1, 2, 3, 4
    var c = a.into_iter().chain(b.into_iter())
    println("chained={c.next().unwrap()}")
    println("chained={c.next().unwrap()}")
    println("chained={c.next().unwrap()}")
    println("chained={c.next().unwrap()}")
    println("done={c.next().is_none()}")

    # Chain same lists backwards
    let a2 = [1, 2]
    let b2 = [3, 4]
    var c2 = b2.into_iter().chain(a2.into_iter())
    println("reversed={c2.next().unwrap()}")
    println("reversed={c2.next().unwrap()}")
    println("reversed={c2.next().unwrap()}")
    println("reversed={c2.next().unwrap()}")
    return 0
