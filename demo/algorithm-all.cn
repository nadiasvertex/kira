module main

# ==========================================================================
#  `algorithm.all` — does every element satisfy a predicate?
#
#  Short-circuits on the first element that fails the predicate; an empty
#  iterator is vacuously `true`.
#
#  Run it:      kira demo/algorithm-all.kira
#  Compile it:  kira --compile -o algorithm-all demo/algorithm-all.kira
# ==========================================================================

def main() -> int32:
    let nums = [2, 4, 6, 8]

    # All are even
    println("all_even={nums.iter().values().all(x => x % 2 == 0)}")

    # Not all are 4
    println("all_4={nums.iter().values().all(x => x == 4)}")

    # Empty iterator: all is vacuously true
    let empty: list[int32] = []
    println("all_empty={empty.iter().values().all(x => x > 0)}")
    return 0
