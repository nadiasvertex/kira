module main

# ==========================================================================
#  `iterator.zip` — pair up elements from two iterators.
#
#  Yields `(left, right)` tuples, advancing both iterators in lockstep;
#  stops as soon as the shorter of the two runs out.
#
#  Run it:      kira demo/iterator-zip.cn
#  Compile it:  kira --compile -o iterator-zip demo/iterator-zip.cn
# ==========================================================================

def main() -> int32:
    let a = [1, 2, 3]
    let b = [10, 20, 30, 40]

    # Zipped: (1,10), (2,20), (3,30) — stops at a's length
    var z = a.into_iter().zip(b.into_iter())
    let (za0, zb0) = z.next().unwrap()
    println("zip={za0},{zb0}")
    let (za1, zb1) = z.next().unwrap()
    println("zip={za1},{zb1}")
    let (za2, zb2) = z.next().unwrap()
    println("zip={za2},{zb2}")
    println("done={z.next().is_none()}")

    # Reversed order: shorter is b (3 elements)
    let a2 = [1, 2, 3]
    let b2 = [10, 20, 30, 40]
    var z2 = b2.into_iter().zip(a2.into_iter())
    let (zc0, zd0) = z2.next().unwrap()
    println("zipped2={zc0},{zd0}")
    let (zc1, zd1) = z2.next().unwrap()
    println("zipped2={zc1},{zd1}")
    let (zc2, zd2) = z2.next().unwrap()
    println("zipped2={zc2},{zd2}")
    return 0
