module main

# ==========================================================================
#  `iterator.rev` — reverse a double-ended iterator.
#
#  Yields elements back-to-front; requires the underlying iterator to be
#  double-ended (know both endpoints), not just forward-only.
#
#  Run it:      kira demo/iterator-rev.kira
#  Compile it:  kira --compile -o iterator-rev demo/iterator-rev.kira
# ==========================================================================

def main() -> int32:
    let nums = [1, 2, 3]

    # Reversed: 3, 2, 1
    var r = nums.into_iter().rev()
    println("reversed={r.next().unwrap()}")
    println("reversed={r.next().unwrap()}")
    println("reversed={r.next().unwrap()}")
    return 0
