module main

# ==========================================================================
#  `algorithm.partition` — split an iterator by a predicate.
#
#  Consumes the whole iterator into two lists: elements that satisfy the
#  predicate, and everything else, preserving relative order in each.
#
#  Run it:      cinder demo/algorithm-partition.cn
#  Compile it:  cinder --compile -o algorithm-partition demo/algorithm-partition.cn
# ==========================================================================

def main() -> int32:
    let xs = [3, 1, 4, 1, 5, 9, 2, 6]

    # Partition by even
    let (evens, odds) = xs.into_iter().partition(x => x % 2 == 0)
    println("evens_count={evens.len()}")
    println("odds_count={odds.len()}")

    # Partition by value > 4
    let ys = [3, 1, 4, 1, 5, 9, 2, 6]
    let (big, small) = ys.into_iter().partition(x => x > 4)
    println("big_count={big.len()}")
    println("small_count={small.len()}")
    return 0
