module main

# ==========================================================================
#  `algorithm.count` — how many elements did the iterator yield?
#
#  Drains the iterator purely to count; combine with `filter` to count
#  elements matching a condition.
#
#  Run it:      kira demo/algorithm-count.kira
#  Compile it:  kira --compile -o algorithm-count demo/algorithm-count.kira
# ==========================================================================

def main() -> int32:
    let nums = [1, 2, 3, 4, 5]
    println("total={nums.iter().values().count()}")
    println("even={nums.iter().values().filter(x => x % 2 == 0).count()}")

    let empty: list[int32] = []
    println("empty={empty.into_iter().count()}")
    return 0
