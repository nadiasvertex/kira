module main

# ==========================================================================
#  `iterator.map` — transform each element.
#
#  Lazily applies a function to every yielded element; composes freely with
#  other adapters like `filter`.
#
#  Run it:      cinder demo/iterator-map.cn
#  Compile it:  cinder --compile -o iterator-map demo/iterator-map.cn
# ==========================================================================

def main() -> int32:
    let nums = [1, 2, 3]

    # Double each value
    var doubled = nums.into_iter().map(x => x * 2)
    println("doubled={doubled.next().unwrap()}")
    println("doubled={doubled.next().unwrap()}")
    println("doubled={doubled.next().unwrap()}")

    # Uppercase strings
    let words = ["hello", "world"]
    var upper = words.into_iter().map(x => x.to_uppercase())
    println("upper={upper.next().unwrap()}")

    # Chained with filter
    let more_nums = [1, 2, 3]
    var doubled_evens = more_nums.into_iter().filter(x => x % 2 == 0).map(x => x * 10)
    println("doubled_evens={doubled_evens.next().unwrap()}")
    return 0
