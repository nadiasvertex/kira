module main

# ==========================================================================
#  `algorithm.binary_search` — O(log n) lookup of a value in an
#  ascending-sorted slice.
#
#  Run it:      cinder demo/algorithm-binary_search.cn
#  Compile it:  cinder --compile -o algorithm-binary_search demo/algorithm-binary_search.cn
# ==========================================================================

def main() -> int32:
    let haystack = [1, 3, 5, 7, 9]

    match binary_search(&haystack[0..5], 5):
        @some(idx) => println("hit={idx}")
        @none      => println("hit=none")

    match binary_search(&haystack[0..5], 4):
        @some(idx) => println("miss={idx}")
        @none      => println("miss=none")
    return 0
