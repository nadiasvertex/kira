module main

# ==========================================================================
#  `algorithm.max_by_key` — maximum element by a derived key.
#
#  Applies a key function to each element and compares the keys, rather
#  than the elements themselves — here, string length instead of the
#  strings.
#
#  Run it:      kira demo/algorithm-max_by_key.cn
#  Compile it:  kira --compile -o algorithm-max_by_key demo/algorithm-max_by_key.cn
# ==========================================================================

def main() -> int32:
    let words = ["hi", "hello", "hey", "supercalifragilistic"]
    println("longest={words.into_iter().max_by_key(w => w.len()).unwrap()}")

    # Number with the highest value
    let nums = [3, 7, 2, 9, 1]
    println("max_val={nums.into_iter().max_by_key(x => x).unwrap()}")
    return 0
