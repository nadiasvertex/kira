module main

# ==========================================================================
#  `algorithm.product` — the product of all elements.
#
#  Uses the element type's `one` trait for the identity, so an empty
#  iterator returns 1 rather than 0.
#
#  Run it:      cinder demo/algorithm-product.cn
#  Compile it:  cinder --compile -o algorithm-product demo/algorithm-product.cn
# ==========================================================================

def main() -> int32:
    let nums = [1, 2, 3, 4]

    println("product={nums.into_iter().product()}")

    # Negative numbers
    let mixed = [-1, 2, -3]
    println("mixed={mixed.into_iter().product()}")

    # Empty returns 1 (the multiplicative identity)
    let empty: list[int32] = []
    println("empty={empty.into_iter().product()}")
    return 0
