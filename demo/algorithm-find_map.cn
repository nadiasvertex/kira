module main

# ==========================================================================
#  `algorithm.find_map` — find, mapped in the same pass.
#
#  Applies a function returning `option[U]` to each element and returns the
#  first `@some` result, short-circuiting like `find` rather than mapping
#  the whole sequence first.
#
#  Run it:      cinder demo/algorithm-find_map.cn
#  Compile it:  cinder --compile -o algorithm-find_map demo/algorithm-find_map.cn
# ==========================================================================

def main() -> int32:
    let nums = [2, 3, 4]
    let nv = nums.iter().values()

    # Find first number whose double is 8
    println("find_map={nv.find_map(x => if x * 2 == 8: @some(x) else: @none).unwrap()}")

    # Not finding
    println("find_map_none={nv.find_map(x => if x * 2 == 100: @some(x) else: @none).is_none()}")
    return 0
