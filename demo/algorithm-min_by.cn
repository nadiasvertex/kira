module main

# ==========================================================================
#  `algorithm.min_by` — minimum element under a custom comparator.
#
#  Takes a comparator returning `ordering` instead of relying on the
#  element type's own ordering; reversing the comparator's sense turns a
#  "minimum" search into a maximum one.
#
#  Run it:      cinder demo/algorithm-min_by.cn
#  Compile it:  cinder --compile -o algorithm-min_by demo/algorithm-min_by.cn
# ==========================================================================

def cmp_int(a: int32, b: int32) -> ordering:
    if a < b:
        return @less
    elif a > b:
        return @greater
    return @equal

def rcmp(a: int32, b: int32) -> ordering:
    if a < b:
        return @greater
    elif a > b:
        return @less
    return @equal

def main() -> int32:
    let nums = [3, 1, 4, 1, 5]

    # Normal minimum
    println("min={nums.into_iter().min_by(cmp_int).unwrap()}")

    # Reversed comparison gives maximum
    println("max_via_cmp={nums.into_iter().min_by(rcmp).unwrap()}")
    return 0
