module main

# ==========================================================================
#  `algorithm.fold` — accumulate a value across an iterator.
#
#  Threads an initial value through a combining function called once per
#  element; unlike `reduce`, `fold` has a defined result on an empty
#  iterator (the initial value, unchanged).
#
#  Run it:      cinder demo/algorithm-fold.cn
#  Compile it:  cinder --compile -o algorithm-fold demo/algorithm-fold.cn
# ==========================================================================

def main() -> int32:
    let nums = [1, 2, 3, 4, 5]

    # Sum: start at 0, add each element
    println("sum={nums.iter().values().fold(0, (acc, x) => acc + x)}")
    # Product: start at 1, multiply each element
    println("product={nums.iter().values().fold(1, (acc, x) => acc * x)}")
    # String concatenation
    let words = ["hello", " ", "world"]
    let result = words.iter().values().fold("", (acc, x) => acc + x)
    println("concat={result}")

    # Empty iterator returns the initial value
    let empty: list[int32] = []
    println("empty_fold={empty.iter().values().fold(42, (acc, x) => acc + x)}")
    return 0
