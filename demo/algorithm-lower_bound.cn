module main

# ==========================================================================
#  `algorithm.lower_bound` — the index of the first element not less than
#  a target, over an ascending-sorted slice.
#
#  Run it:      cinder demo/algorithm-lower_bound.cn
#  Compile it:  cinder --compile -o algorithm-lower_bound demo/algorithm-lower_bound.cn
# ==========================================================================

def main() -> int32:
    let nums = [1, 3, 5, 7, 9]

    # Target present.
    println("present={lower_bound(&nums[0..5], 5)}")

    # Target falls between two elements.
    println("between={lower_bound(&nums[0..5], 4)}")

    # Target beyond every element.
    println("beyond={lower_bound(&nums[0..5], 100)}")
    return 0
