module main

# ==========================================================================
#  `algorithm.position` — index of the first element satisfying a predicate.
#
#  Like `find`, but returns the index instead of the element; `@none` if no
#  element matches.
#
#  Run it:      kira demo/algorithm-position.cn
#  Compile it:  kira --compile -o algorithm-position demo/algorithm-position.cn
# ==========================================================================

def main() -> int32:
    let nums = [10, 20, 30, 40]

    # 30 is at position 2
    println("position_of_30={nums.into_iter().position(x => x == 30).unwrap()}")

    # First even position is 0 (10 is even)
    println("first_even_pos={nums.into_iter().position(x => x % 2 == 0).unwrap()}")

    # Not finding
    println("position_none={nums.into_iter().position(x => x > 100).is_none()}")
    return 0
