module main

# ==========================================================================
#  `iterator.scan` — thread an accumulator through the iterator.
#
#  Like `fold`, but yields a value at every step instead of only the final
#  result — a running total or a cumulative combination, one output per
#  input element.
#
#  Run it:      cinder demo/iterator-scan.cn
#  Compile it:  cinder --compile -o iterator-scan demo/iterator-scan.cn
# ==========================================================================

def main() -> int32:
    let nums = [1, 2, 3]

    # Running totals: 1, 3, 6
    var s = nums.into_iter().scan(0, (acc, x) => acc + x)
    println("total={s.next().unwrap()}")
    println("total={s.next().unwrap()}")
    println("total={s.next().unwrap()}")
    println("done={s.next().is_none()}")

    # Running product: 1, 2, 6
    let more_nums = [1, 2, 3]
    var p = more_nums.into_iter().scan(1, (acc, x) => acc * x)
    println("prod={p.next().unwrap()}")
    println("prod={p.next().unwrap()}")
    println("prod={p.next().unwrap()}")
    return 0
