module main

# ==========================================================================
#  `algorithm.max` — the largest element of an iterator.
#
#  Uses the element type's own ordering (numeric comparison for numbers,
#  lexicographic for strings); `@none` on an empty iterator.
#
#  Run it:      kira demo/algorithm-max.kira
#  Compile it:  kira --compile -o algorithm-max demo/algorithm-max.kira
# ==========================================================================

def main() -> int32:
    let nums = [5, 2, 8, 1, 9, 3]
    println("max={nums.into_iter().max().unwrap()}")

    # Max on strings (lexicographic comparison)
    let words = ["apple", "banana", "cherry"]
    println("max_word={words.into_iter().max().unwrap()}")

    let empty: list[int32] = []
    println("empty_max={empty.into_iter().max().is_none()}")
    return 0
