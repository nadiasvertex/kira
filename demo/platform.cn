module main

# ==========================================================================
#  std.platform — target and host platform information.
#
#  Queries compile-time target facts (architecture, OS, pointer width) and
#  runtime host facts (hostname, libc, `uname`), plus the compiler's own
#  version/build info. See spec/specification for the stdlib platform module.
#
#  Run it:      cinder demo/platform.cn
#  Compile it:  cinder --compile -o platform demo/platform.cn
# ==========================================================================

use std.platform

def main() -> int32:
  println("Compiled for {platform.target_arch().show()}-{std.platform.target_os()}")
  println("Pointer width: {platform.target_pointer_width()}")

  let info = std.platform.uname()
  println("Running on: {info.show()}")
  println("Platform string: {platform.platform()}")

  match platform.node():
      @ok(hostname) => println("Hostname: {hostname}")
      @err(_) => println("Could not get hostname")

  if let @some(libc) = platform.libc_ver():
      println("libc: {libc.name} {libc.version}")

  println(" Cinder version: {platform.cinder_version()}")
  println(" Cinder build: {platform.cinder_build_info().show()}")

  return 0
