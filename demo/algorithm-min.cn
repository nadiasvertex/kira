module main

# ==========================================================================
#  `algorithm.min` and `algorithm.max` — smallest and largest elements.
#
#  Both use the element type's own ordering; `@none` on an empty iterator.
#
#  Run it:      cinder demo/algorithm-min.cn
#  Compile it:  cinder --compile -o algorithm-min demo/algorithm-min.cn
# ==========================================================================

def main() -> int32:
    let nums = [5, 2, 8, 1, 9, 3]

    println("min={nums.into_iter().min().unwrap()}")
    println("max={nums.into_iter().max().unwrap()}")

    # Single element
    let single = [42]
    println("single_min={single.into_iter().min().unwrap()}")
    println("single_max={single.into_iter().max().unwrap()}")

    # Empty
    let empty: list[int32] = []
    println("empty_min={empty.into_iter().min().is_none()}")
    return 0
