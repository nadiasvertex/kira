module main

# ==========================================================================
#  `iterator.take_while` — yield elements while a predicate holds.
#
#  Stops the iterator permanently at the first element that fails the
#  predicate — unlike `filter`, it never resumes for later matches beyond
#  the stopping point.
#
#  Run it:      cinder demo/iterator-take_while.cn
#  Compile it:  cinder --compile -o iterator-take_while demo/iterator-take_while.cn
# ==========================================================================

def main() -> int32:
    let nums = [1, 2, 3, 9, 4, 5]

    # Take while < 5: yields 1, 2, 3, then stops at 9
    var tw = nums.into_iter().take_while(x => x < 5)
    println("taken={tw.next().unwrap()}")
    println("taken={tw.next().unwrap()}")
    println("taken={tw.next().unwrap()}")

    # After stopping, no more elements
    println("stopped={tw.next().is_none()}")
    return 0
