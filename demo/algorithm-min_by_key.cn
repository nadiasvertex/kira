module main

# ==========================================================================
#  `algorithm.min_by_key` — minimum element by a derived key.
#
#  Applies a key function to each element and compares the keys, rather
#  than the elements themselves — here, absolute value and string length.
#
#  Run it:      cinder demo/algorithm-min_by_key.cn
#  Compile it:  cinder --compile -o algorithm-min_by_key demo/algorithm-min_by_key.cn
# ==========================================================================

def main() -> int32:
    let nums = [-8, -3, 5, 7, 12]

    # Min by absolute value: -3 has abs value 3, smallest among odds' absolute values
    println("min_abs={nums.into_iter().min_by_key(x => if x < 0: -x else: x).unwrap()}")

    # Min by length of string
    let words = ["hi", "hello", "hey", "a"]
    println("shortest={words.into_iter().min_by_key(w => w.len()).unwrap()}")

    return 0
