module main

# ==========================================================================
#  `iterator.flat_map` — map each element to a sub-iterator, then flatten.
#
#  Equivalent to `map` followed by `flatten`, but as a single adapter: each
#  element expands into zero or more output elements.
#
#  Run it:      cinder demo/iterator-flat_map.cn
#  Compile it:  cinder --compile -o iterator-flat_map demo/iterator-flat_map.cn
# ==========================================================================

# Expand each n into [n*10, n*10+1, ... n*10+(n-1)]
# 1 -> [10], 2 -> [20, 21], 3 -> [30, 31, 32]
def spread(n: int32) -> list[int32]:
    var out: list[int32] = []
    var i = 0
    while i < n:
        out.push(n * 10 + i)
        i = i + 1
    return out

def main() -> int32:
    let nums = [1, 2, 3]

    var fm = nums.into_iter().flat_map(n => spread(n).into_iter())
    println("flat={fm.next().unwrap()}")
    println("flat={fm.next().unwrap()}")
    println("flat={fm.next().unwrap()}")
    println("flat={fm.next().unwrap()}")
    println("flat={fm.next().unwrap()}")
    println("flat={fm.next().unwrap()}")
    println("done={fm.next().is_none()}")
    return 0
