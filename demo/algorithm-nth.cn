module main

# ==========================================================================
#  `algorithm.nth` — the element at a given index.
#
#  Consumes (and discards) the first `n` elements, then returns the next
#  one; `@none` if the iterator runs out first.
#
#  Run it:      cinder demo/algorithm-nth.cn
#  Compile it:  cinder --compile -o algorithm-nth demo/algorithm-nth.cn
# ==========================================================================

def main() -> int32:
    let nums = [10, 20, 30, 40, 50]

    println("nth0={nums.iter().values().nth(0) or else panic("empty")}")
    println("nth2={nums.iter().values().nth(2) or else panic("empty")}")
    println("nth4={nums.iter().values().nth(4) or else panic("empty")}")

    # Going past the end
    println("nth_past={nums.iter().values().nth(10).is_none()}")
    return 0
