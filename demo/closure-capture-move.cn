module main

# ==========================================================================
#  Forced move capture — `move [...]`.
#
#  `move` in front of a capture list forces every bare `name` entry to move
#  rather than copy: ownership transfers into the closure at the point it
#  is created, and the enclosing binding is moved from, the same as any
#  other move. `&name`/`&mut name` entries already state their own mode and
#  are left untouched by `move`.
#
#  Run it:      kira demo/closure-capture-move.cn
#  Compile it:  kira --compile -o closure-capture-move demo/closure-capture-move.cn
# ==========================================================================

def main() -> unit:
    let name = " Cinder"
    var call_count = 0

    # `name` moves into `greeter`; `call_count` stays a mutable reference,
    # since `move` only forces bare entries — `&mut call_count` already
    # states its own mode.
    let greeter = move [name, &mut call_count] () -> unit =>:
        call_count = call_count + 1
        println("hello, {name}! (call #{call_count})")

    greeter()
    greeter()
    println("total calls = {call_count}")   # &mut still reaches the original

    # `name` was moved from above, so using it again here is a compile
    # error — uncommenting the next line fails with "use of moved value
    # `name`":
    #
    #     println(name)
