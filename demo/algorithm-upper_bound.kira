module main

# ==========================================================================
#  `algorithm.upper_bound` — the index of the first element greater than a
#  target, over an ascending-sorted slice.
#
#  Run it:      kira demo/algorithm-upper_bound.kira
#  Compile it:  kira --compile -o algorithm-upper_bound demo/algorithm-upper_bound.kira
# ==========================================================================

def main() -> int32:
    let nums = [1, 3, 5, 7, 9]

    # Target present: `upper_bound` lands past it, `lower_bound` at it.
    println("present={upper_bound(&nums[0..5], 5)}")

    # Target falls between two elements: both bounds agree.
    println("between={upper_bound(&nums[0..5], 4)}")

    # Target beyond every element.
    println("beyond={upper_bound(&nums[0..5], 100)}")
    return 0
