module main

# ==========================================================================
#  `algorithm.sort_by_key` — sort a mutable slice by a derived key.
#
#  `key` is called twice per comparison rather than once per element, so
#  prefer a cheap key function.
#
#  Run it:      kira demo/algorithm-sort_by_key.cn
#  Compile it:  kira --compile -o algorithm-sort_by_key demo/algorithm-sort_by_key.cn
# ==========================================================================

def main() -> int32:
    # Ascending, by value.
    var nums: array[int32, 4] = [5, 2, 8, 1]
    sort_by_key(&mut nums[0..4], (x: int32) => x)
    var i: usize = 0
    while i < 4:
        println("asc[{i}]={nums[i]}")
        i = i + 1

    # Descending, via a negated key.
    var nums2: array[int32, 4] = [5, 2, 8, 1]
    sort_by_key(&mut nums2[0..4], (x: int32) => 0 - x)
    i = 0
    while i < 4:
        println("desc[{i}]={nums2[i]}")
        i = i + 1
    return 0
