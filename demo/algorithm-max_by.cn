module main

# ==========================================================================
#  `algorithm.max_by` — maximum element under a custom comparator.
#
#  Takes a comparator returning `ordering` instead of relying on the
#  element type's own ordering; reversing the comparator's sense turns a
#  "maximum" search into a minimum one.
#
#  Run it:      cinder demo/algorithm-max_by.cn
#  Compile it:  cinder --compile -o algorithm-max_by demo/algorithm-max_by.cn
# ==========================================================================

def cmp_int(a: int32, b: int32) -> ordering:
    if a < b:
        return @less
    elif a > b:
        return @greater
    return @equal

def rcmp(a: int32, b: int32) -> ordering:
    if a < b:
        return @greater
    elif a > b:
        return @less
    return @equal

def main() -> int32:
    let nums = [3, 1, 4, 1, 5]

    # Normal maximum
    println("max={nums.iter().values().max_by(cmp_int).unwrap()}")

    # Reversed comparison gives minimum
    println("min_via_cmp={nums.iter().values().max_by(rcmp).unwrap()}")
    return 0
