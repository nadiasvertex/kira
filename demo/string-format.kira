module main

# ==========================================================================
#  String interpolation format specifiers.
#
#  `{expr :spec}` inside an interpolated string applies a format spec to
#  the interpolated value — width/alignment, zero-padding, float precision,
#  and radix (hex/binary) with optional width.
#
#  Run it:      kira demo/string-format.kira
#  Compile it:  kira --compile -o string-format demo/string-format.kira
# ==========================================================================

def main() -> int32:
  let name = "Alice"
  let age = 30
  let pi = 3.1415926535

  println("Name: {name :>10}")
  println("Age:  {age :03}")
  println("Pi:   {pi :.2f}")
  println("Hex:  {255 :04x}")
  println("Bin:  {255 :08b}")
  return 0
