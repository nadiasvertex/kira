module main

# ==========================================================================
#  `traits.is_array` — is this type `array[_, _]`?
#
#  `array[int32, 3]` can't be spelled directly as a bracketed type argument
#  here (the parser doesn't accept a const-generic length inside a nested
#  type-argument position) — a local alias sidesteps it.
#
#  Run it:      kira demo/traits-is_array.cn
#  Compile it:  kira --compile -o traits-is_array demo/traits-is_array.cn
# ==========================================================================

use std.traits.is_array

type three_ints = array[int32, 3]

def main() -> int32:
    println("is_array[array[int32, 3]]={is_array[three_ints]()}")
    println("is_array[int32]={is_array[int32]()}")
    return 0
