module main

# ==========================================================================
#  `traits.is_integer` — is this type any builtin integer, signed or
#  unsigned? `is_signed_integer[T]() or is_unsigned_integer[T]()`.
#
#  Run it:      kira demo/traits-is_integer.kira
#  Compile it:  kira --compile -o traits-is_integer demo/traits-is_integer.kira
# ==========================================================================

use std.traits.is_integer

def main() -> int32:
    println("is_integer[int64]={is_integer[int64]()}")
    println("is_integer[usize]={is_integer[usize]()}")
    println("is_integer[float64]={is_integer[float64]()}")
    return 0
