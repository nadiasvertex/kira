module main

# ==========================================================================
#  `algorithm.last` — the final element of an iterator.
#
#  Drains the whole iterator to reach the end; `@none` on an empty
#  iterator, since there is no last element to return.
#
#  Run it:      kira demo/algorithm-last.kira
#  Compile it:  kira --compile -o algorithm-last demo/algorithm-last.kira
# ==========================================================================

def main() -> int32:
    let nums = [1, 2, 3, 4, 5]

    # Last element is 5
    println("last={nums.into_iter().last().unwrap()}")

    # Single element
    let single = [42]
    println("single_last={single.into_iter().last().unwrap()}")

    # Empty
    let empty: list[int32] = []
    println("empty_last={empty.into_iter().last().is_none()}")
    return 0
