module main

# ==========================================================================
#  `algorithm.any` — does at least one element satisfy a predicate?
#
#  Short-circuits on the first element that passes the predicate; an empty
#  iterator can never satisfy anything, so `any` is `false`.
#
#  Run it:      cinder demo/algorithm-any.cn
#  Compile it:  cinder --compile -o algorithm-any demo/algorithm-any.cn
# ==========================================================================

def main() -> int32:
    let nums = [1, 3, 5, 6, 7]

    # 6 is even, so any of even returns true
    println("any_even={nums.into_iter().any(x => x % 2 == 0)}")

    # No number is 100, so any of >100 returns false
    println("any_gt_100={nums.into_iter().any(x => x > 100)}")

    # Empty iterator: no element satisfies anything
    let empty: list[int32] = []
    println("any_empty={empty.into_iter().any(x => x > 0)}")
    return 0
