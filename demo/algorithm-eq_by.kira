module main

# ==========================================================================
#  `algorithm.eq_by` — are two iterators elementwise equal?
#
#  Walks both iterators in lockstep with a caller-supplied comparator;
#  differing elements or differing lengths both make the result `false`.
#
#  Run it:      kira demo/algorithm-eq_by.kira
#  Compile it:  kira --compile -o algorithm-eq_by demo/algorithm-eq_by.kira
# ==========================================================================

def main() -> int32:
    let a = [1, 2, 3]
    let b = [1, 2, 3]
    let c = [1, 2, 4]
    let d = [1, 2]

    let av = a.iter().values()
    let bv = b.iter().values()
    let cv = c.iter().values()
    let dv = d.iter().values()

    # Same elements in same order
    println("eq_same={av.eq_by(bv, (x, y) => x == y)}")

    # Different element
    println("eq_diff={av.eq_by(cv, (x, y) => x == y)}")

    # Different length
    println("eq_length={av.eq_by(dv, (x, y) => x == y)}")
    return 0
