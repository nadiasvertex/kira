module main

# ==========================================================================
#  `limits.max` — The number of max in the numeric type.
#
#  Run it:      cinder demo/limits-max.cn
#  Compile it:  cinder --compile -o limits-max.cn demo/limits-max.cn
# ==========================================================================

use std.limits.max

def main() -> int32:
    println("max[int8]={max[int8]()}")
    println("max[int32]={max[int32]()}")
    println("max[float64]={max[float64]()}")
    return 0
