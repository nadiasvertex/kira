module main

# ==========================================================================
#  `traits.is_str` — is this type `str`?
#
#  Run it:      cinder demo/traits-is_str.cn
#  Compile it:  cinder --compile -o traits-is_str demo/traits-is_str.cn
# ==========================================================================

use std.traits.is_str

def main() -> int32:
    println("is_str[str]={is_str[str]()}")
    println("is_str[char]={is_str[char]()}")
    return 0
