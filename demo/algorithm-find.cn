module main

# ==========================================================================
#  `algorithm.find` — first element satisfying a predicate.
#
#  Stops at the first match and returns `option[T]`; `@none` if nothing in
#  the iterator satisfies the predicate.
#
#  Run it:      cinder demo/algorithm-find.cn
#  Compile it:  cinder --compile -o algorithm-find demo/algorithm-find.cn
# ==========================================================================

def main() -> int32:
    let nums = [1, 3, -5, 4, -2]

    # First positive is 1
    println("find_first_positive={nums.iter().values().find(x => *x > 0).unwrap()}")

    # First negative is -5
    println("find_first_negative={nums.iter().values().find(x => *x < 0).unwrap()}")

    # Not finding
    println("find_none={nums.iter().values().find(x => *x > 100).is_none()}")
    return 0
