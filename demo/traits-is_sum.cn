module main

# ==========================================================================
#  `traits.is_sum` — is this a user `type ... = @a | @b(...) | ...`
#  declaration?
#
#  Reads `T.kind()`, same as `is_struct`.
#
#  Run it:      cinder demo/traits-is_sum.cn
#  Compile it:  cinder --compile -o traits-is_sum demo/traits-is_sum.cn
# ==========================================================================

use std.traits.is_sum

type direction = @north | @south | @east | @west

def main() -> int32:
    println("is_sum[direction]={is_sum[direction]()}")
    println("is_sum[int32]={is_sum[int32]()}")
    return 0
