module main

# ==========================================================================
#  `algorithm.for_each` — run a function per element, for side effects.
#
#  Unlike `map`, `for_each` yields nothing back — it exists purely to drive
#  the iterator for its side effects (here, printing).
#
#  Run it:      cinder demo/algorithm-for_each.cn
#  Compile it:  cinder --compile -o algorithm-for_each demo/algorithm-for_each.cn
# ==========================================================================

def main() -> int32:
    let nums = [1, 2, 3, 4, 5]

    # Print each number doubled
    nums.iter().values().for_each(x => println("x2={x * 2}"))

    # Print only even numbers
    println("---")
    nums.iter().values().filter(x => x % 2 == 0).for_each(x => println("even={x}"))
    return 0
