module main

# ==========================================================================
#  `iterator.filter_map` — map and filter in a single pass.
#
#  Applies a function returning `option[U]`; `@some` values are yielded
#  (unwrapped), `@none` values are dropped — a combination of `map` and
#  `filter` without materializing an intermediate sequence.
#
#  Run it:      cinder demo/iterator-filter_map.cn
#  Compile it:  cinder --compile -o iterator-filter_map demo/iterator-filter_map.cn
# ==========================================================================

def main() -> int32:
    let nums = [1, 2, 3, 4]

    # Convert even numbers to their double, drop odd numbers
    var fm = nums.into_iter().filter_map(x => if x % 2 == 0: @some(x * 10) else: @none)
    println("mapped={fm.next().unwrap()}")
    println("mapped={fm.next().unwrap()}")
    println("done={fm.next().is_none()}")

    # Parse strings that represent numbers
    let mixed = ["42", "hello", "99", "world"]
    var parsed = mixed.into_iter().filter_map(x => if x.len() == 2: @some(x.len()) else: @none)
    println("parsed={parsed.next().unwrap()}")
    println("parsed={parsed.next().unwrap()}")
    return 0
