module main

# ==========================================================================
#  `iterator.take` — yield at most n elements.
#
#  Stops the iterator early after `n` elements; taking more than the
#  iterator has just yields everything it has.
#
#  Run it:      kira demo/iterator-take.cn
#  Compile it:  kira --compile -o iterator-take demo/iterator-take.cn
# ==========================================================================

def main() -> int32:
    let nums = [1, 2, 3, 4, 5]

    # Take 3 from 5
    var first3 = nums.into_iter().take(3)
    println("taken={first3.next().unwrap()}")
    println("taken={first3.next().unwrap()}")
    println("taken={first3.next().unwrap()}")
    println("done={first3.next().is_none()}")

    # Take 10 (only 5 available)
    let nums2 = [1, 2, 3, 4, 5]
    var all = nums2.into_iter().take(10)
    println("count={all.count()}")

    # Take 0
    let nums3 = [1, 2, 3, 4, 5]
    var none = nums3.into_iter().take(0)
    println("zero={none.next().is_none()}")
    return 0
