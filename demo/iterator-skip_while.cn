module main

# ==========================================================================
#  `iterator.skip_while` — discard elements while a predicate holds.
#
#  Drops elements from the front while the predicate is `true`; once the
#  predicate first fails, every remaining element is yielded, even if some
#  of them would have satisfied the predicate too.
#
#  Run it:      cinder demo/iterator-skip_while.cn
#  Compile it:  cinder --compile -o iterator-skip_while demo/iterator-skip_while.cn
# ==========================================================================

def main() -> int32:
    let nums = [1, 2, 3, 9, 4, 5]

    # Skip while < 5: discards 1, 2, 3, then yields 9, 4, 5
    var sw = nums.into_iter().skip_while(x => x < 5)
    println("seen={sw.next().unwrap()}")
    println("seen={sw.next().unwrap()}")
    println("seen={sw.next().unwrap()}")
    return 0
