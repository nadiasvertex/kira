module main

# ==========================================================================
#  `algorithm.eq_by` — are two iterators elementwise equal?
#
#  Walks both iterators in lockstep with a caller-supplied comparator;
#  differing elements or differing lengths both make the result `false`.
#
#  Run it:      cinder demo/algorithm-eq_by.cn
#  Compile it:  cinder --compile -o algorithm-eq_by demo/algorithm-eq_by.cn
# ==========================================================================

def main() -> int32:
    let a = [1, 2, 3]
    let b = [1, 2, 3]
    let c = [1, 2, 4]
    let d = [1, 2]

    # Same elements in same order
    println("eq_same={a.iter().values().eq_by(b.iter().values(), (x, y) => *x == *y)}")

    # Different element
    println("eq_diff={a.iter().values().eq_by(c.iter().values(), (x, y) => *x == *y)}")

    # Different length
    println("eq_length={a.iter().values().eq_by(d.iter().values(), (x, y) => *x == *y)}")
    return 0
