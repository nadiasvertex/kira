module main

# ==========================================================================
#  `iterator.inspect` — observe elements as they flow through, unchanged.
#
#  Calls a function on each element purely for its side effects (typically
#  logging), then passes the element through untouched to the next adapter.
#
#  Run it:      kira demo/iterator-inspect.cn
#  Compile it:  kira --compile -o iterator-inspect demo/iterator-inspect.cn
# ==========================================================================

def main() -> int32:
    let nums = [1, 2, 3]

    # Print elements as they pass through
    var iv = nums.into_iter().inspect(x => println("saw={x}")).take(2)
    println("next={iv.next().unwrap()}")
    println("next={iv.next().unwrap()}")
    println("done={iv.next().is_none()}")
    return 0
