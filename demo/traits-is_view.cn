module main

# ==========================================================================
#  `traits.is_view` — is this type `&T'` or `&mut T'`, for some `T'`?
#
#  A view can't be spelled directly as a bracketed type argument
#  (`is_view[&int32]()` isn't valid syntax — a view isn't a plain type
#  name), so this only fires when a bare generic parameter is itself
#  inferred from a `&`-argument at the call site, as `describe_view` below
#  does.
#
#  This used to always print `false` for `describe_view(&n)`, because
#  `try_fold_comptime_only_call` (src/semantic/check.cpp) rebound the
#  caller's type parameter into the nested `is_view[T]()` call's evaluator
#  locals via `types_.entry(strip_refs(it->second))` — the `strip_refs`
#  dropped the view wrapper before `is_view`'s own body ever saw it, so it
#  observed the referent's name instead of `"ref"`. Fixed by binding the
#  argument type as-is, matching what `T.name()` already reported when
#  called directly in `describe_view`'s own body.
#
#  Run it:      kira demo/traits-is_view.kira
#  Compile it:  kira --compile -o traits-is_view demo/traits-is_view.kira
# ==========================================================================

use std.traits.is_view

def describe_view[T](x: T) -> bool:
    return is_view[T]()

def main() -> int32:
    let n: int32 = 42
    println("is_view(&n)={describe_view(&n)}")
    println("is_view(n)={describe_view(n)}")
    return 0
