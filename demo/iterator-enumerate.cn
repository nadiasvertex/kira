module main

# ==========================================================================
#  `iterator.enumerate` — pair each element with its index.
#
#  Yields `(index, element)` tuples; the index always starts at 0 *from
#  wherever the adapter chain begins*, so chaining `filter` before
#  `enumerate` renumbers the surviving elements rather than keeping their
#  original positions.
#
#  Run it:      kira demo/iterator-enumerate.cn
#  Compile it:  kira --compile -o iterator-enumerate demo/iterator-enumerate.cn
# ==========================================================================

def main() -> int32:
    let nums = ["a", "b", "c"]

    # Positions 0, 1, 2 with values
    var e = nums.into_iter().enumerate()
    let (i0, v0) = e.next().unwrap()
    println("enum={i0}:{v0}")
    let (i1, v1) = e.next().unwrap()
    println("enum={i1}:{v1}")
    let (i2, v2) = e.next().unwrap()
    println("enum={i2}:{v2}")

    # Enumerate after filter: indices start where enumerate begins
    let all = [10, 20, 30, 40]
    var filtered = all.into_iter().filter(x => x > 15).enumerate()
    let (fi0, fv0) = filtered.next().unwrap()
    println("fenum={fi0}:{fv0}")
    let (fi1, fv1) = filtered.next().unwrap()
    println("fenum={fi1}:{fv1}")
    let (fi2, fv2) = filtered.next().unwrap()
    println("fenum={fi2}:{fv2}")
    return 0
