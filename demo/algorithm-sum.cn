module main

# ==========================================================================
#  `algorithm.sum` — the sum of all elements.
#
#  Uses the element type's `zero` trait for the identity, so an empty
#  iterator returns 0.
#
#  Run it:      kira demo/algorithm-sum.cn
#  Compile it:  kira --compile -o algorithm-sum demo/algorithm-sum.cn
# ==========================================================================

def main() -> int32:
    let nums = [1, 2, 3, 4]

    println("sum={nums.into_iter().sum()}")

    # Negative numbers
    let mixed = [-1, 2, -3, 4]
    println("mixed={mixed.into_iter().sum()}")

    # Empty
    let empty: list[int32] = []
    println("empty={empty.into_iter().sum()}")
    return 0
