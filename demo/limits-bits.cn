module main

# ==========================================================================
#  `limits.bits` — The number of bits in the numeric type.
#
#  Run it:      cinder demo/limits-bits.cn
#  Compile it:  cinder --compile -o limits-bits.cn demo/limits-bits.cn
# ==========================================================================

use std.limits.bits

def main() -> int32:
    println("bits[int8]={bits[int8]()}")
    println("bits[int32]={bits[int32]()}")
    println("bits[float64]={bits[float64]()}")
    return 0
