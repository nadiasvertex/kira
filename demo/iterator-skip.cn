module main

# ==========================================================================
#  `iterator.skip` — discard the first n elements.
#
#  Consumes and drops the first `n` elements before yielding anything;
#  skipping more than the iterator has just drains it, without error.
#
#  Run it:      cinder demo/iterator-skip.cn
#  Compile it:  cinder --compile -o iterator-skip demo/iterator-skip.cn
# ==========================================================================

def main() -> int32:
    let nums = [1, 2, 3, 4, 5]

    # Skip first 2, get 3, 4, 5
    var remaining = nums.into_iter().skip(2)
    println("skipped={remaining.next().unwrap()}")
    println("skipped={remaining.next().unwrap()}")
    println("skipped={remaining.next().unwrap()}")

    # Skip all (5 elements, skip 5)
    let nums2 = [1, 2, 3, 4, 5]
    var empty = nums2.into_iter().skip(5)
    println("empty={empty.next().is_none()}")

    # Skip more than available
    let nums3 = [1, 2, 3, 4, 5]
    var past = nums3.into_iter().skip(10)
    println("past={past.next().is_none()}")
    return 0
